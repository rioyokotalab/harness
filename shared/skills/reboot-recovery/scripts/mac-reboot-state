#!/bin/sh
set -eu

mode=${1:-}
case $mode in
    status|start-tmux) ;;
    *)
        echo "MAC_REBOOT_STATE status=blocked reason=usage" >&2
        exit 64
        ;;
esac

PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH

repo=$HOME/harness
session=harness-codex-resume
unified_session=harness

blocked() {
    echo "MAC_REBOOT_STATE mode=$mode status=blocked reason=$1"
    exit 2
}

[ "$(uname -s)" = Darwin ] || blocked os
[ -d "$repo/.git" ] && [ ! -L "$repo" ] || blocked repository
cd "$repo"

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || printf detached)
head=$(git rev-parse --verify HEAD 2>/dev/null) || blocked repository
upstream=$(git rev-parse --verify refs/remotes/origin/main 2>/dev/null) ||
    blocked upstream
dirty=$(git status --porcelain --untracked-files=normal 2>/dev/null | wc -l |
    tr -d '[:space:]')

repo_state=clean
[ "$dirty" -eq 0 ] || repo_state=dirty
synchronized=no
[ "$branch" = main ] && [ "$head" = "$upstream" ] && synchronized=yes

uid=$(id -u)
loaded() {
    launchctl print "gui/$uid/$1" >/dev/null 2>&1
}

tunnels=0
loaded org.rioyokota.harness.ssh.tunnel && tunnels=$((tunnels + 1))
loaded org.rioyokota.harness.ssh.tunnel2 && tunnels=$((tunnels + 1))
watchdog=missing
loaded org.rioyokota.harness.ssh.tunnel-watchdog && watchdog=ready

# Identify the remote-control daemon pair by role rather than by parentage.
# Both processes are owned by the login account, but only one of them is
# reparented to launchd in some healthy arrangements: the app-server may
# still be a live child of its pid-update-loop. Counting ppid==1 therefore
# reported a working host as unexpected. Matching argv also excludes an
# interactive Codex TUI, which carries neither role.
remote_control_roles=$(
    ps -axo user=,args= 2>/dev/null |
        awk -v owner="$(id -un)" '
            $1 != owner { next }
            {
                argv = $0
                sub(/^[^ ]+[ ]+/, "", argv)
            }
            argv ~ /app-server .*--remote-control/ { server++ }
            argv ~ /app-server daemon pid-update-loop/ { loop++ }
            END { print (server + 0) "," (loop + 0) }
        '
)
remote_control=unexpected
[ "$remote_control_roles" = "1,1" ] && remote_control=ready

unified_ready() {
    # T-361 layout: one session `harness` whose `codex` and `claude` windows
    # are both live. Its own launchd agent owns creation and repair, so this
    # workflow only recognizes it and never starts or edits it.
    tmux has-session -t "=$unified_session" 2>/dev/null || return 1
    windows=$(tmux list-windows -t "=$unified_session" \
        -F '#{window_name}|#{pane_dead}' 2>/dev/null || true)
    for wanted in codex claude; do
        # Enumerate exactly: a display-message probe for a missing window
        # falls back to the current window and reports a phantom as live.
        printf '%s\n' "$windows" |
            awk -F '|' -v w="$wanted" '
                $1 == w && $2 == 0 { found = 1 }
                END { exit found ? 0 : 1 }
            ' || return 1
    done
    return 0
}

inspect_tmux() {
    if unified_ready; then
        tmux_state=ready
        return
    fi
    sessions=$(tmux list-sessions -F '#{session_name}|#{session_attached}' \
        2>/dev/null || true)
    matches=$(printf '%s\n' "$sessions" |
        awk -F '|' -v wanted="$session" '$1 == wanted { count++ } END { print count + 0 }')
    if [ "$matches" -eq 0 ]; then
        tmux_state=absent
        return
    fi
    [ "$matches" -eq 1 ] || {
        tmux_state=conflict
        return
    }

    session_line=$(printf '%s\n' "$sessions" |
        awk -F '|' -v wanted="$session" '$1 == wanted { print; exit }')
    attached=$(printf '%s\n' "$session_line" | awk -F '|' '{ print $2 }')
    [ "$attached" = 0 ] || {
        tmux_state=conflict
        return
    }

    pane_line=$(tmux list-panes -t "=$session" \
        -F '#{pane_dead}|#{pane_current_path}|#{pane_current_command}|#{pane_pid}' \
        2>/dev/null || true)
    pane_count=$(printf '%s\n' "$pane_line" |
        awk 'NF { count++ } END { print count + 0 }')
    [ "$pane_count" -eq 1 ] || {
        tmux_state=conflict
        return
    }
    pane_dead=$(printf '%s\n' "$pane_line" | awk -F '|' '{ print $1 }')
    pane_path=$(printf '%s\n' "$pane_line" | awk -F '|' '{ print $2 }')
    pane_command=$(printf '%s\n' "$pane_line" | awk -F '|' '{ print $3 }')
    pane_pid=$(printf '%s\n' "$pane_line" | awk -F '|' '{ print $4 }')
    supervisor_matches=no
    if [ -x "$repo/bin/harness" ]; then
        supervisor_status=$(
            "$repo/bin/harness" codex-resilient --status --name "$session" \
                2>/dev/null || true
        )
        supervisor_phase=$(printf '%s\n' "$supervisor_status" |
            sed -n 's/.* phase=\([^ ]*\).*/\1/p')
        supervisor_pid=$(printf '%s\n' "$supervisor_status" |
            sed -n 's/.* owner_pid=\([^ ]*\).*/\1/p')
        case "$supervisor_phase:$supervisor_pid:$pane_pid" in
            running:*:*|backoff:*:*)
                [ "$supervisor_pid" = "$pane_pid" ] &&
                    supervisor_matches=yes
                ;;
        esac
    fi
    case $pane_command in
        codex|codex.real)
            # A legacy unsupervised session remains valid until its next
            # deliberate restart. A live receipt additionally proves the new
            # supervisor owns this pane.
            ;;
        harness-codex-resilient|sh|bash|sleep)
            [ "$supervisor_matches" = yes ] || {
                tmux_state=conflict
                return
            }
            ;;
        *)
            tmux_state=conflict
            return
            ;;
    esac
    if [ "$pane_dead" = 0 ] && [ "$pane_path" = "$repo" ]; then
        tmux_state=ready
    else
        tmux_state=conflict
    fi
}

inspect_tmux

if [ "$mode" = status ]; then
    status=blocked
    if [ "$repo_state" = clean ] && [ "$synchronized" = yes ] &&
        [ "$tunnels" -eq 2 ] && [ "$watchdog" = ready ] &&
        [ "$remote_control" = ready ]; then
        case $tmux_state in
            ready) status=ready ;;
            absent) status=needs-tmux ;;
        esac
    fi
    echo "MAC_REBOOT_STATE mode=status repo=$repo_state branch=$branch synchronized=$synchronized tunnels=$tunnels/2 watchdog=$watchdog remote_control=$remote_control tmux=$tmux_state status=$status"
    [ "$status" != blocked ] || exit 2
    exit 0
fi

[ "$repo_state" = clean ] || blocked repository-dirty
[ "$synchronized" = yes ] || blocked repository-divergent
[ "$tunnels" -eq 2 ] || blocked tunnel-services
[ "$watchdog" = ready ] || blocked watchdog
[ "$remote_control" = ready ] || blocked remote-control

case $tmux_state in
    ready)
        echo "MAC_REBOOT_STATE mode=start-tmux action=keep status=complete"
        exit 0
        ;;
    absent) ;;
    *) blocked tmux-conflict ;;
esac

controller=$repo/bin/harness
[ -x "$controller" ] || blocked codex-launcher
case "$controller" in
    *'"'*|*'\'*|*'
'*) blocked codex-launcher ;;
esac
tmux new-session -d \
    -s "$session" \
    -c "$repo" \
    "exec \"$controller\" codex-resilient --run --name $session --last"
sleep 3
inspect_tmux
[ "$tmux_state" = ready ] || blocked tmux-start-validation

echo "MAC_REBOOT_STATE mode=start-tmux action=create status=complete"
