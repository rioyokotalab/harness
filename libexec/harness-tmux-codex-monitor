#!/usr/bin/env python3
"""Pane-blind health, ordering, and bounded repair for Local Codex windows."""

from __future__ import print_function

import argparse
import contextlib
import fcntl
import json
import os
import re
import signal
import stat
import subprocess
import sys
import tempfile
import time


sys.dont_write_bytecode = True
CONTROL_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
os.environ["HARNESS_CONTROL_ROOT"] = CONTROL_ROOT
os.environ["HARNESS_TARGET_ROOT"] = CONTROL_ROOT
os.environ.pop("HARNESS_ROOT", None)
sys.path.insert(0, os.path.join(CONTROL_ROOT, "libexec"))
from harness_codex_targets import (  # noqa: E402
    TargetError,
    load_targets,
    validate_all,
)

SESSION_NAME = "projects"
TARGETS = load_targets()
EXPECTED = tuple((value["name"], value["index"]) for value in TARGETS)
TARGET_PATHS = {
    value["name"]: value["repository"] for value in TARGETS
}
CODEX_COMMS = ("codex", "codex.real")
SAFE_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$")


class MonitorError(RuntimeError):
    pass


def fail(message):
    raise MonitorError(message)


def target_cwd_allowed(name, path):
    return path == TARGET_PATHS[name]


def run(arguments, check=True):
    result = subprocess.run(
        arguments,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if check and result.returncode != 0:
        fail("native command failed")
    return result.stdout.decode("utf-8", "strict")


def runtime_root():
    parent = os.environ.get("XDG_RUNTIME_DIR")
    if not parent or not os.path.isabs(parent):
        parent = os.environ.get("TMPDIR", "/tmp")
    if not os.path.isabs(parent):
        fail("runtime parent must be absolute")
    root = os.path.join(parent, "harness-tmux-codex-monitor-{}".format(os.getuid()))
    if not os.path.exists(root):
        old = os.umask(0o077)
        try:
            os.makedirs(root, 0o700)
        finally:
            os.umask(old)
    info = os.lstat(root)
    if (
        not stat.S_ISDIR(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_uid != os.getuid()
        or stat.S_IMODE(info.st_mode) != 0o700
    ):
        fail("runtime root is unsafe")
    return root


def atomic_json(path, value):
    parent = os.path.dirname(path)
    descriptor, temporary = tempfile.mkstemp(prefix=".monitor.", dir=parent)
    try:
        os.fchmod(descriptor, 0o600)
        payload = (json.dumps(value, sort_keys=True) + "\n").encode("utf-8")
        os.write(descriptor, payload)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.replace(temporary, path)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if os.path.exists(temporary):
            os.unlink(temporary)


def read_private_json(path, default):
    if not os.path.exists(path):
        return default
    info = os.lstat(path)
    if (
        not stat.S_ISREG(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_uid != os.getuid()
        or info.st_nlink != 1
        or stat.S_IMODE(info.st_mode) != 0o600
    ):
        fail("private state is unsafe")
    with open(path, "r") as stream:
        value = json.load(stream)
    return value


def helper_runtime_root():
    testing = os.environ.get("HARNESS_TEST_RECOVERY_RUNTIME_DIR")
    if testing and os.environ.get("HARNESS_TESTING") == "1":
        return testing
    parent = os.environ.get("XDG_RUNTIME_DIR")
    if not parent or not os.path.isabs(parent):
        parent = os.environ.get("TMPDIR", "/tmp")
    if not os.path.isabs(parent):
        return None
    return os.path.join(
        parent, "harness-codex-recovery-helper-{}".format(os.getuid())
    )


def phone_mirror_health(now=None):
    root = helper_runtime_root()
    if not root:
        return "unavailable"
    try:
        receipt = read_private_json(
            os.path.join(root, "phone-mirror.json"), None
        )
    except (MonitorError, ValueError, KeyError, OSError):
        return "unavailable"
    if not receipt or receipt.get("schema") != 1:
        return "unavailable"
    current = int(time.time()) if now is None else now
    if current - receipt.get("epoch", 0) > 120:
        return "unavailable"
    owner = process_info(receipt.get("owner_pid", 0))
    if (
        not owner
        or owner.get("uid") != os.getuid()
        or owner.get("start") != receipt.get("owner_start")
    ):
        return "unavailable"
    status = receipt.get("status")
    if status not in ("healthy", "degraded", "unavailable"):
        return "unavailable"
    remote = receipt.get("remote_control", {})
    if remote.get("exactly_one"):
        process = process_info(remote.get("pid", 0))
        if (
            not process
            or process.get("uid") != os.getuid()
            or process.get("start") != remote.get("start")
        ):
            return "unavailable"
    if status != "healthy":
        return status
    roles = receipt.get("roles", {})
    required = (
        "tmux_mapping",
        "unarchived",
        "exact_name",
        "exact_cwd",
        "native_cwd",
        "rollout_location",
        "rollout_exists",
        "interactive_source",
    )
    if (
        not remote.get("exactly_one")
        or receipt.get("canonical_count") != len(EXPECTED)
        or receipt.get("active_top_level_count") != len(EXPECTED)
        or receipt.get("mismatch_classes")
        or sorted(roles) != sorted(name for name, _index in EXPECTED)
        or any(
            not all(roles[name].get(field) is True for field in required)
            for name, _index in EXPECTED
        )
    ):
        return "unavailable"
    return "healthy"


@contextlib.contextmanager
def exclusive_lock(path):
    old = os.umask(0o077)
    try:
        descriptor = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    finally:
        os.umask(old)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def parse_proc_stat(pid, value):
    prefix = "{} (".format(pid)
    end = value.rfind(") ")
    if not value.startswith(prefix) or end < len(prefix):
        raise ValueError("malformed process stat")
    comm = value[len(prefix) : end]
    fields = value[end + 2 :].split()
    if len(fields) < 20:
        raise ValueError("short process stat")
    return {
        "pid": pid,
        "parent": int(fields[1]),
        "start": fields[19],
        "comm": comm,
    }


def process_info(pid):
    try:
        with open("/proc/{}/stat".format(pid), "r") as stream:
            info = parse_proc_stat(pid, stream.read())
        with open("/proc/{}/cmdline".format(pid), "rb") as stream:
            argv = [part.decode("utf-8", "strict") for part in stream.read().split(b"\0") if part]
        info["uid"] = os.stat("/proc/{}".format(pid)).st_uid
    except (IOError, OSError, UnicodeError, ValueError):
        return None
    info["argv"] = argv
    return info


def children(parent):
    result = []
    try:
        names = os.listdir("/proc")
    except OSError:
        return result
    for name in names:
        if not name.isdigit():
            continue
        info = process_info(int(name))
        if info and info["parent"] == parent:
            result.append(info)
    return result


def descendants(parent):
    pending = [parent]
    found = []
    visited = set()
    while pending:
        current = pending.pop()
        if current in visited:
            continue
        visited.add(current)
        for child in children(current):
            found.append(child)
            pending.append(child["pid"])
    return found


def parse_supervisor(info):
    if not info:
        return None
    argv = info["argv"]
    if len(argv) < 7 or "harness-codex-resilient" not in " ".join(argv[:2]):
        return None
    try:
        run_index = argv.index("--run")
        name_index = argv.index("--name")
        remote_index = argv.index("--remote-session")
        runtime_name = argv[name_index + 1]
        thread_id = argv[remote_index + 1]
    except (ValueError, IndexError):
        return None
    if run_index < 1 or not SAFE_ID.match(runtime_name) or not SAFE_ID.match(thread_id):
        return None
    target = None
    try:
        target_index = argv.index("--target")
        target = argv[target_index + 1]
    except ValueError:
        pass
    except IndexError:
        return None
    if target is not None and target not in TARGET_PATHS:
        return None
    return {
        "runtime": runtime_name,
        "thread": thread_id,
        "start": info["start"],
        "target": target,
    }


def resilient_status(target, runtime_name):
    resilient = os.path.join(
        os.environ["HARNESS_CONTROL_ROOT"],
        "libexec",
        "harness-codex-resilient",
    )
    result = subprocess.run(
        [
            resilient,
            "--status",
            "--target",
            target,
            "--name",
            runtime_name,
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    text = result.stdout.decode("utf-8", "strict")
    lines = [line for line in text.splitlines() if line]
    if result.returncode != 0 or not lines:
        return None
    first = dict(item.split("=", 1) for item in lines[0].split()[1:] if "=" in item)
    recovery = None
    if len(lines) > 1:
        recovery = dict(item.split("=", 1) for item in lines[1].split()[1:] if "=" in item)
    return first, recovery


def reciprocal_socket(tui_pid):
    output = run(["ss", "-xnpH"], check=False)
    pairs = []
    expression = re.compile(r"\*\s+([0-9]+)\s+\*\s+([0-9]+).*pid=([0-9]+)")
    path_expression = re.compile(r"\s([0-9]+)\s+\*\s+([0-9]+).*pid=([0-9]+)")
    for line in output.splitlines():
        match = expression.search(line) or path_expression.search(line)
        if match:
            pairs.append((int(match.group(1)), int(match.group(2)), int(match.group(3))))
    tui_pairs = {(left, right) for left, right, pid in pairs if pid == tui_pid}
    for left, right, pid in pairs:
        if pid != tui_pid and (right, left) in tui_pairs:
            return pid
    return None


def tmux_windows():
    output = run(
        [
            "tmux",
            "list-windows",
            "-t",
            SESSION_NAME,
            "-F",
            "#{window_index}\t#{window_id}\t#{window_name}\t#{window_panes}\t"
            "#{pane_id}\t#{pane_pid}\t#{pane_current_path}\t#{pane_dead}",
        ]
    )
    windows = []
    for line in output.splitlines():
        fields = line.split("\t")
        if len(fields) != 8:
            fail("tmux window metadata is malformed")
        windows.append(
            {
                "index": int(fields[0]),
                "window_id": fields[1],
                "name": fields[2],
                "panes": int(fields[3]),
                "pane_id": fields[4],
                "pane_pid": int(fields[5]),
                "path": fields[6],
                "dead": fields[7] == "1",
            }
        )
    return windows


def tmux_clients():
    output = run(
        [
            "tmux",
            "list-clients",
            "-t",
            SESSION_NAME,
            "-F",
            "#{client_pid}\t#{window_id}",
        ],
    )
    return sorted(tuple(line.split("\t", 1)) for line in output.splitlines() if "\t" in line)


def enforce_order(windows):
    expected_names = [name for name, _index in EXPECTED]
    if (
        len(windows) != 3
        or sorted(window["name"] for window in windows) != sorted(expected_names)
        or any(window["panes"] != 1 or window["dead"] for window in windows)
        or any(
            not target_cwd_allowed(window["name"], window["path"])
            for window in windows
        )
    ):
        return windows, "deferred-ambiguous"
    before_clients = tmux_clients()
    action = "none"
    for name, target_index in EXPECTED[:2]:
        current = next(window for window in windows if window["name"] == name)
        if current["index"] != target_index:
            target = next(
                (window for window in windows if window["index"] == target_index),
                None,
            )
            operation = "swap-window" if target else "move-window"
            run(
                [
                    "tmux",
                    operation,
                    "-d",
                    "-s",
                    current["window_id"],
                    "-t",
                    "{}:{}".format(SESSION_NAME, target_index),
                ]
            )
            action = "ordered"
            windows = tmux_windows()
    if next(window for window in windows if window["name"] == "swallow")["index"] != 2:
        fail("tmux order correction did not converge")
    if tmux_clients() != before_clients:
        fail("tmux order correction changed attached clients")
    return windows, action


def collect_health(windows):
    health = {}
    for name, expected_index in EXPECTED:
        matches = [window for window in windows if window["name"] == name]
        if len(matches) != 1:
            health[name] = {"state": "unhealthy", "reason": "window-missing"}
            continue
        window = matches[0]
        entry = {"window": window, "state": "unhealthy", "reason": "metadata"}
        if window["panes"] != 1 or window["dead"]:
            health[name] = entry
            continue
        if not target_cwd_allowed(name, window["path"]):
            entry["reason"] = "native-cwd"
            health[name] = entry
            continue
        supervisor_info = process_info(window["pane_pid"])
        identity = parse_supervisor(supervisor_info)
        if not identity or supervisor_info["uid"] != os.getuid():
            entry["reason"] = "supervisor-identity"
            health[name] = entry
            continue
        if identity.get("target") != name:
            entry["reason"] = "supervisor-target"
            health[name] = entry
            continue
        status_value = resilient_status(name, identity["runtime"])
        if not status_value:
            entry["reason"] = "supervisor-status"
            health[name] = entry
            continue
        supervisor, recovery = status_value
        if (
            supervisor.get("target") != name
            or supervisor.get("phase") not in ("running", "backoff")
            or supervisor.get("owner_pid") != str(window["pane_pid"])
        ):
            entry["reason"] = "supervisor-owner"
            health[name] = entry
            continue
        entry["identity"] = identity
        tui_candidates = []
        for item in descendants(window["pane_pid"]):
            if item["comm"] not in CODEX_COMMS:
                continue
            peer_pid = reciprocal_socket(item["pid"])
            if peer_pid:
                tui_candidates.append((item, peer_pid))
        tui = tui_candidates[0][0] if len(tui_candidates) == 1 else None
        entry["tui"] = tui
        if supervisor.get("phase") == "backoff" and tui is None:
            entry["state"] = "recovering"
            entry["reason"] = "supervisor-backoff"
            health[name] = entry
            continue
        if len(tui_candidates) > 1:
            entry["reason"] = "tui-ambiguous"
            health[name] = entry
            continue
        if not tui:
            entry["reason"] = "tui-absent"
            health[name] = entry
            continue
        if tui["uid"] != os.getuid():
            entry["reason"] = "tui-identity"
            health[name] = entry
            continue
        peer_pid = tui_candidates[0][1]
        peer = process_info(peer_pid)
        if (
            not peer
            or peer["uid"] != os.getuid()
            or peer["comm"] not in CODEX_COMMS
        ):
            entry["reason"] = "app-server-identity"
            health[name] = entry
            continue
        entry["app_server_pid"] = peer_pid
        watcher_ok = False
        watcher = None
        if recovery:
            try:
                watcher_pid = int(recovery.get("owner_pid", "0"))
            except ValueError:
                watcher_pid = 0
            watcher = process_info(watcher_pid)
            watcher_ok = bool(
                watcher
                and watcher["uid"] == os.getuid()
                and watcher["parent"] == window["pane_pid"]
                and recovery.get("thread") == identity["thread"]
            )
        entry["recovery"] = recovery
        entry["watcher"] = watcher if watcher_ok else None
        if (
            watcher_ok
            and recovery.get("phase") == "blocked"
            and recovery.get("reason") == "unsafe-tail"
        ):
            entry["state"] = "blocked"
            entry["reason"] = "unsafe-tail"
            entry["expected_index"] = expected_index
            health[name] = entry
            continue
        if not watcher_ok:
            entry["reason"] = "watcher-absent"
            health[name] = entry
            continue
        if recovery.get("phase") not in ("watching", "recovered"):
            entry["reason"] = "watcher-state"
            health[name] = entry
            continue
        entry["state"] = "healthy"
        entry["reason"] = "ready"
        entry["expected_index"] = expected_index
        health[name] = entry
    for field in ("runtime", "thread"):
        values = {}
        for name, entry in health.items():
            identity = entry.get("identity")
            if identity:
                values.setdefault(identity[field], []).append(name)
        for names in values.values():
            if len(names) > 1:
                for name in names:
                    health[name]["state"] = "unhealthy"
                    health[name]["reason"] = "identity-duplicate"
    return health


def mapping_snapshot(mapping, health):
    for name, _index in EXPECTED:
        entry = health.get(name, {})
        identity = entry.get("identity")
        if (
            identity
            and entry.get("state") == "healthy"
            and entry.get("app_server_pid")
        ):
            mapping[name] = {
                "runtime": identity["runtime"],
                "thread": identity["thread"],
                "app_server_pid": entry["app_server_pid"],
                "app_server_start": process_info(entry["app_server_pid"])["start"],
                "index": entry["window"]["index"],
                "window_id": entry["window"]["window_id"],
                "cwd": entry["window"]["path"],
                "native_cwd": entry["window"]["path"] == TARGET_PATHS[name],
            }
    return mapping


def canonical_topology(windows):
    if len(windows) != len(EXPECTED):
        return False
    for name, index in EXPECTED:
        matches = [
            window
            for window in windows
            if window["name"] == name and window["index"] == index
        ]
        if (
            len(matches) != 1
            or matches[0]["panes"] != 1
            or matches[0]["dead"]
            or not target_cwd_allowed(name, matches[0]["path"])
        ):
            return False
    return True


def recovery_candidates(windows, health, clients):
    blocked = [
        name
        for name, _index in EXPECTED
        if health.get(name, {}).get("state") == "blocked"
        and health[name].get("reason") == "unsafe-tail"
    ]
    if not blocked:
        return [], "none"
    if not canonical_topology(windows):
        return [], "deferred-ambiguous"
    stable = []
    for name, _index in EXPECTED:
        entry = health.get(name, {})
        if (
            not entry.get("identity")
            or not entry.get("window")
            or not entry.get("app_server_pid")
        ):
            return [], "deferred-peer-identity"
        stable.append(entry)
    app_servers = {entry.get("app_server_pid") for entry in stable}
    if len(app_servers) != 1 or None in app_servers:
        return [], "deferred-app-server-identity"
    attached = {window_id for _pid, window_id in clients}
    candidates = []
    deferred = False
    for target in blocked:
        target_entry = health[target]
        target_window = target_entry["window"]
        if target_window["window_id"] in attached:
            deferred = True
            continue
        identity = target_entry.get("identity") or {}
        watcher = target_entry.get("watcher") or {}
        recovery = target_entry.get("recovery") or {}
        server = process_info(target_entry["app_server_pid"])
        required = (
            identity.get("runtime"),
            identity.get("thread"),
            watcher.get("pid"),
            watcher.get("start"),
            server,
        )
        if not all(required):
            deferred = True
            continue
        candidates.append(
            {
                "schema": 1,
                "target": target,
                "runtime": identity["runtime"],
                "thread": identity["thread"],
                "watcher_pid": watcher["pid"],
                "watcher_start": watcher["start"],
                "app_server_pid": target_entry["app_server_pid"],
                "app_server_start": server["start"],
                "recoveries": recovery.get("recoveries", "unknown"),
                "rolled_back": recovery.get("rolled_back", "unknown"),
                "window_id": target_window["window_id"],
                "window_index": target_window["index"],
            }
        )
    if candidates:
        return candidates, "candidates"
    return [], "deferred-target-attached" if deferred else "deferred-identity"


def enqueue_helper_recovery(candidate):
    helper = os.path.join(
        os.environ["HARNESS_CONTROL_ROOT"],
        "libexec",
        "harness-codex-recovery-helper",
    )
    arguments = [
        helper,
        "--enqueue-blocked",
        "--target",
        candidate["target"],
        "--runtime",
        candidate["runtime"],
        "--thread",
        candidate["thread"],
        "--watcher-pid",
        str(candidate["watcher_pid"]),
        "--watcher-start",
        candidate["watcher_start"],
        "--app-server-pid",
        str(candidate["app_server_pid"]),
        "--app-server-start",
        candidate["app_server_start"],
        "--window-id",
        candidate["window_id"],
        "--window-index",
        str(candidate["window_index"]),
    ]
    result = subprocess.run(
        arguments,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def test_fixture(path, enforce):
    with open(path, "r") as stream:
        fixture = json.load(stream)
    windows = fixture["windows"]
    order_action = "none"
    names = [window["name"] for window in windows]
    if enforce:
        if len(windows) == 3 and sorted(names) == sorted(name for name, _ in EXPECTED):
            for name, index in EXPECTED:
                next(window for window in windows if window["name"] == name)["index"] = index
            order_action = "ordered" if fixture.get("out_of_order") else "none"
        else:
            order_action = "deferred-ambiguous"
    repair_action = fixture.get("repair_action", "none")
    phone_mirror = fixture.get("phone_mirror", "healthy")
    states = fixture.get("health", {})
    healthy = sum(1 for value in states.values() if value.get("state") == "healthy")
    phase = (
        "healthy"
        if healthy == 3
        and order_action != "deferred-ambiguous"
        and phone_mirror == "healthy"
        else "degraded"
    )
    print(
        "TMUX_CODEX_MONITOR phase={} healthy={} phone_mirror={} "
        "order_action={} repair_action={}".format(
            phase,
            healthy,
            phone_mirror,
            order_action,
            repair_action,
        )
    )
    return 0 if phase == "healthy" else 1


def parse_arguments():
    parser = argparse.ArgumentParser(prog="harness tmux-codex-monitor")
    modes = parser.add_mutually_exclusive_group(required=True)
    modes.add_argument("--once", action="store_true")
    modes.add_argument("--interval", type=int)
    modes.add_argument("--status", action="store_true")
    parser.add_argument("--enforce-order", action="store_true")
    parser.add_argument("--auto-recover", action="store_true")
    arguments = parser.parse_args()
    if arguments.interval is not None and not 30 <= arguments.interval <= 3600:
        parser.error("--interval must be between 30 and 3600 seconds")
    if arguments.status and arguments.enforce_order:
        parser.error("--status does not accept --enforce-order")
    if arguments.status and arguments.auto_recover:
        parser.error("--status does not accept --auto-recover")
    return arguments


def main():
    arguments = parse_arguments()
    fixture = os.environ.get("HARNESS_TEST_TMUX_CODEX_FIXTURE")
    if fixture:
        if os.environ.get("HARNESS_TESTING") != "1":
            fail("test fixture requires HARNESS_TESTING=1")
        return test_fixture(fixture, arguments.enforce_order)
    try:
        validate_all()
    except TargetError as error:
        fail(str(error))
    root = runtime_root()
    receipt_path = os.path.join(root, "receipt.json")
    mapping_path = os.path.join(root, "mapping.json")
    if arguments.status:
        receipt = read_private_json(receipt_path, None)
        if not receipt:
            print("TMUX_CODEX_MONITOR phase=absent")
            return 1
        owner = process_info(receipt.get("owner_pid", 0))
        if (
            not owner
            or owner["comm"] != "python3"
            or int(time.time()) - receipt.get("epoch", 0) > 120
        ):
            receipt["phase"] = "stale"
        print(
            "TMUX_CODEX_MONITOR phase={} healthy={} phone_mirror={} "
            "order_action={} repair_action={} owner_pid={}".format(
                receipt["phase"],
                receipt["healthy"],
                receipt.get("phone_mirror", "unavailable"),
                receipt["order_action"],
                receipt["repair_action"],
                receipt["owner_pid"],
            )
        )
        return 0 if receipt["phase"] == "healthy" else 1
    stopping = [False]
    signal.signal(signal.SIGTERM, lambda _signum, _frame: stopping.__setitem__(0, True))
    while not stopping[0]:
        phase = "unavailable"
        healthy = 0
        phone_mirror = "unavailable"
        order_action = "none"
        repair_action = "none"
        with exclusive_lock(os.path.join(root, "monitor.lock")):
            try:
                windows = tmux_windows()
                if arguments.enforce_order:
                    windows, order_action = enforce_order(windows)
                health = collect_health(windows)
                mapping = read_private_json(mapping_path, {})
                mapping = mapping_snapshot(mapping, health)
                atomic_json(mapping_path, mapping)
                healthy = sum(
                    1 for entry in health.values() if entry["state"] == "healthy"
                )
                phone_mirror = phone_mirror_health()
                phase = (
                    "healthy"
                    if healthy == 3
                    and order_action != "deferred-ambiguous"
                    and phone_mirror == "healthy"
                    else "degraded"
                )
                if arguments.auto_recover:
                    candidates, selection = recovery_candidates(
                        windows,
                        health,
                        tmux_clients(),
                    )
                    if candidates:
                        queued = sum(
                            1
                            for candidate in candidates
                            if enqueue_helper_recovery(candidate)
                        )
                        repair_action = (
                            "helper-queued-{}".format(queued)
                            if queued
                            else "deferred-helper-unavailable"
                        )
                    elif selection != "none":
                        repair_action = selection
                for name, index in EXPECTED:
                    entry = health.get(name, {})
                    print(
                        "TMUX_CODEX_WINDOW index={} name={} state={} reason={}".format(
                            index,
                            name,
                            entry.get("state", "unhealthy"),
                            entry.get("reason", "window-missing"),
                        )
                    )
            except MonitorError:
                phase = "unavailable"
            receipt = {
                "schema": 1,
                "phase": phase,
                "healthy": healthy,
                "phone_mirror": phone_mirror,
                "order_action": order_action,
                "repair_action": repair_action,
                "owner_pid": os.getpid(),
                "epoch": int(time.time()),
            }
            atomic_json(receipt_path, receipt)
        print(
            "TMUX_CODEX_MONITOR phase={} healthy={} phone_mirror={} "
            "order_action={} repair_action={}".format(
                phase, healthy, phone_mirror, order_action, repair_action
            )
        )
        if arguments.once:
            return 0 if phase == "healthy" else 1
        deadline = time.monotonic() + arguments.interval
        while not stopping[0]:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            time.sleep(min(0.2, remaining))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (MonitorError, TargetError, ValueError, KeyError, OSError) as error:
        print("harness: tmux Codex monitor failed: {}".format(error), file=sys.stderr)
        sys.exit(2)
