#!/bin/sh
# Routine repository housekeeping (T-362).
#
# Five routines, each ending in a printed receipt the caller records in the
# active task record. Plan is always safe and read-only. Apply performs only
# the two mechanically reversible routines; scratch artefacts route to
# guarded-bulk-delete, and board and evidence review stay report-only by
# design because they need judgement.
set -eu

HARNESS_ROOT=${HARNESS_ROOT:-$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)}
export HARNESS_ROOT

die() {
    printf 'harness: %s\n' "$1" >&2
    exit 2
}

usage() {
    cat >&2 <<'EOF'
Usage:
  harness housekeeping --plan [--routine NAME]
  harness housekeeping --apply --routine branches|launchers

Routines:
  scratch    build workspaces and staged temporaries (plan only; route to
             guarded-bulk-delete)
  branches   local branches whose pull request is merged (plan and apply)
  launchers  superseded owner-home transaction launchers (plan and apply)
  board      board and record compaction candidates (report only)
  evidence   completed cowork sandboxes, seals, preimages (report only)
EOF
    exit 64
}

mode=
routine=all
while [ "$#" -gt 0 ]; do
    case $1 in
        --plan|--apply) [ -z "$mode" ] || usage; mode=${1#--} ;;
        --routine) shift; [ "$#" -gt 0 ] || usage; routine=$1 ;;
        -h|--help) usage ;;
        *) usage ;;
    esac
    shift
done
[ -n "$mode" ] || usage
case $routine in
    all|scratch|branches|launchers|board|evidence) ;;
    *) die "unknown housekeeping routine" ;;
esac
if [ "$mode" = apply ]; then
    case $routine in
        branches|launchers) ;;
        all) die "apply requires an exact routine" ;;
        *) die "routine is report-only" ;;
    esac
fi

selected() {
    [ "$routine" = all ] || [ "$routine" = "$1" ]
}

repo_root() {
    printf '%s' "${HARNESS_TEST_HOUSEKEEPING_REPO:-$HARNESS_ROOT}"
}

git_in() {
    git -C "$(repo_root)" "$@"
}

gh_bin() {
    if [ -n "${HARNESS_TEST_GH:-}" ]; then
        [ "${HARNESS_TESTING:-}" = 1 ] || die "test gh override is unsafe"
        printf '%s' "$HARNESS_TEST_GH"
        return
    fi
    command -v gh >/dev/null 2>&1 || return 1
    printf 'gh'
}

owner_home() {
    printf '%s' "${HARNESS_TEST_OWNER_HOME:-$HOME}"
}

receipt_dir() {
    base=${HARNESS_TEST_RECEIPT_DIR:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}}
    printf '%s/harness-housekeeping-%s' "$base" "$(id -u)"
}

# --- routine: merged branches -------------------------------------------
#
# Classify against authoritative pull-request merge state, never file diffs.
# A stale branch differs from the trunk merely by being behind it, so a
# diff-based test misclassifies every one of them.
merged_branch_names() {
    gh=$(gh_bin) || return 0
    "$gh" pr list --state merged --limit 200 --json headRefName \
        --jq '.[].headRefName' 2>/dev/null || true
}

checked_out_branches() {
    git_in worktree list --porcelain 2>/dev/null |
        sed -n 's|^branch refs/heads/||p'
}

branch_candidates() {
    merged=$(merged_branch_names)
    [ -n "$merged" ] || return 0
    held=$(checked_out_branches)
    current=$(git_in rev-parse --abbrev-ref HEAD 2>/dev/null || printf '')
    git_in for-each-ref --format='%(refname:short)' refs/heads |
        while read -r branch; do
            [ "$branch" != "$current" ] || continue
            printf '%s\n' "$merged" | grep -qx "$branch" || continue
            printf '%s\n' "$held" | grep -qx "$branch" && continue
            printf '%s %s\n' "$branch" "$(git_in rev-parse "$branch")"
        done
}

plan_branches() {
    candidates=$(branch_candidates)
    count=$(printf '%s' "$candidates" | grep -c . || true)
    printf 'HOUSEKEEPING routine=branches mode=plan candidates=%s\n' "${count:-0}"
    [ -z "$candidates" ] || printf '%s\n' "$candidates" |
        while read -r name sha; do
            printf '  CANDIDATE branch=%s tip=%s restore="git branch %s %s"\n' \
                "$name" "$sha" "$name" "$sha"
        done
}

apply_branches() {
    candidates=$(branch_candidates)
    if [ -z "$candidates" ]; then
        printf 'HOUSEKEEPING routine=branches mode=apply removed=0 reason=no-candidates\n'
        return 0
    fi
    directory=$(receipt_dir)
    mkdir -p "$directory"
    chmod 700 "$directory"
    receipt=$directory/branches-$(date -u '+%Y%m%dT%H%M%SZ').txt
    umask 077
    removed=0
    printf '%s\n' "$candidates" | while read -r name sha; do
        [ -n "$name" ] || continue
        printf 'branch=%s tip=%s restore=git branch %s %s\n' \
            "$name" "$sha" "$name" "$sha" >>"$receipt"
    done
    printf '%s\n' "$candidates" | while read -r name sha; do
        [ -n "$name" ] || continue
        # -D is safe here only because the tip is recorded above and the
        # branch is proven merged by its pull request.
        git_in branch -D "$name" >/dev/null 2>&1 || true
    done
    removed=$(grep -c '^branch=' "$receipt" 2>/dev/null || printf 0)
    printf 'HOUSEKEEPING routine=branches mode=apply removed=%s receipt=%s\n' \
        "$removed" "$receipt"
}

# --- routine: superseded owner-home launchers ---------------------------
launcher_candidates() {
    home=$(owner_home)
    for candidate in "$home"/*.sh; do
        [ -e "$candidate" ] || continue
        [ -f "$candidate" ] && [ ! -L "$candidate" ] || continue
        owner=$(stat -c '%u' "$candidate" 2>/dev/null || stat -f '%u' "$candidate")
        [ "$owner" = "$(id -u)" ] || continue
        links=$(stat -c '%h' "$candidate" 2>/dev/null || stat -f '%l' "$candidate")
        [ "$links" = 1 ] || continue
        case $(basename "$candidate") in
            run_this.sh) continue ;;
        esac
        printf '%s\n' "$candidate"
    done
}

plan_launchers() {
    candidates=$(launcher_candidates)
    count=$(printf '%s' "$candidates" | grep -c . || true)
    printf 'HOUSEKEEPING routine=launchers mode=plan candidates=%s\n' "${count:-0}"
    [ -z "$candidates" ] || printf '%s\n' "$candidates" |
        while read -r path; do printf '  CANDIDATE launcher=%s\n' "$path"; done
}

apply_launchers() {
    candidates=$(launcher_candidates)
    if [ -z "$candidates" ]; then
        printf 'HOUSEKEEPING routine=launchers mode=apply removed=0 reason=no-candidates\n'
        return 0
    fi
    removed=0
    printf '%s\n' "$candidates" | while read -r path; do
        [ -n "$path" ] || continue
        # Exact non-recursive unlink only; never a glob or recursive removal.
        rm "$path"
    done
    removed=$(printf '%s' "$candidates" | grep -c . || printf 0)
    printf 'HOUSEKEEPING routine=launchers mode=apply removed=%s\n' "$removed"
}

# --- report-only routines ------------------------------------------------
plan_scratch() {
    root=$(repo_root)
    count=0
    for candidate in "$root"/.t*-sandbox "$root"/*-scratch; do
        [ -d "$candidate" ] || continue
        count=$((count + 1))
        printf '  CANDIDATE scratch=%s route=guarded-bulk-delete\n' "$candidate"
    done
    printf 'HOUSEKEEPING routine=scratch mode=plan candidates=%s route=guarded-bulk-delete\n' \
        "$count"
}

plan_board() {
    root=$(repo_root)
    lines=$(wc -l <"$root/TODO.md" 2>/dev/null | tr -d ' ' || printf 0)
    words=$(wc -w <"$root/TODO.md" 2>/dev/null | tr -d ' ' || printf 0)
    active=$(grep -c '^### ' "$root/TODO.md" 2>/dev/null || printf 0)
    printf 'HOUSEKEEPING routine=board mode=report lines=%s words=%s active=%s note=verify-context-gate-after-compaction\n' \
        "$lines" "$words" "$active"
}

plan_evidence() {
    root=$(repo_root)
    count=0
    for candidate in "$root"/docs/audits/*/cowork; do
        [ -d "$candidate" ] && count=$((count + 1))
    done
    printf 'HOUSEKEEPING routine=evidence mode=report cowork_sessions=%s note=retained-by-default\n' \
        "${count:-0}"
}

if [ "$mode" = plan ]; then
    selected scratch && plan_scratch
    selected branches && plan_branches
    selected launchers && plan_launchers
    selected board && plan_board
    selected evidence && plan_evidence
    exit 0
fi

case $routine in
    branches) apply_branches ;;
    launchers) apply_launchers ;;
esac
