#!/bin/sh
set -eu

SELF_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
HARNESS_ROOT=${HARNESS_ROOT:-$(CDPATH='' cd -- "$SELF_DIR/.." && pwd)}
export HARNESS_ROOT
# shellcheck source=libexec/harness-common
# shellcheck disable=SC1091
. "$SELF_DIR/harness-common"

usage() {
    echo 'Usage: harness codex-arg0-wrapper --plan|--apply|--doctor|--rollback' >&2
}

normalized_semver() {
    awk -v version="$1" 'BEGIN {
        if (version !~ /^[0-9]+\.[0-9]+\.[0-9]+$/) exit 1
        count = split(version, part, ".")
        if (count != 3) exit 1
        for (i = 1; i <= 3; i++) {
            if (part[i] !~ /^(0|[1-9][0-9]*)$/) exit 1
        }
    }'
}

mode=plan
[ "$#" -le 1 ] || { usage; exit 2; }
if [ "$#" -eq 1 ]; then
    case "$1" in
        --plan) mode=plan ;;
        --apply) mode=apply ;;
        --doctor) mode=doctor ;;
        --rollback) mode=rollback ;;
        -h|--help) usage; exit 0 ;;
        *) usage; exit 2 ;;
    esac
fi

[ "$(uname -s)" = Linux ] || die "Codex arg0 wrapper is supported only on Linux"
case ${HOME:-} in /*) ;; *) die "Codex arg0 wrapper requires an absolute HOME" ;; esac
current_uid=$(id -u)
stable=$HOME/.local/bin/codex
template=$HARNESS_ROOT/libexec/codex-arg0-launcher-wrapper
[ -L "$stable" ] || die "version-scoped Codex launcher link is unavailable"
stable_target=$(readlink "$stable")
stable_resolved=$(realpath -e -- "$stable") ||
    die "cannot resolve version-scoped Codex launcher"
managed_wrapper_prefix=$HOME/.local/opt/harness/codex-arg0-wrapper/
case "$stable_target" in
    "$HOME/.local/opt/agents/codex/"*|"$managed_wrapper_prefix"*)
        classification_path=$stable_target
        ;;
    *) classification_path=$stable_resolved ;;
esac
case "$classification_path" in
    "$HOME/.codex/packages/standalone/releases/"*)
        layout=standalone
        source_kind=release
        launcher=$stable_resolved
        prefix=$HOME/.codex/packages/standalone/releases/
        relative=${launcher#"$prefix"}
        release=${relative%%/*}
        suffix=${relative#*/}
        require_safe_id "$release"
        [ "$suffix" = bin/codex ] ||
            die "Codex launcher has an invalid standalone release layout"
        launcher_dir=${launcher%/*}
        real_codex=$launcher_dir/codex.real
        state_file=$launcher_dir/.harness-arg0-wrapper.state
        ;;
    "$HOME/.local/opt/agents/codex/"*)
        layout=managed-npm
        source_kind=release
        prefix=$HOME/.local/opt/agents/codex/
        relative=${classification_path#"$prefix"}
        release=${relative%%/*}
        remainder=${relative#*/}
        platform=${remainder%%/*}
        suffix=${remainder#*/}
        require_safe_id "$release"
        normalized_semver "$release" ||
            die "managed Codex launcher version is not normalized"
        case "$(uname -m):$platform" in
            x86_64:linux-x86_64|aarch64:linux-aarch64) ;;
            *) die "managed Codex launcher platform differs from this host" ;;
        esac
        [ "$suffix" = node_modules/@openai/codex/bin/codex.js ] ||
            die "Codex launcher has an invalid managed npm layout"
        managed_original=$classification_path
        case "$stable_target" in
            /*) ;;
            *) die "managed Codex stable link must use an absolute target" ;;
        esac
        wrapper_base=${managed_wrapper_prefix%/}
        wrapper_release_dir=$wrapper_base/$release
        launcher_dir=$wrapper_release_dir/$platform
        launcher=$launcher_dir/codex
        real_codex=$launcher_dir/codex.real
        state_file=$launcher_dir/.harness-arg0-wrapper.state
        ;;
    "$managed_wrapper_prefix"*)
        layout=managed-npm
        source_kind=wrapper
        relative=${classification_path#"$managed_wrapper_prefix"}
        release=${relative%%/*}
        remainder=${relative#*/}
        platform=${remainder%%/*}
        suffix=${remainder#*/}
        require_safe_id "$release"
        normalized_semver "$release" ||
            die "managed Codex wrapper version is not normalized"
        case "$(uname -m):$platform" in
            x86_64:linux-x86_64|aarch64:linux-aarch64) ;;
            *) die "managed Codex wrapper platform differs from this host" ;;
        esac
        [ "$suffix" = codex ] ||
            die "Codex launcher has an invalid managed wrapper layout"
        wrapper_base=${managed_wrapper_prefix%/}
        wrapper_release_dir=$wrapper_base/$release
        launcher_dir=$wrapper_release_dir/$platform
        launcher=$classification_path
        real_codex=$launcher_dir/codex.real
        state_file=$launcher_dir/.harness-arg0-wrapper.state
        managed_original=$HOME/.local/opt/agents/codex/$release/$platform/node_modules/@openai/codex/bin/codex.js
        ;;
    *) die "Codex launcher is outside a supported version-scoped release tree" ;;
esac

is_wrapper() {
    [ -f "$launcher" ] && [ ! -L "$launcher" ] &&
        sed -n '2p' "$launcher" | grep -F -x '# harness-codex-arg0-wrapper-v1' >/dev/null 2>&1
}

require_private_state() {
    [ -f "$state_file" ] && [ ! -L "$state_file" ] || die "arg0 wrapper state is unavailable"
    [ "$(stat -Lc '%u' -- "$state_file")" = "$current_uid" ] || die "arg0 wrapper state owner differs"
    [ "$(stat -Lc '%a' -- "$state_file")" = 600 ] || die "arg0 wrapper state mode differs"
    [ "$(stat -Lc '%h' -- "$state_file")" = 1 ] || die "arg0 wrapper state must have one link"
}

field() {
    key=$1
    value=$(sed -n "s/^${key}=//p" "$state_file")
    [ "$(printf '%s\n' "$value" | awk 'NF { n++ } END { print n + 0 }')" -eq 1 ] ||
        die "arg0 wrapper state field is invalid: $key"
    printf '%s\n' "$value"
}

validate_installed() {
    is_wrapper || die "installed arg0 wrapper bytes changed"
    if [ "$layout" = managed-npm ]; then
        [ "$(readlink "$stable")" = "$launcher" ] ||
            die "stable Codex launcher differs from installed wrapper"
        [ -L "$real_codex" ] && [ "$(readlink "$real_codex")" = "$managed_original" ] &&
            [ -f "$managed_original" ] && [ ! -L "$managed_original" ] &&
            [ -x "$managed_original" ] ||
            die "preserved managed Codex launcher is unavailable"
        preserved_launcher=$managed_original
    else
        [ "$(realpath -e -- "$stable")" = "$launcher" ] ||
            die "stable Codex launcher differs from installed wrapper"
        [ -f "$real_codex" ] && [ ! -L "$real_codex" ] && [ -x "$real_codex" ] ||
            die "preserved standalone Codex launcher is unavailable"
        preserved_launcher=$real_codex
    fi
    require_private_state
    [ "$(field schema)" = 1 ] && [ "$(field operation)" = codex-arg0-wrapper ] ||
        die "arg0 wrapper state schema is invalid"
    official_hash=$(field official_sha256)
    wrapper_hash=$(field wrapper_sha256)
    [ "$(sha256sum "$preserved_launcher" | awk '{print $1}')" = "$official_hash" ] ||
        die "preserved Codex launcher changed"
    [ "$(sha256sum "$launcher" | awk '{print $1}')" = "$wrapper_hash" ] ||
        die "installed arg0 wrapper changed"
}

if [ "$layout:$source_kind" = managed-npm:release ]; then
    if [ -f "$managed_original" ] && [ ! -L "$managed_original" ] &&
        [ -x "$managed_original" ] &&
        [ ! -e "$launcher" ] && [ ! -L "$launcher" ] &&
        [ ! -e "$real_codex" ] && [ ! -L "$real_codex" ] &&
        [ ! -e "$state_file" ] && [ ! -L "$state_file" ]; then
        state=unwrapped
    else
        state=ambiguous
    fi
elif is_wrapper; then
    state=installed
elif [ "$layout" = standalone ] &&
    [ -f "$launcher" ] && [ ! -L "$launcher" ] && [ -x "$launcher" ] &&
    [ ! -e "$real_codex" ] && [ ! -L "$real_codex" ] &&
    [ ! -e "$state_file" ] && [ ! -L "$state_file" ]; then
        state=unwrapped
else
    state=ambiguous
fi

if [ "$mode" = doctor ]; then
    [ "$state" = installed ] || die "Codex arg0 wrapper is not installed cleanly"
    validate_installed
    printf 'CODEX_ARG0_WRAPPER mode=doctor status=ready layout=%s release=%s\n' \
        "$layout" "$release"
    exit 0
fi

if [ "$mode" = plan ]; then
    case "$state" in
        unwrapped) action=install ;;
        installed) validate_installed; action=none ;;
        *) action=blocked ;;
    esac
    printf 'CODEX_ARG0_WRAPPER mode=plan state=%s action=%s layout=%s release=%s running_processes=unchanged\n' \
        "$state" "$action" "$layout" "$release"
    [ "$action" != blocked ] || die "Codex arg0 wrapper state is ambiguous"
    exit 0
fi

if [ "$mode" = apply ]; then
    [ "$state" != ambiguous ] || die "Codex arg0 wrapper state is ambiguous"
    if [ "$state" = installed ]; then
        validate_installed
        printf 'CODEX_ARG0_WRAPPER mode=apply status=ready action=none layout=%s release=%s\n' \
            "$layout" "$release"
        exit 0
    fi
    [ "${HARNESS_TESTING:-0}" = 1 ] || {
        [ -d "$HARNESS_ROOT/.git" ] && [ ! -L "$HARNESS_ROOT/.git" ] ||
            die "Codex arg0 wrapper requires a Git harness checkout"
        [ -z "$(git -C "$HARNESS_ROOT" status --porcelain --untracked-files=normal)" ] ||
            die "Codex arg0 wrapper requires a clean committed checkout"
        [ "$(git -C "$HARNESS_ROOT" symbolic-ref --quiet --short HEAD)" = main ] ||
            die "Codex arg0 wrapper requires the main branch"
    }
    [ -f "$template" ] && [ ! -L "$template" ] && [ -x "$template" ] ||
        die "canonical arg0 wrapper template is unavailable"
    sh -n "$template" || die "canonical arg0 wrapper syntax is invalid"
    if [ "$layout" = managed-npm ]; then
        [ "$(stat -Lc '%u' -- "$managed_original")" = "$current_uid" ] ||
            die "managed Codex launcher owner differs"
        for managed_parent in "$HOME/.local" "$HOME/.local/opt"; do
            [ -d "$managed_parent" ] && [ ! -L "$managed_parent" ] &&
                [ "$(stat -Lc '%u' -- "$managed_parent")" = "$current_uid" ] ||
                die "managed wrapper parent is unsafe"
        done
        created_harness_dir=0
        created_wrapper_base=0
        created_wrapper_release=0
        created_launcher_dir=0
        for managed_directory in \
            "$HOME/.local/opt/harness" "$wrapper_base" \
            "$wrapper_release_dir" "$launcher_dir"
        do
            if [ -e "$managed_directory" ] || [ -L "$managed_directory" ]; then
                [ -d "$managed_directory" ] && [ ! -L "$managed_directory" ] &&
                    [ "$(stat -Lc '%u' -- "$managed_directory")" = "$current_uid" ] ||
                    die "managed wrapper directory is unsafe"
            else
                mkdir -- "$managed_directory"
                chmod 700 "$managed_directory"
                case "$managed_directory" in
                    "$HOME/.local/opt/harness") created_harness_dir=1 ;;
                    "$wrapper_base") created_wrapper_base=1 ;;
                    "$wrapper_release_dir") created_wrapper_release=1 ;;
                    "$launcher_dir") created_launcher_dir=1 ;;
                esac
            fi
        done
        official_hash=$(sha256sum "$managed_original" | awk '{print $1}')
        wrapper_hash=$(sha256sum "$template" | awk '{print $1}')
        wrapper_temp=$(mktemp "$launcher_dir/.codex-wrapper.XXXXXX") ||
            die "cannot stage managed arg0 wrapper"
        state_temp=$(mktemp "$launcher_dir/.codex-wrapper-state.XXXXXX") || {
            unlink "$wrapper_temp"; die "cannot stage managed arg0 wrapper state";
        }
        stable_temp=$HOME/.local/bin/.codex-wrapper-link.$$
        [ ! -e "$stable_temp" ] && [ ! -L "$stable_temp" ] ||
            die "managed arg0 stable-link staging collision"
        # shellcheck disable=SC2329
        cleanup_managed_apply() {
            status=$?
            trap - EXIT HUP INT TERM
            [ ! -e "$wrapper_temp" ] || unlink "$wrapper_temp"
            [ ! -e "$state_temp" ] || unlink "$state_temp"
            [ ! -e "$stable_temp" ] && [ ! -L "$stable_temp" ] ||
                unlink "$stable_temp"
            if [ "$status" -ne 0 ]; then
                current_stable=$(readlink "$stable" 2>/dev/null || true)
                if [ "$current_stable" = "$launcher" ]; then
                    recovery_link=$HOME/.local/bin/.codex-wrapper-recovery.$$
                    [ ! -e "$recovery_link" ] && [ ! -L "$recovery_link" ] ||
                        exit "$status"
                    ln -s "$managed_original" "$recovery_link" &&
                        mv -Tf -- "$recovery_link" "$stable"
                    [ ! -e "$recovery_link" ] && [ ! -L "$recovery_link" ] ||
                        unlink "$recovery_link"
                fi
                if [ -f "$launcher" ] && [ ! -L "$launcher" ] &&
                    [ "$(sha256sum "$launcher" | awk '{print $1}')" = "$wrapper_hash" ]; then
                    unlink "$launcher"
                fi
                if [ -f "$state_file" ] && [ ! -L "$state_file" ] &&
                    [ "$(stat -Lc '%u' -- "$state_file")" = "$current_uid" ]; then
                    unlink "$state_file"
                fi
                if [ -L "$real_codex" ] &&
                    [ "$(readlink "$real_codex")" = "$managed_original" ]; then
                    unlink "$real_codex"
                fi
                [ "$created_launcher_dir" -eq 0 ] ||
                    rmdir "$launcher_dir" 2>/dev/null || true
                [ "$created_wrapper_release" -eq 0 ] ||
                    rmdir "$wrapper_release_dir" 2>/dev/null || true
                [ "$created_wrapper_base" -eq 0 ] ||
                    rmdir "$wrapper_base" 2>/dev/null || true
                [ "$created_harness_dir" -eq 0 ] ||
                    rmdir "$HOME/.local/opt/harness" 2>/dev/null || true
            fi
            exit "$status"
        }
        trap cleanup_managed_apply EXIT HUP INT TERM
        cp -- "$template" "$wrapper_temp"
        chmod 755 "$wrapper_temp"
        umask 077
        {
            echo 'schema=1'
            echo 'operation=codex-arg0-wrapper'
            printf 'official_sha256=%s\n' "$official_hash"
            printf 'wrapper_sha256=%s\n' "$wrapper_hash"
        } >"$state_temp"
        chmod 600 "$state_temp"
        ln -s "$managed_original" "$real_codex"
        if [ "${HARNESS_TESTING:-0}:${HARNESS_ARG0_FAIL_AFTER:-}" = 1:official-move ]; then
            die "injected arg0 wrapper failure after managed launcher link"
        fi
        mv -- "$wrapper_temp" "$launcher"
        wrapper_temp=
        if [ "${HARNESS_TESTING:-0}:${HARNESS_ARG0_FAIL_AFTER:-}" = 1:wrapper-move ]; then
            die "injected arg0 wrapper failure after wrapper move"
        fi
        mv -- "$state_temp" "$state_file"
        state_temp=
        if [ "${HARNESS_TESTING:-0}:${HARNESS_ARG0_FAIL_AFTER:-}" = 1:state-move ]; then
            die "injected arg0 wrapper failure after state move"
        fi
        ln -s "$launcher" "$stable_temp"
        mv -Tf -- "$stable_temp" "$stable"
        stable_temp=
        if [ "${HARNESS_TESTING:-0}:${HARNESS_ARG0_FAIL_AFTER:-}" = 1:stable-switch ]; then
            die "injected arg0 wrapper failure after stable-link switch"
        fi
        source_kind=wrapper
        validate_installed
        trap - EXIT HUP INT TERM
        printf 'CODEX_ARG0_WRAPPER mode=apply status=ready action=installed layout=%s release=%s running_processes=unchanged\n' \
            "$layout" "$release"
        exit 0
    fi
    [ "$(stat -Lc '%u' -- "$launcher")" = "$current_uid" ] ||
        die "Codex launcher owner differs"
    official_hash=$(sha256sum "$launcher" | awk '{print $1}')
    wrapper_hash=$(sha256sum "$template" | awk '{print $1}')
    wrapper_temp=$(mktemp "$launcher_dir/.codex-wrapper.XXXXXX") ||
        die "cannot stage arg0 wrapper"
    state_temp=$(mktemp "$launcher_dir/.codex-wrapper-state.XXXXXX") || {
        unlink "$wrapper_temp"; die "cannot stage arg0 wrapper state";
    }
    # shellcheck disable=SC2329
    cleanup_apply() {
        status=$?
        trap - EXIT HUP INT TERM
        [ ! -e "$wrapper_temp" ] || unlink "$wrapper_temp"
        [ ! -e "$state_temp" ] || unlink "$state_temp"
        if [ "$status" -ne 0 ] && [ -f "$real_codex" ] && [ ! -L "$real_codex" ]; then
            if [ -f "$launcher" ] && [ ! -L "$launcher" ] &&
                [ "$(sha256sum "$launcher" | awk '{print $1}')" = "$wrapper_hash" ]; then
                unlink "$launcher"
            fi
            if [ ! -e "$launcher" ] && [ ! -L "$launcher" ]; then
                mv -- "$real_codex" "$launcher"
            fi
            if [ -f "$state_file" ] && [ ! -L "$state_file" ] &&
                [ "$(stat -Lc '%u' -- "$state_file")" = "$current_uid" ]; then
                unlink "$state_file"
            fi
        fi
        exit "$status"
    }
    trap cleanup_apply EXIT HUP INT TERM
    cp -- "$template" "$wrapper_temp"
    chmod 755 "$wrapper_temp"
    umask 077
    {
        echo 'schema=1'
        echo 'operation=codex-arg0-wrapper'
        printf 'official_sha256=%s\n' "$official_hash"
        printf 'wrapper_sha256=%s\n' "$wrapper_hash"
    } >"$state_temp"
    chmod 600 "$state_temp"
    mv -- "$launcher" "$real_codex"
    if [ "${HARNESS_TESTING:-0}:${HARNESS_ARG0_FAIL_AFTER:-}" = 1:official-move ]; then
        die "injected arg0 wrapper failure after official move"
    fi
    mv -- "$wrapper_temp" "$launcher"
    wrapper_temp=
    if [ "${HARNESS_TESTING:-0}:${HARNESS_ARG0_FAIL_AFTER:-}" = 1:wrapper-move ]; then
        die "injected arg0 wrapper failure after wrapper move"
    fi
    mv -- "$state_temp" "$state_file"
    state_temp=
    if [ "${HARNESS_TESTING:-0}:${HARNESS_ARG0_FAIL_AFTER:-}" = 1:state-move ]; then
        die "injected arg0 wrapper failure after state move"
    fi
    validate_installed
    trap - EXIT HUP INT TERM
    printf 'CODEX_ARG0_WRAPPER mode=apply status=ready action=installed layout=%s release=%s running_processes=unchanged\n' \
        "$layout" "$release"
    exit 0
fi

[ "$mode" = rollback ] || { usage; exit 2; }
[ "$state" = installed ] || die "Codex arg0 wrapper is not installed"
validate_installed
if [ "$layout" = managed-npm ]; then
    rollback_link=$HOME/.local/bin/.codex-wrapper-rollback-$$
    [ ! -e "$rollback_link" ] && [ ! -L "$rollback_link" ] ||
        die "managed arg0 rollback link collision"
    ln -s "$managed_original" "$rollback_link"
    if ! mv -Tf -- "$rollback_link" "$stable"; then
        [ ! -e "$rollback_link" ] && [ ! -L "$rollback_link" ] ||
            unlink "$rollback_link"
        die "cannot restore managed Codex stable link"
    fi
    unlink "$launcher"
    unlink "$state_file"
    unlink "$real_codex"
    rmdir "$launcher_dir"
    rmdir "$wrapper_release_dir" 2>/dev/null || true
    rmdir "$wrapper_base" 2>/dev/null || true
    printf 'CODEX_ARG0_WRAPPER mode=rollback status=ready action=restored layout=%s release=%s running_processes=unchanged\n' \
        "$layout" "$release"
    exit 0
fi
rollback_temp=$launcher_dir/.codex-wrapper-rollback-$$
[ ! -e "$rollback_temp" ] && [ ! -L "$rollback_temp" ] || die "arg0 rollback path collision"
mv -- "$launcher" "$rollback_temp"
if ! mv -- "$real_codex" "$launcher"; then
    mv -- "$rollback_temp" "$launcher"
    die "cannot restore Codex launcher"
fi
unlink "$rollback_temp"
unlink "$state_file"
printf 'CODEX_ARG0_WRAPPER mode=rollback status=ready action=restored layout=%s release=%s running_processes=unchanged\n' \
    "$layout" "$release"
