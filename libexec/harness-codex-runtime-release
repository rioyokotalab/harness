#!/bin/sh
set -eu

SELF_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P)
source_root=$(CDPATH='' cd -- "$SELF_DIR/.." 2>/dev/null && pwd -P)

usage() {
    echo "Usage: harness-codex-runtime-release --exec-resilient ARGS..." >&2
    exit 2
}

[ "$#" -ge 1 ] && [ "$1" = --exec-resilient ] || usage
shift

for required in awk chmod git id mkdir mktemp mv rmdir sed sleep stat tr uname \
    unlink wc
do
    command -v "$required" >/dev/null 2>&1 || {
        echo "harness: Codex runtime release requires command: $required" >&2
        exit 2
    }
done

top=$(git -C "$source_root" rev-parse --show-toplevel 2>/dev/null) || {
    echo "harness: Codex runtime release source is not a Git checkout" >&2
    exit 2
}
[ "$top" = "$source_root" ] || {
    echo "harness: Codex runtime release source is not an exact Git root" >&2
    exit 2
}
commit=$(git -C "$source_root" rev-parse 'HEAD^{commit}' 2>/dev/null) || {
    echo "harness: Codex runtime release commit is unavailable" >&2
    exit 2
}
case "$commit" in
    *[!0-9a-f]*|'')
        echo "harness: Codex runtime release commit is malformed" >&2
        exit 2
        ;;
esac
case ${#commit} in
    40|64) ;;
    *)
        echo "harness: Codex runtime release commit is malformed" >&2
        exit 2
        ;;
esac

HARNESS_TARGET_ROOT=${HARNESS_TARGET_ROOT:-${HARNESS_CONTROL_ROOT:-$source_root}}
case "$HARNESS_TARGET_ROOT" in
    /*) ;;
    *)
        echo "harness: Codex runtime target root must be absolute" >&2
        exit 2
        ;;
esac
case ${HARNESS_CODEX_RELEASE_TARGET:-} in
    harness|personal|students) release_target=$HARNESS_CODEX_RELEASE_TARGET ;;
    *)
        echo "harness: Codex runtime release target is unavailable" >&2
        exit 2
        ;;
esac
if [ "${HARNESS_TESTING:-0}" = 1 ] &&
    [ -n "${HARNESS_TEST_CODEX_RELEASE_ROOT:-}" ]; then
    private_root=$HARNESS_TEST_CODEX_RELEASE_ROOT
else
    case ${XDG_RUNTIME_DIR:-} in
        /*) runtime_parent=$XDG_RUNTIME_DIR ;;
        *)
            case ${TMPDIR:-/tmp} in
                /*) runtime_parent=${TMPDIR:-/tmp} ;;
                *)
                    echo "harness: Codex runtime parent must be absolute" >&2
                    exit 2
                    ;;
            esac
            ;;
    esac
    private_root=$runtime_parent/harness-codex-control-$(id -u)
fi
case "$private_root" in
    /*) ;;
    *)
        echo "harness: Codex runtime release root must be absolute" >&2
        exit 2
        ;;
esac

uid=$(id -u)
platform=$(uname -s)
path_owner() {
    case "$platform" in
        Darwin) stat -f '%u' "$1" ;;
        *) stat -c '%u' -- "$1" ;;
    esac
}
path_mode() {
    case "$platform" in
        Darwin) stat -f '%Lp' "$1" ;;
        *) stat -c '%a' -- "$1" ;;
    esac
}
path_links() {
    case "$platform" in
        Darwin) stat -f '%l' "$1" ;;
        *) stat -c '%h' -- "$1" ;;
    esac
}

validate_private_dir() {
    path=$1
    [ -d "$path" ] && [ ! -L "$path" ] &&
        [ "$(path_owner "$path")" = "$uid" ] &&
        [ "$(path_mode "$path")" = 700 ] || {
        echo "harness: Codex runtime release directory is unsafe" >&2
        exit 2
    }
}
ensure_private_dir() {
    path=$1
    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
        old_umask=$(umask)
        umask 077
        if ! mkdir "$path" 2>/dev/null; then
            umask "$old_umask"
            [ -d "$path" ] || {
                echo "harness: Codex runtime release directory cannot be created" >&2
                exit 2
            }
        else
            umask "$old_umask"
        fi
        chmod 700 "$path"
    fi
    validate_private_dir "$path"
}

ensure_private_dir "$private_root"
private_root=$(
    CDPATH='' cd -- "$private_root" 2>/dev/null && pwd -P
) || {
    echo "harness: Codex runtime release root cannot be resolved" >&2
    exit 2
}
validate_private_dir "$private_root"
release_parent=$private_root/releases
ensure_private_dir "$release_parent"
target_release_parent=$release_parent/$release_target
ensure_private_dir "$target_release_parent"
marker_name=.codex-runtime-release
manifest_tmp=$(mktemp "$private_root/.manifest.XXXXXX") || {
    echo "harness: Codex runtime release manifest cannot be allocated" >&2
    exit 2
}
chmod 600 "$manifest_tmp"
payload_tmp=$(mktemp "$private_root/.payload.XXXXXX") || {
    unlink "$manifest_tmp"
    echo "harness: Codex runtime payload identity cannot be allocated" >&2
    exit 2
}
chmod 600 "$payload_tmp"
batch_tmp=$(mktemp "$private_root/.batch.XXXXXX") || {
    unlink "$payload_tmp"
    unlink "$manifest_tmp"
    echo "harness: Codex runtime Git batch cannot be allocated" >&2
    exit 2
}
chmod 600 "$batch_tmp"
stage=
lock_dir=
lock_owned=no
cleanup() {
    status=$?
    trap - EXIT HUP INT TERM
    if [ -n "$stage" ] && [ -d "$stage" ] && [ ! -L "$stage" ] &&
        [ "$(path_owner "$stage")" = "$uid" ]; then
        chmod 700 "$stage" "$stage/libexec" "$stage/profiles" ||
            status=2
        while IFS='	' read -r path mode; do
            case "$path" in ''|'#'*) continue ;; esac
            candidate=$stage/$path
            if [ -f "$candidate" ] && [ ! -L "$candidate" ] &&
                [ "$(path_owner "$candidate")" = "$uid" ] &&
                [ "$(path_links "$candidate")" = 1 ]; then
                unlink "$candidate" || status=2
            fi
        done <"$manifest_tmp"
        if [ -f "$stage/$marker_name" ] && [ ! -L "$stage/$marker_name" ]; then
            unlink "$stage/$marker_name" || status=2
        fi
        rmdir "$stage/libexec" "$stage/profiles" "$stage" 2>/dev/null || status=2
    fi
    if [ "$lock_owned" = yes ] && [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ] &&
        [ "$(path_owner "$lock_dir")" = "$uid" ]; then
        if [ -f "$lock_dir/pid" ] && [ ! -L "$lock_dir/pid" ] &&
            [ "$(path_owner "$lock_dir/pid")" = "$uid" ] &&
            [ "$(path_links "$lock_dir/pid")" = 1 ]; then
            unlink "$lock_dir/pid" || status=2
        fi
        rmdir "$lock_dir" 2>/dev/null || status=2
    fi
    if [ -f "$manifest_tmp" ] && [ ! -L "$manifest_tmp" ] &&
        [ "$(path_owner "$manifest_tmp")" = "$uid" ] &&
        [ "$(path_links "$manifest_tmp")" = 1 ]; then
        unlink "$manifest_tmp" || status=2
    fi
    if [ -f "$payload_tmp" ] && [ ! -L "$payload_tmp" ] &&
        [ "$(path_owner "$payload_tmp")" = "$uid" ] &&
        [ "$(path_links "$payload_tmp")" = 1 ]; then
        unlink "$payload_tmp" || status=2
    fi
    if [ -f "$batch_tmp" ] && [ ! -L "$batch_tmp" ] &&
        [ "$(path_owner "$batch_tmp")" = "$uid" ] &&
        [ "$(path_links "$batch_tmp")" = 1 ]; then
        unlink "$batch_tmp" || status=2
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

git -C "$source_root" show "$commit:profiles/codex-runtime-release.tsv" \
    >"$manifest_tmp" 2>/dev/null || {
    echo "harness: committed Codex runtime release manifest is unavailable" >&2
    exit 2
}

manifest_count=0
seen_common=no
seen_resilient=no
seen_launcher=no
seen_recovery=no
seen_targets=no
seen_release_profile=no
seen_targets_profile=no
while IFS='	' read -r path mode extra; do
    case "$path" in ''|'#'*) continue ;; esac
    [ -z "${extra:-}" ] || {
        echo "harness: Codex runtime release manifest is malformed" >&2
        exit 2
    }
    case "$path" in
        libexec/harness-common)
            [ "$seen_common" = no ] || {
                echo "harness: Codex runtime release manifest has a duplicate path" >&2
                exit 2
            }
            seen_common=yes
            ;;
        libexec/harness-codex-resilient)
            [ "$seen_resilient" = no ] || {
                echo "harness: Codex runtime release manifest has a duplicate path" >&2
                exit 2
            }
            seen_resilient=yes
            ;;
        libexec/harness-codex-runtime-launch)
            [ "$seen_launcher" = no ] || {
                echo "harness: Codex runtime release manifest has a duplicate path" >&2
                exit 2
            }
            seen_launcher=yes
            ;;
        libexec/harness-codex-thread-recovery)
            [ "$seen_recovery" = no ] || {
                echo "harness: Codex runtime release manifest has a duplicate path" >&2
                exit 2
            }
            seen_recovery=yes
            ;;
        libexec/harness_codex_targets.py)
            [ "$seen_targets" = no ] || {
                echo "harness: Codex runtime release manifest has a duplicate path" >&2
                exit 2
            }
            seen_targets=yes
            ;;
        profiles/codex-runtime-release.tsv)
            [ "$seen_release_profile" = no ] || {
                echo "harness: Codex runtime release manifest has a duplicate path" >&2
                exit 2
            }
            seen_release_profile=yes
            ;;
        profiles/codex-session-targets.tsv)
            [ "$seen_targets_profile" = no ] || {
                echo "harness: Codex runtime release manifest has a duplicate path" >&2
                exit 2
            }
            seen_targets_profile=yes
            ;;
        *)
            echo "harness: Codex runtime release path is outside its closed manifest" >&2
            exit 2
            ;;
    esac
    case "$path" in
        *..*|*//*|*'
'*|*''*)
            echo "harness: Codex runtime release path is malformed" >&2
            exit 2
            ;;
    esac
    case "$mode" in 444|555) ;; *)
        echo "harness: Codex runtime release mode is malformed" >&2
        exit 2
        ;;
    esac
    manifest_count=$((manifest_count + 1))
done <"$manifest_tmp"
[ "$manifest_count" -eq 7 ] &&
    [ "$seen_common:$seen_resilient:$seen_launcher:$seen_recovery" = \
        yes:yes:yes:yes ] &&
    [ "$seen_targets:$seen_release_profile:$seen_targets_profile" = \
        yes:yes:yes ] || {
    echo "harness: Codex runtime release manifest is incomplete" >&2
    exit 2
}

resolve_payload_objects() {
    set --
    while IFS='	' read -r path mode extra; do
        case "$path" in ''|'#'*) continue ;; esac
        set -- "$@" "$path"
    done <"$manifest_tmp"
    [ "$#" -eq "$manifest_count" ] || {
        echo "harness: Codex runtime payload query is incomplete" >&2
        exit 2
    }
    git -C "$source_root" ls-tree -r "$commit" -- "$@" \
        >"$batch_tmp" 2>/dev/null || {
        echo "harness: committed Codex runtime objects are unavailable" >&2
        exit 2
    }
    awk -F '	' '
        NR == FNR {
            if ($1 == "" || substr($1, 1, 1) == "#")
                next
            order[++count] = $1
            release_mode[$1] = $2
            allowed[$1] = 1
            next
        }
        {
            fields = split($1, metadata, " ")
            path = $2
            if (NF != 2 || fields != 3 || metadata[2] != "blob" ||
                (metadata[1] != "100644" && metadata[1] != "100755") ||
                path == "" || !(path in allowed) || seen[path]++)
                exit 1
            object = metadata[3]
            if (object !~ /^[0-9a-f]+$/ ||
                (length(object) != 40 && length(object) != 64))
                exit 1
            object_id[path] = object
            resolved++
        }
        END {
            if (resolved != count)
                exit 1
            for (i = 1; i <= count; i++) {
                path = order[i]
                if (!(path in object_id))
                    exit 1
                print path "	" release_mode[path] "	" object_id[path]
            }
        }
    ' "$manifest_tmp" "$batch_tmp" >"$payload_tmp" || {
        echo "harness: committed Codex runtime object set is incomplete" >&2
        exit 2
    }
}
resolve_payload_objects

payload_count=$(wc -l <"$payload_tmp" | tr -d ' ')
[ "$payload_count" -eq "$manifest_count" ] || {
    echo "harness: Codex runtime payload identity is incomplete" >&2
    exit 2
}
payload_id=$(git -C "$source_root" hash-object "$payload_tmp" 2>/dev/null) || {
    echo "harness: Codex runtime payload identity is unavailable" >&2
    exit 2
}
case "$payload_id" in
    *[!0-9a-f]*|'')
        echo "harness: Codex runtime payload identity is malformed" >&2
        exit 2
        ;;
esac
case ${#payload_id} in
    40|64) ;;
    *)
        echo "harness: Codex runtime payload identity is malformed" >&2
        exit 2
        ;;
esac
release_dir=$target_release_parent/$payload_id
marker=$release_dir/$marker_name
marker_source_commit=

validate_release() {
    [ -d "$release_dir" ] && [ ! -L "$release_dir" ] &&
        [ "$(path_owner "$release_dir")" = "$uid" ] &&
        [ "$(path_mode "$release_dir")" = 500 ] || return 1
    for release_component in "$release_dir/libexec" "$release_dir/profiles"; do
        [ -d "$release_component" ] && [ ! -L "$release_component" ] &&
            [ "$(path_owner "$release_component")" = "$uid" ] &&
            [ "$(path_mode "$release_component")" = 500 ] || return 1
    done
    [ -f "$marker" ] && [ ! -L "$marker" ] &&
        [ "$(path_owner "$marker")" = "$uid" ] &&
        [ "$(path_mode "$marker")" = 400 ] &&
        [ "$(path_links "$marker")" = 1 ] || return 1
    [ "$(sed -n '1p' "$marker")" = "schema=2" ] &&
        [ "$(sed -n '2p' "$marker")" = "payload=$payload_id" ] &&
        [ "$(sed -n '4p' "$marker")" = "target=$release_target" ] &&
        [ "$(wc -l <"$marker" | tr -d ' ')" = 4 ] || return 1
    marker_source_commit=$(
        sed -n '3s/^source_commit=//p' "$marker"
    )
    case "$marker_source_commit" in
        *[!0-9a-f]*|'') return 1 ;;
    esac
    case ${#marker_source_commit} in 40|64) ;; *) return 1 ;; esac
    validated=0
    set --
    while IFS='	' read -r path mode expected extra; do
        [ -z "${extra:-}" ] || return 1
        candidate=$release_dir/$path
        [ -f "$candidate" ] && [ ! -L "$candidate" ] &&
            [ "$(path_owner "$candidate")" = "$uid" ] &&
            [ "$(path_mode "$candidate")" = "$mode" ] &&
            [ "$(path_links "$candidate")" = 1 ] || return 1
        set -- "$@" "$candidate"
        validated=$((validated + 1))
    done <"$payload_tmp"
    [ "$validated" -eq "$manifest_count" ] || return 1
    git -C "$source_root" hash-object -- "$@" >"$batch_tmp" 2>/dev/null ||
        return 1
    validation_ok=yes
    exec 3<"$batch_tmp"
    while IFS='	' read -r path mode expected extra; do
        if ! IFS= read -r actual <&3 || [ "$actual" != "$expected" ]; then
            validation_ok=no
            break
        fi
    done <"$payload_tmp"
    if [ "$validation_ok" = yes ] && IFS= read -r actual <&3; then
        validation_ok=no
    fi
    exec 3<&-
    [ "$validation_ok" = yes ]
}

validate_release_lock_dir() {
    [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ] &&
        [ "$(path_owner "$lock_dir")" = "$uid" ] &&
        [ "$(path_mode "$lock_dir")" = 700 ] || {
        echo "harness: Codex runtime release lock is unsafe" >&2
        exit 2
    }
}

validate_release_lock() {
    validate_release_lock_dir
    [ -f "$lock_dir/pid" ] && [ ! -L "$lock_dir/pid" ] &&
        [ "$(path_owner "$lock_dir/pid")" = "$uid" ] &&
        [ "$(path_mode "$lock_dir/pid")" = 600 ] &&
        [ "$(path_links "$lock_dir/pid")" = 1 ] || {
        echo "harness: Codex runtime release lock is unsafe" >&2
        exit 2
    }
}

if [ -e "$release_dir" ] || [ -L "$release_dir" ]; then
    validate_release || {
        echo "harness: existing Codex runtime release is invalid" >&2
        exit 2
    }
else
    lock_dir=$target_release_parent/.$payload_id.lock
    old_umask=$(umask)
    umask 077
    if mkdir "$lock_dir" 2>/dev/null; then
        lock_owned=yes
    else
        umask "$old_umask"
        if [ -e "$release_dir" ] || [ -L "$release_dir" ]; then
            validate_release || {
                echo "harness: concurrent Codex runtime release is invalid" >&2
                exit 2
            }
        elif [ ! -e "$lock_dir" ] && [ ! -L "$lock_dir" ]; then
            umask 077
            if mkdir "$lock_dir" 2>/dev/null; then
                lock_owned=yes
            fi
            umask "$old_umask"
        else
            validate_release_lock_dir
            lock_ready_count=0
            while [ ! -f "$lock_dir/pid" ] &&
                [ "$lock_ready_count" -lt 20 ]; do
                sleep 0.05
                lock_ready_count=$((lock_ready_count + 1))
            done
            if [ ! -f "$lock_dir/pid" ]; then
                rmdir "$lock_dir" || {
                    echo "harness: incomplete Codex runtime release lock changed" >&2
                    exit 2
                }
                umask 077
                if mkdir "$lock_dir" 2>/dev/null; then
                    lock_owned=yes
                fi
                umask "$old_umask"
            fi
        fi
    fi
    if [ "$lock_owned" != yes ] &&
        [ ! -e "$release_dir" ] && [ ! -L "$release_dir" ]; then
        validate_release_lock
        lock_pid=$(sed -n '1p' "$lock_dir/pid")
        case "$lock_pid" in
            ''|*[!0-9]*)
                echo "harness: Codex runtime release lock is malformed" >&2
                exit 2
                ;;
        esac
        if ! kill -0 "$lock_pid" 2>/dev/null; then
            unlink "$lock_dir/pid"
            rmdir "$lock_dir" || {
                echo "harness: stale Codex runtime release lock changed" >&2
                exit 2
            }
            umask 077
            if mkdir "$lock_dir" 2>/dev/null; then
                lock_owned=yes
            fi
            umask "$old_umask"
        fi
    fi

    if [ "$lock_owned" = yes ]; then
        old_umask=$(umask)
        umask 077
        printf '%s\n' "$$" >"$lock_dir/pid"
        umask "$old_umask"
        chmod 600 "$lock_dir/pid"
        stage=$(mktemp -d "$target_release_parent/.stage.$payload_id.XXXXXX") || {
            echo "harness: Codex runtime release staging cannot be allocated" >&2
            exit 2
        }
        chmod 700 "$stage"
        mkdir "$stage/libexec" "$stage/profiles"
        chmod 700 "$stage/libexec" "$stage/profiles"
        while IFS='	' read -r path mode extra; do
            case "$path" in ''|'#'*) continue ;; esac
            git -C "$source_root" show "$commit:$path" >"$stage/$path" 2>/dev/null || {
                echo "harness: committed Codex runtime file is unavailable: $path" >&2
                exit 2
            }
            chmod "$mode" "$stage/$path"
        done <"$manifest_tmp"
        {
            printf 'schema=2\n'
            printf 'payload=%s\n' "$payload_id"
            printf 'source_commit=%s\n' "$commit"
            printf 'target=%s\n' "$release_target"
        } >"$stage/$marker_name"
        chmod 400 "$stage/$marker_name"
        chmod 500 "$stage/libexec" "$stage/profiles" "$stage"
        mv "$stage" "$release_dir"
        stage=
        validate_release || {
            echo "harness: created Codex runtime release failed validation" >&2
            exit 2
        }
    else
        wait_count=0
        while [ "$wait_count" -lt 30 ]; do
            if [ -e "$release_dir" ] || [ -L "$release_dir" ]; then
                break
            fi
            sleep 1
            wait_count=$((wait_count + 1))
        done
        [ -d "$release_dir" ] || {
            echo "harness: Codex runtime release is locked" >&2
            exit 2
        }
        validate_release || {
            echo "harness: concurrent Codex runtime release is invalid" >&2
            exit 2
        }
    fi
fi

HARNESS_CONTROL_ROOT=$release_dir
HARNESS_CODEX_RELEASE_COMMIT=$marker_source_commit
HARNESS_CODEX_RELEASE_PAYLOAD=$payload_id
HARNESS_CODEX_RELEASE_TARGET=$release_target
export HARNESS_CONTROL_ROOT HARNESS_TARGET_ROOT HARNESS_CODEX_RELEASE_COMMIT
export HARNESS_CODEX_RELEASE_PAYLOAD HARNESS_CODEX_RELEASE_TARGET
unset HARNESS_ROOT
if [ "$lock_owned" = yes ]; then
    unlink "$lock_dir/pid"
    rmdir "$lock_dir"
    lock_owned=no
fi
unlink "$manifest_tmp"
manifest_tmp=
unlink "$payload_tmp"
payload_tmp=
unlink "$batch_tmp"
batch_tmp=
trap - EXIT HUP INT TERM
exec "$release_dir/libexec/harness-codex-resilient" "$@"
