#!/bin/sh
set -eu

SELF_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
CONTROL_ROOT=$(CDPATH='' cd -- "$SELF_DIR/.." && pwd -P)
DEFAULT_PERSONAL_ROOT=/mnt/nfs-03/safe/Users/rioyokota/projects/personal

usage() {
    cat >&2 <<'EOF'
Usage:
  harness personal-agent --status
  harness personal-agent --profile-bootstrap
  harness personal-agent --privacy-attest --provider openai|anthropic --value off
  harness personal-agent --authorize --domain email|calendar --client-file PATH \
    [--browser-host aist|home|office|riken]
  harness personal-agent --authorize --domain calendar-write --client-file PATH \
    [--browser-host aist|home|office|riken]
  harness personal-agent --calendar-write --task ID
  harness personal-agent --run --client codex|claude --task ID \
    --domain local|email|calendar

The run prompt must arrive on standard input. Email, calendar, and
research-budget domains remain blocked until their Personal-only connector
profiles pass the durable readiness gate.
EOF
}

mode=
client=
task=
domain=
provider=
attested_value=
client_file=
browser_host=
while [ "$#" -gt 0 ]; do
    case $1 in
        --status) mode=status; shift ;;
        --profile-bootstrap) mode=profile-bootstrap; shift ;;
        --privacy-attest) mode=privacy-attest; shift ;;
        --authorize) mode=authorize; shift ;;
        --calendar-write) mode=calendar-write; shift ;;
        --run) mode=run; shift ;;
        --client)
            [ "$#" -ge 2 ] || { usage; exit 2; }
            client=$2
            shift 2
            ;;
        --task)
            [ "$#" -ge 2 ] || { usage; exit 2; }
            task=$2
            shift 2
            ;;
        --domain)
            [ "$#" -ge 2 ] || { usage; exit 2; }
            domain=$2
            shift 2
            ;;
        --provider)
            [ "$#" -ge 2 ] || { usage; exit 2; }
            provider=$2
            shift 2
            ;;
        --value)
            [ "$#" -ge 2 ] || { usage; exit 2; }
            attested_value=$2
            shift 2
            ;;
        --client-file)
            [ "$#" -ge 2 ] || { usage; exit 2; }
            client_file=$2
            shift 2
            ;;
        --browser-host)
            [ "$#" -ge 2 ] || { usage; exit 2; }
            browser_host=$2
            shift 2
            ;;
        -h|--help) usage; exit 0 ;;
        *) usage; exit 2 ;;
    esac
done

case $mode in
    status|profile-bootstrap|privacy-attest|authorize|calendar-write|run) ;;
    *) usage; exit 2 ;;
esac

if [ "${HARNESS_TESTING:-0}" = 1 ]; then
    personal_root=${HARNESS_TEST_PERSONAL_ROOT:-$DEFAULT_PERSONAL_ROOT}
    runtime_base=${HARNESS_TEST_RUNTIME_ROOT:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}}
    profile_root=${HARNESS_TEST_PROFILE_ROOT:-$HOME/.local/state/harness-personal-agent/google}
else
    personal_root=$DEFAULT_PERSONAL_ROOT
    runtime_base=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
    profile_root=$HOME/.local/state/harness-personal-agent/google
fi

fail() {
    printf 'PERSONAL_AGENT status=failed reason=%s\n' "$1" >&2
    exit 2
}

case "$personal_root:$runtime_base:$profile_root" in
    /*:/*:/*) ;;
    *) fail non-absolute-path ;;
esac

invoking_root=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)
[ -n "$invoking_root" ] || fail outside-harness
invoking_root=$(CDPATH='' cd -- "$invoking_root" 2>/dev/null && pwd -P) ||
    fail unavailable-harness
[ "$invoking_root" = "$CONTROL_ROOT" ] || fail outside-harness

[ -d "$personal_root" ] && [ ! -L "$personal_root" ] ||
    fail personal-root-type
personal_root=$(CDPATH='' cd -- "$personal_root" 2>/dev/null && pwd -P) ||
    fail personal-root-unavailable
if [ "${HARNESS_TESTING:-0}" != 1 ]; then
    [ "$personal_root" = "$DEFAULT_PERSONAL_ROOT" ] ||
        fail personal-root-identity
fi
[ "$(stat -c %u "$personal_root")" = "$(id -u)" ] ||
    fail personal-root-owner
[ "$(stat -c %a "$personal_root")" = 700 ] ||
    fail personal-root-mode
[ "$(git -C "$personal_root" rev-parse --show-toplevel 2>/dev/null)" = \
    "$personal_root" ] || fail personal-git-root

for required in AGENTS.md CLAUDE.md TODO.md .codex/config.toml \
    .claude/settings.json config/connector-readiness.tsv \
    config/empty-mcp.json config/personal-mcp.json \
    bin/personal-google-auth bin/personal-google-mcp \
    bin/personal-google-calendar-write; do
    [ -f "$personal_root/$required" ] &&
        [ ! -L "$personal_root/$required" ] ||
        fail "personal-contract-$required"
    [ "$(stat -c %u "$personal_root/$required")" = "$(id -u)" ] ||
        fail "personal-owner-$required"
    [ "$(stat -c %h "$personal_root/$required")" = 1 ] ||
        fail "personal-links-$required"
done

[ -d "$runtime_base" ] && [ ! -L "$runtime_base" ] ||
    fail runtime-base-type
[ "$(stat -c %u "$runtime_base")" = "$(id -u)" ] ||
    fail runtime-base-owner
runtime_dir=$runtime_base/harness-personal-agent
if [ ! -e "$runtime_dir" ]; then
    mkdir -m 700 "$runtime_dir"
fi
[ -d "$runtime_dir" ] && [ ! -L "$runtime_dir" ] ||
    fail runtime-directory-type
[ "$(stat -c %u "$runtime_dir")" = "$(id -u)" ] &&
    [ "$(stat -c %a "$runtime_dir")" = 700 ] ||
    fail runtime-directory-permissions

lock_file=$runtime_dir/operation.lock
umask 077
exec 9>"$lock_file"
chmod 600 "$lock_file"
if ! flock -n 9; then
    if [ "$mode" = status ]; then
        printf 'PERSONAL_AGENT status=ready root=ready lock=busy profile=unknown privacy=unknown connectors=unknown managed_target=false\n'
        exit 0
    fi
    fail operation-locked
fi

profile_state=absent
privacy_state=blocked
privacy_file_state=absent
validate_profile() {
    if [ -e "$profile_root" ] || [ -L "$profile_root" ]; then
        profile_state=invalid
    fi
    [ -d "$profile_root" ] && [ ! -L "$profile_root" ] ||
        return 1
    [ "$(stat -c %u "$profile_root")" = "$(id -u)" ] &&
        [ "$(stat -c %a "$profile_root")" = 700 ] ||
        return 1
    profile_state=ready
    privacy_file=$profile_root/privacy.tsv
    if [ -e "$privacy_file" ] || [ -L "$privacy_file" ]; then
        privacy_file_state=invalid
        if [ -f "$privacy_file" ] && [ ! -L "$privacy_file" ] &&
            [ "$(stat -c %u "$privacy_file")" = "$(id -u)" ] &&
            [ "$(stat -c %a "$privacy_file")" = 600 ] &&
            [ "$(stat -c %h "$privacy_file")" = 1 ]; then
            if awk -F '\t' '
                ($1 == "openai" || $1 == "anthropic") && $2 == "off" &&
                    !seen[$1]++ { count++; next }
                { invalid++ }
                END { exit !(!invalid && count == 2) }
            ' "$privacy_file" >/dev/null 2>&1; then
                privacy_file_state=complete
                privacy_state=ready
            elif awk -F '\t' '
                ($1 == "openai" || $1 == "anthropic") && $2 == "off" &&
                    !seen[$1]++ { count++; next }
                { invalid++ }
                END { exit !(!invalid && count == 1) }
            ' "$privacy_file" >/dev/null 2>&1; then
                privacy_file_state=partial
            fi
        fi
    fi
    return 0
}
validate_profile || true
ready_connector_rows=$(awk -F '\t' '
    ($1 == "codex" || $1 == "claude") &&
        ($2 == "email" || $2 == "calendar") && $3 == "ready" {
        count++
    }
    END { print count + 0 }
' "$personal_root/config/connector-readiness.tsv")
case $ready_connector_rows in
    0) connector_state=blocked ;;
    4) connector_state=ready ;;
    *) connector_state=partial ;;
esac

if [ "$mode" = status ]; then
    printf 'PERSONAL_AGENT status=ready root=ready lock=free profile=%s privacy=%s connectors=%s managed_target=false\n' \
        "$profile_state" "$privacy_state" "$connector_state"
    exit 0
fi

if [ "$mode" = profile-bootstrap ]; then
    if [ "$profile_state" = absent ]; then
        profile_parent=${profile_root%/*}
        if [ ! -e "$profile_parent" ] && [ ! -L "$profile_parent" ]; then
            profile_grandparent=${profile_parent%/*}
            [ -d "$profile_grandparent" ] &&
                [ ! -L "$profile_grandparent" ] ||
                fail profile-parent-unavailable
            [ "$(stat -c %u "$profile_grandparent")" = "$(id -u)" ] ||
                fail profile-parent-owner
            mkdir -m 700 "$profile_parent"
        fi
        [ -d "$profile_parent" ] && [ ! -L "$profile_parent" ] ||
            fail profile-parent-type
        [ "$(stat -c %u "$profile_parent")" = "$(id -u)" ] ||
            fail profile-parent-owner
        [ "$(stat -c %a "$profile_parent")" = 700 ] ||
            fail profile-parent-permissions
        mkdir -m 700 "$profile_root"
        validate_profile || fail profile-bootstrap-failed
    elif [ "$profile_state" != ready ]; then
        fail profile-invalid
    fi
    printf 'PERSONAL_AGENT status=complete action=profile-bootstrap profile=ready privacy=%s\n' \
        "$privacy_state"
    exit 0
fi

if [ "$mode" = privacy-attest ]; then
    [ "$profile_state" = ready ] || fail profile-not-ready
    [ "$privacy_file_state" != invalid ] || fail privacy-file-invalid
    case $provider in openai|anthropic) ;; *) fail invalid-provider ;; esac
    [ "$attested_value" = off ] || fail invalid-attestation
    privacy_file=$profile_root/privacy.tsv
    privacy_tmp=$profile_root/privacy.$$.tmp
    {
        if [ -f "$privacy_file" ] && [ ! -L "$privacy_file" ] &&
            [ "$(stat -c %u "$privacy_file")" = "$(id -u)" ] &&
            [ "$(stat -c %a "$privacy_file")" = 600 ] &&
            [ "$(stat -c %h "$privacy_file")" = 1 ]; then
            awk -F '\t' -v provider="$provider" '
                ($1 == "openai" || $1 == "anthropic") &&
                    $2 == "off" && $1 != provider {
                    print $1 "\t" $2
                }
            ' "$privacy_file"
        fi
        printf '%s\toff\n' "$provider"
    } | LC_ALL=C sort >"$privacy_tmp"
    chmod 600 "$privacy_tmp"
    mv "$privacy_tmp" "$privacy_file"
    validate_profile || fail privacy-attestation-failed
    printf 'PERSONAL_AGENT status=complete action=privacy-attest provider=%s value=off privacy=%s\n' \
        "$provider" "$privacy_state"
    exit 0
fi

if [ "$mode" = authorize ]; then
    [ "$profile_state" = ready ] || fail profile-not-ready
    [ "$privacy_state" = ready ] || fail privacy-not-ready
    case $domain in email|calendar|calendar-write) ;; *) fail invalid-domain ;; esac
    [ -n "$client_file" ] || fail oauth-client-path-missing
    case $client_file in /*) ;; *) fail oauth-client-path-non-absolute ;; esac
    if [ -z "$browser_host" ]; then
        exec "$personal_root/bin/personal-google-auth" \
            --profile "$profile_root" --domain "$domain" \
            --client-file "$client_file"
    fi
    case $browser_host in
        aist|home|office|riken) ;;
        *) fail oauth-browser-host-invalid ;;
    esac
    browser_helper=$CONTROL_ROOT/libexec/harness-oauth-browser-open
    [ -f "$browser_helper" ] && [ ! -L "$browser_helper" ] &&
        [ -x "$browser_helper" ] || fail oauth-browser-helper-invalid
    [ "$(stat -c %u "$browser_helper")" = "$(id -u)" ] &&
        [ "$(stat -c %h "$browser_helper")" = 1 ] ||
        fail oauth-browser-helper-invalid
    callback_port=53682
    ssh_bin=ssh
    if [ "${HARNESS_TESTING:-0}" = 1 ]; then
        callback_port=${HARNESS_TEST_OAUTH_CALLBACK_PORT:-$callback_port}
        ssh_bin=${HARNESS_TEST_SSH:-$ssh_bin}
    else
        [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ] &&
            [ "$(stat -c %u "$SSH_AUTH_SOCK")" = "$(id -u)" ] ||
            fail ssh-agent-unavailable
    fi
    case $callback_port in
        ''|*[!0-9]*) fail oauth-callback-port-invalid ;;
    esac
    [ "$callback_port" -ge 1024 ] && [ "$callback_port" -le 65535 ] ||
        fail oauth-callback-port-invalid
    python3 - "$callback_port" <<'PY' || fail oauth-callback-port-unavailable
import socket
import sys

with socket.socket() as listener:
    listener.bind(("127.0.0.1", int(sys.argv[1])))
PY
    reverse_forward="127.0.0.1:$callback_port:127.0.0.1:$callback_port"
    "$ssh_bin" -x -O forward -o ExitOnForwardFailure=yes \
        -R "$reverse_forward" "$browser_host" >/dev/null 2>&1 ||
        fail oauth-tunnel-failed
    # shellcheck disable=SC2329
    cleanup_oauth_tunnel() {
        status=$?
        trap - EXIT HUP INT TERM
        "$ssh_bin" -x -O cancel -R "$reverse_forward" "$browser_host" \
            >/dev/null 2>&1 || true
        exit "$status"
    }
    trap cleanup_oauth_tunnel EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    HARNESS_OAUTH_BROWSER_HOST=$browser_host \
        "$personal_root/bin/personal-google-auth" \
            --profile "$profile_root" --domain "$domain" \
            --client-file "$client_file" \
            --callback-port "$callback_port" \
            --browser-helper "$browser_helper"
    exit $?
fi

case $task in
    [A-Za-z0-9]*)
        case $task in *[!A-Za-z0-9._-]*)
            fail invalid-task
        esac
        [ "${#task}" -le 64 ] || fail invalid-task
        ;;
    *) fail invalid-task ;;
esac
if [ "$mode" = calendar-write ]; then
    client=native
    domain=calendar-write
    calendar_ready_rows=$(awk -F '\t' '
        ($1 == "codex" || $1 == "claude") &&
            $2 == "calendar" && $3 == "ready" { count++ }
        END { print count + 0 }
    ' "$personal_root/config/connector-readiness.tsv")
    [ "$calendar_ready_rows" -eq 2 ] || fail connector-not-ready
    [ "$profile_state" = ready ] || fail profile-not-ready
    [ "$privacy_state" = ready ] || fail privacy-not-ready
else
    case $client in codex|claude) ;; *) fail invalid-client ;; esac
    case $domain in
        local) ;;
        email|calendar)
            readiness=$(awk -F '\t' -v client="$client" -v domain="$domain" '
                $1 == client && $2 == domain { print $3; count++ }
                END { if (count != 1) exit 1 }
            ' "$personal_root/config/connector-readiness.tsv") ||
                fail connector-readiness-ambiguous
            [ "$readiness" = ready ] || fail connector-not-ready
            [ "$profile_state" = ready ] || fail profile-not-ready
            [ "$privacy_state" = ready ] || fail privacy-not-ready
            ;;
        research-budget) fail connector-not-ready ;;
        *) fail invalid-domain ;;
    esac
fi
[ ! -t 0 ] || fail prompt-must-use-stdin

receipt=$runtime_dir/last.receipt
receipt_tmp=$runtime_dir/receipt.$$.tmp
write_receipt() {
    receipt_state=$1
    receipt_result=$2
    {
        printf 'schema=1\n'
        printf 'state=%s\n' "$receipt_state"
        printf 'task=%s\n' "$task"
        printf 'client=%s\n' "$client"
        printf 'domain=%s\n' "$domain"
        printf 'result=%s\n' "$receipt_result"
        date -u '+time=%Y-%m-%dT%H:%M:%SZ'
    } >"$receipt_tmp"
    chmod 600 "$receipt_tmp"
    mv "$receipt_tmp" "$receipt"
}

native_codex=$HOME/.local/bin/codex
native_claude=$(command -v claude 2>/dev/null || true)
if [ "${HARNESS_TESTING:-0}" = 1 ]; then
    native_codex=${HARNESS_TEST_NATIVE_CODEX:-$native_codex}
    native_claude=${HARNESS_TEST_NATIVE_CLAUDE:-$native_claude}
fi
if [ "$mode" = run ]; then
    if [ "$client" = codex ]; then
        [ -x "$native_codex" ] || fail codex-unavailable
    else
        [ -n "$native_claude" ] && [ -x "$native_claude" ] ||
            fail claude-unavailable
    fi
fi
write_receipt running pending

set +e
if [ "$mode" = calendar-write ]; then
    (
        CDPATH='' cd -- "$personal_root" || exit 2
        harness_variables=$(env | sed -n \
            's/^\(HARNESS_[A-Za-z0-9_]*\)=.*/\1/p')
        for harness_variable in $harness_variables; do
            unset "$harness_variable"
        done
        personal_google_variables=$(env | sed -n \
            's/^\(PERSONAL_GOOGLE_[A-Za-z0-9_]*\)=.*/\1/p')
        for personal_google_variable in $personal_google_variables; do
            unset "$personal_google_variable"
        done
        PERSONAL_GOOGLE_PROFILE=$profile_root \
            "$personal_root/bin/personal-google-calendar-write"
    )
    result=$?
elif [ "$client" = codex ]; then
    (
        CDPATH='' cd -- "$personal_root" || exit 2
        harness_variables=$(env | sed -n \
            's/^\(HARNESS_[A-Za-z0-9_]*\)=.*/\1/p')
        for harness_variable in $harness_variables; do
            unset "$harness_variable"
        done
        personal_google_variables=$(env | sed -n \
            's/^\(PERSONAL_GOOGLE_[A-Za-z0-9_]*\)=.*/\1/p')
        for personal_google_variable in $personal_google_variables; do
            unset "$personal_google_variable"
        done
        set -- exec --ephemeral --ignore-user-config --strict-config \
            -C "$personal_root" --model gpt-5.6-sol \
            -c 'model_reasoning_effort="high"' \
            -c 'approval_policy={ granular = { sandbox_approval = false, rules = false, mcp_elicitations = true, request_permissions = false, skill_approval = false } }' \
            -c 'history.persistence="none"' \
            -c 'memories.generate_memories=false' \
            -c 'memories.use_memories=false' \
            -c 'feedback.enabled=false' \
            -c 'tool_suggest.discoverables=[]' \
            -c 'web_search="disabled"'
        if [ "$domain" != local ]; then
            set -- "$@" \
                -c 'mcp_servers.personal-google-readonly.enabled=true' \
                -c "mcp_servers.personal-google-readonly.env={ PERSONAL_GOOGLE_PROFILE=\"$profile_root\" }"
        fi
        set -- "$@" --sandbox danger-full-access -
        if [ "$domain" = local ]; then
            "$native_codex" "$@"
        else
            PERSONAL_GOOGLE_ALLOWED_DOMAIN="$domain" "$native_codex" "$@"
        fi
    )
    result=$?
else
    (
        CDPATH='' cd -- "$personal_root" || exit 2
        harness_variables=$(env | sed -n \
            's/^\(HARNESS_[A-Za-z0-9_]*\)=.*/\1/p')
        for harness_variable in $harness_variables; do
            unset "$harness_variable"
        done
        personal_google_variables=$(env | sed -n \
            's/^\(PERSONAL_GOOGLE_[A-Za-z0-9_]*\)=.*/\1/p')
        for personal_google_variable in $personal_google_variables; do
            unset "$personal_google_variable"
        done
        if [ "$domain" = local ]; then
            mcp_manifest=$personal_root/config/empty-mcp.json
        else
            mcp_manifest=$personal_root/config/personal-mcp.json
        fi
        set -- --print --no-session-persistence --no-chrome \
            --setting-sources project \
            --settings "$personal_root/.claude/settings.json" \
            --strict-mcp-config \
            --mcp-config "$mcp_manifest" \
            --model fable --effort high --fallback-model opus \
            --permission-mode dontAsk \
            --allowedTools Read Grep Glob Edit Write 'Bash(git *)' \
                'Bash(./bin/validate)' 'Bash(harness *)'
        if [ "$domain" = email ]; then
            set -- "$@" \
                'mcp__personal-google-readonly__personal_google_status' \
                'mcp__personal-google-readonly__personal_gmail_search' \
                'mcp__personal-google-readonly__personal_gmail_thread'
        elif [ "$domain" = calendar ]; then
            set -- "$@" \
                'mcp__personal-google-readonly__personal_google_status' \
                'mcp__personal-google-readonly__personal_calendar_events'
        fi
        if [ "$domain" = local ]; then
            CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 \
            CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
            DISABLE_TELEMETRY=1 \
            DISABLE_ERROR_REPORTING=1 \
            DISABLE_BUG_COMMAND=1 \
            CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1 \
            "$native_claude" "$@"
        else
            PERSONAL_GOOGLE_ALLOWED_DOMAIN="$domain" \
            CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 \
            CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
            DISABLE_TELEMETRY=1 \
            DISABLE_ERROR_REPORTING=1 \
            DISABLE_BUG_COMMAND=1 \
            CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1 \
            "$native_claude" "$@"
        fi
    )
    result=$?
fi
set -e

if [ "$result" -eq 0 ]; then
    write_receipt complete success
    printf 'PERSONAL_AGENT_RECEIPT status=complete task=%s client=%s domain=%s result=success\n' \
        "$task" "$client" "$domain" >&2
else
    write_receipt complete "exit-$result"
    if [ "$mode" = calendar-write ] && [ "$result" -eq 2 ]; then
        retry=safe-after-revalidation
    else
        retry=forbidden-until-reconciled
    fi
    printf 'PERSONAL_AGENT_RECEIPT status=complete task=%s client=%s domain=%s result=exit-%s retry=%s\n' \
        "$task" "$client" "$domain" "$result" "$retry" >&2
fi
exit "$result"
