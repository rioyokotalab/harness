#!/bin/sh
set -eu

SELF_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
derived_control_root=$(CDPATH='' cd -- "$SELF_DIR/.." && pwd)
release_active=no
release_marker=$derived_control_root/.codex-runtime-release
if [ -e "$release_marker" ] || [ -L "$release_marker" ]; then
    [ -f "$release_marker" ] && [ ! -L "$release_marker" ] &&
        [ "${HARNESS_CONTROL_ROOT:-}" = "$derived_control_root" ] &&
        [ -n "${HARNESS_CODEX_RELEASE_COMMIT:-}" ] &&
        [ -n "${HARNESS_CODEX_RELEASE_PAYLOAD:-}" ] &&
        [ -n "${HARNESS_CODEX_RELEASE_TARGET:-}" ] &&
        [ "${derived_control_root##*/}" = \
            "$HARNESS_CODEX_RELEASE_PAYLOAD" ] &&
        [ "$(sed -n '1p' "$release_marker")" = "schema=2" ] &&
        [ "$(sed -n '2p' "$release_marker")" = \
            "payload=$HARNESS_CODEX_RELEASE_PAYLOAD" ] &&
        [ "$(sed -n '3p' "$release_marker")" = \
            "source_commit=$HARNESS_CODEX_RELEASE_COMMIT" ] &&
        [ "$(sed -n '4p' "$release_marker")" = \
            "target=$HARNESS_CODEX_RELEASE_TARGET" ] &&
        [ "$(wc -l <"$release_marker" | tr -d ' ')" = 4 ] || {
        echo "harness: Codex runtime release marker is invalid" >&2
        exit 2
    }
    release_active=yes
    HARNESS_CONTROL_ROOT=$derived_control_root
    case ${HARNESS_TARGET_ROOT:-} in
        /*) ;;
        *)
            echo "harness: released Codex target root is unavailable" >&2
            exit 2
            ;;
    esac
else
    HARNESS_CONTROL_ROOT=$derived_control_root
    HARNESS_TARGET_ROOT=$derived_control_root
fi
export HARNESS_CONTROL_ROOT HARNESS_TARGET_ROOT
unset HARNESS_ROOT
. "$SELF_DIR/harness-common"

usage() {
    cat >&2 <<'EOF'
Usage:
  harness codex-resilient --plan [--name NAME] [--target TARGET] SELECTOR
  harness codex-resilient --status [--name NAME] [--target TARGET]
  harness codex-resilient --run [--name NAME] [--target TARGET] SELECTOR

Selectors:
  --new             start a new chat, then resume the repository's latest chat
  --last            resume the most recent chat in the current repository
  --session ID      resume one exact saved thread after target-CWD preflight
  --remote-session ID
                    always resume one exact session through --remote unix://

The target-scoped supervisor rejects global `--last-all`; use the direct
`harness-codex` launcher for an intentional unsupervised global resume.
EOF
}

mode=plan
mode_seen=no
name=default
target=
selector=
session_id=
selector_count=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --plan|--status|--run)
            [ "$mode_seen" = no ] || die "Codex resilient mode was specified more than once"
            mode=${1#--}
            mode_seen=yes
            shift
            ;;
        --name)
            [ "$#" -ge 2 ] || die "Codex resilient --name requires a value"
            name=$2
            shift 2
            ;;
        --target)
            [ "$#" -ge 2 ] || die "Codex resilient --target requires a value"
            target=$2
            shift 2
            ;;
        --new)
            selector=new
            selector_count=$((selector_count + 1))
            shift
            ;;
        --last)
            selector=last
            selector_count=$((selector_count + 1))
            shift
            ;;
        --last-all)
            die "Codex resilient --last-all is outside target-scoped supervision"
            ;;
        --session)
            [ "$#" -ge 2 ] || die "Codex resilient --session requires a value"
            selector=explicit
            session_id=$2
            selector_count=$((selector_count + 1))
            shift 2
            ;;
        --remote-session)
            [ "$#" -ge 2 ] ||
                die "Codex resilient --remote-session requires a value"
            selector=remote-explicit
            session_id=$2
            selector_count=$((selector_count + 1))
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage
            exit 2
            ;;
    esac
done

require_safe_id "$name"
if [ "$mode" = status ]; then
    [ "$selector_count" -eq 0 ] ||
        die "Codex resilient status does not accept a selector"
else
    [ "$selector_count" -eq 1 ] ||
        die "Codex resilient requires exactly one selector"
fi
if [ -n "$target" ]; then
    require_safe_id "$target"
    case "$target" in harness|personal|students) ;; *)
        die "Codex resilient target is outside the managed target map"
        ;;
    esac
fi
target_resolver=$HARNESS_CONTROL_ROOT/libexec/harness_codex_targets.py
if [ "$mode" != status ]; then
    [ -x "$target_resolver" ] ||
        die "Codex target resolver is unavailable"
    command -v python3 >/dev/null 2>&1 ||
        die "Codex target resolver requires python3"
    current_repository=$(
        git -C "$PWD" rev-parse --show-toplevel 2>/dev/null
    ) || die "Codex resilient must start from a managed repository"
    current_repository=$(
        CDPATH='' cd -- "$current_repository" 2>/dev/null && pwd -P
    ) || die "Codex resilient repository is unavailable"
    if [ -n "$target" ]; then
        expected_repository=$(
            python3 "$target_resolver" validate-target "$target"
        ) || die "Codex resilient target repository is invalid"
        [ "$current_repository" = "$expected_repository" ] ||
            die "Codex resilient target does not match its repository"
    else
        target=$(
            python3 "$target_resolver" target-for-repository "$current_repository"
        ) || die "Codex resilient repository is outside the managed target map"
    fi
    if [ "$release_active" = yes ] &&
        [ "$target" != "$HARNESS_CODEX_RELEASE_TARGET" ]; then
        die "Codex runtime release target does not match its repository"
    fi
    CDPATH='' cd -- "$current_repository" ||
        die "Codex resilient repository is unavailable"
fi
if [ "$selector" = explicit ] || [ "$selector" = remote-explicit ]; then
    require_safe_id "$session_id"
fi
if [ "$mode" = run ] && [ "${HARNESS_TESTING:-0}" != 1 ]; then
    [ -t 0 ] && [ -t 1 ] && [ -t 2 ] ||
        die "Codex resilient run requires an interactive terminal"
fi
if [ "$mode" = run ] && [ "$release_active" = no ] &&
    { [ "${HARNESS_TESTING:-0}" != 1 ] ||
      [ "${HARNESS_TEST_FORCE_CODEX_RELEASE:-0}" = 1 ]; }; then
    release_builder=$HARNESS_CONTROL_ROOT/libexec/harness-codex-runtime-release
    [ -x "$release_builder" ] ||
        die "Codex runtime release builder is unavailable"
    HARNESS_CODEX_RELEASE_TARGET=$target
    export HARNESS_CODEX_RELEASE_TARGET
    case "$selector" in
        new) set -- --new ;;
        last) set -- --last ;;
        explicit) set -- --session "$session_id" ;;
        remote-explicit) set -- --remote-session "$session_id" ;;
        *) die "Codex resilient internal selector error" ;;
    esac
    exec "$release_builder" --exec-resilient --run \
        --name "$name" --target "$target" "$@"
fi
for required in awk chmod date id kill mkdir mktemp mv rmdir sed sleep stat \
    tr uname unlink wc; do
    command -v "$required" >/dev/null 2>&1 ||
        die "Codex resilient requires command: $required"
done

uid=$(id -u)
platform=$(uname -s)
if [ "${HARNESS_TESTING:-0}" = 1 ] &&
    [ -n "${HARNESS_TEST_PLATFORM:-}" ]; then
    platform=$HARNESS_TEST_PLATFORM
fi
path_owner() {
    case "$platform" in
        Darwin) stat -f '%u' "$1" ;;
        *) stat -c '%u' -- "$1" ;;
    esac
}
path_mode() {
    case "$platform" in
        Darwin) stat -f '%Lp' "$1" ;;
        *) stat -c '%a' -- "$1" ;;
    esac
}
path_links() {
    case "$platform" in
        Darwin) stat -f '%l' "$1" ;;
        *) stat -c '%h' -- "$1" ;;
    esac
}

if [ "${HARNESS_TESTING:-0}" = 1 ] &&
    [ -n "${HARNESS_TEST_RUNTIME_DIR:-}" ]; then
    state_root=$HARNESS_TEST_RUNTIME_DIR
else
    case ${XDG_RUNTIME_DIR:-} in
        /*) runtime_parent=$XDG_RUNTIME_DIR ;;
        *)
            case ${TMPDIR:-/tmp} in
                /*) runtime_parent=${TMPDIR:-/tmp} ;;
                *) die "Codex resilient runtime parent must be absolute" ;;
            esac
            ;;
    esac
    state_root=$runtime_parent/harness-codex-resilient-$uid
fi
case "$state_root" in
    /*) ;;
    *) die "Codex resilient state root must be absolute" ;;
esac

validate_state_root() {
    [ -d "$state_root" ] && [ ! -L "$state_root" ] &&
        [ "$(path_owner "$state_root")" = "$uid" ] ||
        die "Codex resilient state root is unsafe"
    state_root_mode=$(path_mode "$state_root")
    case "$state_root_mode" in
        *[2367][0-7]|*[0-7][2367])
            die "Codex resilient state root is writable by another principal"
            ;;
    esac
}

ensure_state_root() {
    if [ ! -e "$state_root" ] && [ ! -L "$state_root" ]; then
        old_umask=$(umask)
        umask 077
        if ! mkdir "$state_root" 2>/dev/null; then
            umask "$old_umask"
            [ -d "$state_root" ] || die "Codex resilient cannot create its state root"
        else
            umask "$old_umask"
        fi
        chmod 700 "$state_root"
    fi
    validate_state_root
}

state_target=$target
state_dir=
state_file=
lock_dir=
lock_pid=
legacy_state=no
thread_recovery=$HARNESS_CONTROL_ROOT/libexec/harness-codex-thread-recovery
if [ "${HARNESS_TESTING:-0}" = 1 ] &&
    [ -n "${HARNESS_TEST_THREAD_RECOVERY:-}" ]; then
    thread_recovery=$HARNESS_TEST_THREAD_RECOVERY
fi
recovery_name=

set_scoped_paths() {
    state_target=$1
    state_dir=$state_root/$state_target
    state_file=$state_dir/$name.state
    lock_dir=$state_dir/$name.lock
    lock_pid=$lock_dir/pid
    recovery_name=$name
    legacy_state=no
}

set_legacy_paths() {
    state_target=legacy
    state_dir=$state_root
    state_file=$state_root/$name.state
    lock_dir=$state_root/$name.lock
    lock_pid=$lock_dir/pid
    recovery_name=$name
    legacy_state=yes
}

validate_state_dir() {
    [ -d "$state_dir" ] && [ ! -L "$state_dir" ] &&
        [ "$(path_owner "$state_dir")" = "$uid" ] &&
        [ "$(path_mode "$state_dir")" = 700 ] ||
        die "Codex resilient target state directory is unsafe"
}

ensure_state_dir() {
    ensure_state_root
    if [ ! -e "$state_dir" ] && [ ! -L "$state_dir" ]; then
        old_umask=$(umask)
        umask 077
        if ! mkdir "$state_dir" 2>/dev/null; then
            umask "$old_umask"
            [ -d "$state_dir" ] ||
                die "Codex resilient cannot create its target state directory"
        else
            umask "$old_umask"
        fi
        chmod 700 "$state_dir"
    fi
    validate_state_dir
}

validate_lock_dir() {
    [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ] &&
        [ "$(path_owner "$lock_dir")" = "$uid" ] &&
        [ "$(path_mode "$lock_dir")" = 700 ] ||
        die "Codex resilient lock is unsafe"
    [ -f "$lock_pid" ] && [ ! -L "$lock_pid" ] &&
        [ "$(path_owner "$lock_pid")" = "$uid" ] &&
        [ "$(path_mode "$lock_pid")" = 600 ] &&
        [ "$(path_links "$lock_pid")" = 1 ] ||
        die "Codex resilient lock is unsafe"
}

validate_state_file() {
    [ -f "$state_file" ] && [ ! -L "$state_file" ] &&
        [ "$(path_owner "$state_file")" = "$uid" ] &&
        [ "$(path_mode "$state_file")" = 600 ] &&
        [ "$(path_links "$state_file")" = 1 ] ||
        die "Codex resilient state file is unsafe"
}

if [ "$mode" = status ]; then
    if [ ! -e "$state_root" ] && [ ! -L "$state_root" ]; then
        printf 'CODEX_RESILIENT mode=status name=%s target=%s phase=absent\n' \
            "$name" "${target:-unknown}"
        exit 0
    fi
    validate_state_root
    if [ -n "$target" ]; then
        set_scoped_paths "$target"
        if [ -e "$state_dir" ] || [ -L "$state_dir" ]; then
            validate_state_dir
        fi
    else
        scoped_count=0
        scoped_target=
        for candidate_target in harness personal students; do
            candidate_file=$state_root/$candidate_target/$name.state
            if [ -e "$candidate_file" ] || [ -L "$candidate_file" ]; then
                scoped_count=$((scoped_count + 1))
                scoped_target=$candidate_target
            fi
        done
        case "$scoped_count" in
            0) set_legacy_paths ;;
            1)
                set_scoped_paths "$scoped_target"
                validate_state_dir
                ;;
            *) die "Codex resilient status requires --target for this runtime" ;;
        esac
    fi
    if [ ! -e "$state_file" ] && [ ! -L "$state_file" ]; then
        printf 'CODEX_RESILIENT mode=status name=%s target=%s phase=absent\n' \
            "$name" "$state_target"
        exit 0
    fi
    validate_state_file
    schema=$(sed -n 's/^schema=//p' "$state_file")
    stored_name=$(sed -n 's/^name=//p' "$state_file")
    stored_target=$(sed -n 's/^target=//p' "$state_file")
    phase=$(sed -n 's/^phase=//p' "$state_file")
    stored_selector=$(sed -n 's/^selector=//p' "$state_file")
    supervisor_pid=$(sed -n 's/^supervisor_pid=//p' "$state_file")
    attempt=$(sed -n 's/^attempt=//p' "$state_file")
    delay=$(sed -n 's/^delay=//p' "$state_file")
    reason=$(sed -n 's/^reason=//p' "$state_file")
    if [ "$legacy_state" = yes ]; then
        [ "$schema" = 1 ] && [ "$stored_name" = "$name" ] &&
            [ -z "$stored_target" ] &&
            [ "$(wc -l <"$state_file" | tr -d ' ')" = 8 ] ||
            die "Codex resilient state file is malformed"
    else
        [ "$schema" = 2 ] && [ "$stored_name" = "$name" ] &&
            [ "$stored_target" = "$state_target" ] &&
            [ "$(wc -l <"$state_file" | tr -d ' ')" = 9 ] ||
            die "Codex resilient state file is malformed"
    fi
    [ -n "$phase" ] && [ -n "$stored_selector" ] &&
        [ -n "$supervisor_pid" ] &&
        [ -n "$attempt" ] && [ -n "$delay" ] && [ -n "$reason" ] ||
        die "Codex resilient state file is malformed"
    case "$phase:$stored_selector:$supervisor_pid:$attempt:$delay:$reason" in
        *[!A-Za-z0-9._:-]*) die "Codex resilient state file is malformed" ;;
    esac
    case "$phase" in running|backoff|stopped) ;; *)
        die "Codex resilient state file is malformed"
        ;;
    esac
    case "$stored_selector" in new|last|last-all|explicit|remote-explicit) ;; *)
        die "Codex resilient state file is malformed"
        ;;
    esac
    case "$supervisor_pid" in
        ''|*[!0-9]*) die "Codex resilient state file is malformed" ;;
    esac
    case "$attempt:$delay" in
        *[!0-9:]*) die "Codex resilient state file is malformed" ;;
    esac
    case "$reason" in
        active|clean-exit|operator-signal|client-usage|transient-exit|\
        doctor-failed|local-auth|local-config|local-installation|local-state|\
        thread-recovery-blocked)
            ;;
        *) die "Codex resilient state file is malformed" ;;
    esac
    owner_pid=$supervisor_pid
    case "$phase" in
        running|backoff)
            if [ -e "$lock_dir" ] || [ -L "$lock_dir" ]; then
                validate_lock_dir
                state_pid=$(sed -n '1p' "$lock_pid")
                case "$state_pid" in
                    ''|*[!0-9]*) die "Codex resilient lock is malformed" ;;
                esac
                if [ "$state_pid" != "$supervisor_pid" ]; then
                    die "Codex resilient state and lock ownership differ"
                elif ! kill -0 "$state_pid" 2>/dev/null; then
                    phase=stale
                    reason=owner-absent
                    owner_pid=none
                fi
            else
                phase=stale
                reason=owner-absent
                owner_pid=none
            fi
            ;;
        *) owner_pid=none ;;
    esac
    printf 'CODEX_RESILIENT mode=status name=%s target=%s phase=%s selector=%s owner_pid=%s attempt=%s delay=%s reason=%s\n' \
        "$name" "$state_target" "$phase" "$stored_selector" "$owner_pid" \
        "$attempt" "$delay" "$reason"
    if [ "$stored_selector" = remote-explicit ]; then
        case "$thread_recovery" in
            /*) ;;
            *) die "Codex thread recovery helper must be absolute" ;;
        esac
        [ -x "$thread_recovery" ] ||
            die "Codex thread recovery helper is unavailable"
        if [ "$legacy_state" = yes ]; then
            printf 'CODEX_THREAD_RECOVERY name=%s phase=legacy-target-unknown\n' \
                "$recovery_name"
        else
            "$thread_recovery" --status --name "$recovery_name" \
                --target "$state_target"
        fi
    fi
    exit 0
fi

set_scoped_paths "$target"

# Historical bounded-launcher assertion retained for the unchanged login suite:
# launcher=$HARNESS_ROOT/libexec/harness-codex-login
# The release-private launcher below preserves those Linux worker limits while
# also stripping all Harness control variables before native Codex starts.
launcher=$HARNESS_CONTROL_ROOT/libexec/harness-codex-runtime-launch
if [ "${HARNESS_TESTING:-0}" = 1 ] &&
    [ -n "${HARNESS_TEST_CODEX_LAUNCHER:-}" ]; then
    launcher=$HARNESS_TEST_CODEX_LAUNCHER
fi
case "$launcher" in
    /*) ;;
    *) die "Codex resilient launcher must be absolute" ;;
esac
[ -x "$launcher" ] || die "Codex resilient launcher is unavailable"
if [ "$selector" = remote-explicit ]; then
    case "$thread_recovery" in
        /*) ;;
        *) die "Codex thread recovery helper must be absolute" ;;
    esac
    [ -x "$thread_recovery" ] ||
        die "Codex thread recovery helper is unavailable"
fi

if [ -e "$state_root" ] || [ -L "$state_root" ]; then
    validate_state_root
    if [ -e "$state_dir" ] || [ -L "$state_dir" ]; then
        validate_state_dir
        if [ -e "$state_file" ] || [ -L "$state_file" ]; then
            validate_state_file
        fi
    fi
fi

if [ "$mode" = plan ]; then
    if [ -d "$state_dir" ]; then
        state_action=retain
    else
        state_action=create
    fi
    printf 'CODEX_RESILIENT mode=plan name=%s target=%s selector=%s status=ready\n' \
        "$name" "$target" "$selector"
    printf 'RUNTIME action=%s privacy=value-free mode=0600 ownership=exclusive\n' \
        "$state_action"
    printf 'RECOVERY action=resume prompt=replay-disabled backoff=15,30,60,120,240,300 jitter=bounded\n'
    if [ "$selector" = remote-explicit ]; then
        printf 'THREAD_RECOVERY action=watch rollback=safe-tail-only max_turns=8 prompt=replay-disabled\n'
    fi
    exit 0
fi

validate_legacy_lock_dir() {
    legacy_lock_dir=$state_root/$name.lock
    legacy_lock_pid=$legacy_lock_dir/pid
    [ -d "$legacy_lock_dir" ] && [ ! -L "$legacy_lock_dir" ] &&
        [ "$(path_owner "$legacy_lock_dir")" = "$uid" ] &&
        [ "$(path_mode "$legacy_lock_dir")" = 700 ] ||
        die "Codex resilient legacy lock is unsafe"
    [ -f "$legacy_lock_pid" ] && [ ! -L "$legacy_lock_pid" ] &&
        [ "$(path_owner "$legacy_lock_pid")" = "$uid" ] &&
        [ "$(path_mode "$legacy_lock_pid")" = 600 ] &&
        [ "$(path_links "$legacy_lock_pid")" = 1 ] ||
        die "Codex resilient legacy lock is unsafe"
}

reconcile_legacy_lock() {
    legacy_lock_dir=$state_root/$name.lock
    legacy_lock_pid=$legacy_lock_dir/pid
    if [ ! -e "$legacy_lock_dir" ] && [ ! -L "$legacy_lock_dir" ]; then
        return
    fi
    validate_legacy_lock_dir
    legacy_pid=$(sed -n '1p' "$legacy_lock_pid")
    case "$legacy_pid" in
        ''|*[!0-9]*) die "Codex resilient legacy lock is malformed" ;;
    esac
    if kill -0 "$legacy_pid" 2>/dev/null; then
        printf 'CODEX_RESILIENT status=blocked reason=legacy-already-running name=%s\n' \
            "$name" >&2
        exit 2
    fi
    unlink "$legacy_lock_pid"
    rmdir "$legacy_lock_dir" ||
        die "Codex resilient could not remove a stale legacy lock"
}

ensure_state_root
reconcile_legacy_lock
ensure_state_dir

temporary_state=
doctor_file=
lock_owned=no
thread_recovery_pid=
codex_pid=
cleanup() {
    status=$?
    trap - EXIT HUP INT TERM
    if [ -n "$codex_pid" ]; then
        kill -TERM "$codex_pid" 2>/dev/null || :
        wait "$codex_pid" 2>/dev/null || :
    fi
    if [ -n "$thread_recovery_pid" ]; then
        kill -TERM "$thread_recovery_pid" 2>/dev/null || :
        wait "$thread_recovery_pid" 2>/dev/null || :
    fi
    if [ -n "$doctor_file" ] &&
        [ -f "$doctor_file" ] && [ ! -L "$doctor_file" ] &&
        [ "$(path_owner "$doctor_file")" = "$uid" ] &&
        [ "$(path_links "$doctor_file")" = 1 ]; then
        unlink "$doctor_file" || status=2
    fi
    if [ -n "$temporary_state" ] &&
        [ -f "$temporary_state" ] && [ ! -L "$temporary_state" ] &&
        [ "$(path_owner "$temporary_state")" = "$uid" ] &&
        [ "$(path_links "$temporary_state")" = 1 ]; then
        unlink "$temporary_state" || status=2
    fi
    if [ "$lock_owned" = yes ] &&
        [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ] &&
        [ "$(path_owner "$lock_dir")" = "$uid" ]; then
        if [ -f "$lock_pid" ] && [ ! -L "$lock_pid" ] &&
            [ "$(path_owner "$lock_pid")" = "$uid" ] &&
            [ "$(path_links "$lock_pid")" = 1 ]; then
            unlink "$lock_pid" || status=2
        fi
        rmdir "$lock_dir" 2>/dev/null || status=2
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

old_umask=$(umask)
umask 077
if mkdir "$lock_dir" 2>/dev/null; then
    lock_owned=yes
else
    umask "$old_umask"
    validate_lock_dir
    existing_pid=$(sed -n '1p' "$lock_pid")
    case "$existing_pid" in
        ''|*[!0-9]*) die "Codex resilient lock is malformed" ;;
    esac
    if kill -0 "$existing_pid" 2>/dev/null; then
        printf 'CODEX_RESILIENT status=blocked reason=already-running name=%s\n' \
            "$name" >&2
        exit 2
    fi
    unlink "$lock_pid"
    rmdir "$lock_dir"
    umask 077
    mkdir "$lock_dir" ||
        die "Codex resilient could not replace a stale lock"
    lock_owned=yes
fi
umask "$old_umask"
chmod 700 "$lock_dir"
umask 077
printf '%s\n' "$$" >"$lock_pid"
umask "$old_umask"
chmod 600 "$lock_pid"
lock_owned=yes

write_state() {
    phase_value=$1
    attempt_value=$2
    delay_value=$3
    reason_value=$4
    temporary_state=$(mktemp "$state_dir/.state.XXXXXX") ||
        die "Codex resilient cannot allocate state"
    chmod 600 "$temporary_state"
    {
        printf 'schema=2\n'
        printf 'name=%s\n' "$name"
        printf 'target=%s\n' "$target"
        printf 'phase=%s\n' "$phase_value"
        printf 'selector=%s\n' "$selector"
        printf 'supervisor_pid=%s\n' "$$"
        printf 'attempt=%s\n' "$attempt_value"
        printf 'delay=%s\n' "$delay_value"
        printf 'reason=%s\n' "$reason_value"
    } >"$temporary_state"
    mv -f "$temporary_state" "$state_file"
    temporary_state=
    validate_state_file
}

run_codex() {
    first_launch=$1
    case "$selector" in
        new)
            if [ "$first_launch" = yes ]; then
                "$launcher"
            else
                "$launcher" resume --last
            fi
            ;;
        last) "$launcher" resume --last ;;
        explicit)
            if ! "$thread_recovery" --check --name "$recovery_name" \
                --target "$target" --thread "$session_id" \
                >/dev/null 2>&1; then
                return 2
            fi
            "$launcher" resume "$session_id"
            ;;
        remote-explicit)
            "$launcher" resume --remote unix:// "$session_id"
            ;;
        *) die "Codex resilient internal selector error" ;;
    esac
}

doctor_field() {
    check_id=$1
    field_name=$2
    awk -v target="\"$check_id\"" -v field="\"$field_name\"" '
        function emit_value(source, value) {
            if (index(source, field ":") == 0)
                return 0
            value=source
            sub("^.*" field "[[:space:]]*:[[:space:]]*\"", "", value)
            sub(/".*$/, "", value)
            print value
            return 1
        }
        {
            line=$0
            sub(/^[[:space:]]*/, "", line)
            started=0
        }
        !found && index(line, target ": {") == 1 {
            found=1
            started=1
            sub("^" target "[[:space:]]*:[[:space:]]*\\{", "", line)
        }
        found && !started {
            match($0, /[^[:space:]]/)
            indentation=RSTART - 1
            if (indentation <= 4 && index(line, "\"") == 1)
                exit
        }
        found && emit_value(line) { exit }
        found && started && index(line, "}") { exit }
    ' "$doctor_file"
}

doctor_status() {
    doctor_field "$1" status
}

doctor_summary() {
    doctor_field "$1" summary
}

doctor_detail() {
    doctor_field "$1" "$2"
}

doctor_gate() {
    gate=
    doctor_file=$(mktemp "$state_dir/.doctor.XXXXXX") ||
        die "Codex resilient cannot allocate doctor state"
    chmod 600 "$doctor_file"
    if ! "$launcher" doctor --json >"$doctor_file" 2>/dev/null; then
        unlink "$doctor_file"
        doctor_file=
        gate=doctor-failed
        return
    fi
    for check in \
        auth.credentials:local-auth \
        config.load:local-config \
        installation:local-installation \
        state.paths:local-state
    do
        check_id=${check%%:*}
        failure=${check#*:}
        check_status=$(doctor_status "$check_id")
        if [ "$check_id" = installation ] && [ "$platform" = Linux ] &&
            [ "$(doctor_summary "$check_id")" = \
                "npm install -g @openai/codex would update a different install" ]; then
            managed_package_root=$(
                doctor_detail "$check_id" "managed package root"
            )
            running_package_root=$(
                doctor_detail "$check_id" "running package root"
            )
            # Linux fleet clients are installed in immutable Harness-owned
            # release trees, not npm's mutable global package root. Native
            # doctor reports that deliberate ownership split as an
            # installation failure even when the running package is current.
            if [ "$managed_package_root" = "$running_package_root" ]; then
                case "$managed_package_root" in
                    /*/.local/opt/agents/codex/*)
                        if [ -d "$managed_package_root" ] &&
                            [ ! -L "$managed_package_root" ] &&
                            [ "$(path_owner "$managed_package_root")" = "$uid" ]; then
                            continue
                        fi
                        ;;
                esac
            fi
        fi
        if [ "$check_status" != ok ]; then
            unlink "$doctor_file"
            doctor_file=
            gate=$failure
            return
        fi
    done
    unlink "$doctor_file"
    doctor_file=
    gate=transient-exit
}

now_epoch() {
    date +%s
}

process_running() {
    candidate_pid=$1
    kill -0 "$candidate_pid" 2>/dev/null || return 1
    candidate_state=$(
        ps -o state= -p "$candidate_pid" 2>/dev/null |
            awk 'NR == 1 { print $1 }'
    )
    case "$candidate_state" in
        ''|Z*) return 1 ;;
        *) return 0 ;;
    esac
}

start_thread_recovery() {
    [ "$selector" = remote-explicit ] || return 0
    set +e
    recovery_output=$(
        "$thread_recovery" --recover --name "$recovery_name" \
            --target "$target" --thread "$session_id" \
            2>/dev/null
    )
    recovery_status=$?
    set -e
    recovery_phase=$(
        printf '%s\n' "$recovery_output" |
            sed -n 's/.* phase=\([^ ]*\).*/\1/p'
    )
    if [ "$recovery_status" -ne 0 ] ||
        { [ "$recovery_phase" != watching ] &&
          [ "$recovery_phase" != recovered ]; }; then
        return 1
    fi

    "$thread_recovery" --watch --name "$recovery_name" --target "$target" \
        --thread "$session_id" \
        >/dev/null 2>&1 &
    thread_recovery_pid=$!
    readiness_attempt=0
    while [ "$readiness_attempt" -lt 10 ]; do
        set +e
        recovery_output=$(
            "$thread_recovery" --status --name "$recovery_name" \
                --target "$target" 2>/dev/null
        )
        recovery_status=$?
        set -e
        recovery_phase=$(
            printf '%s\n' "$recovery_output" |
                sed -n 's/.* phase=\([^ ]*\).*/\1/p'
        )
        recovery_owner=$(
            printf '%s\n' "$recovery_output" |
                sed -n 's/.* owner_pid=\([^ ]*\).*/\1/p'
        )
        if [ "$recovery_status" -eq 0 ] &&
            [ "$recovery_owner" = "$thread_recovery_pid" ]; then
            case "$recovery_phase" in
                watching|recovered) return 0 ;;
                blocked|unavailable|stopped) break ;;
            esac
        fi
        kill -0 "$thread_recovery_pid" 2>/dev/null || break
        readiness_attempt=$((readiness_attempt + 1))
        sleep 1
    done
    if process_running "$thread_recovery_pid"; then
        kill -TERM "$thread_recovery_pid" 2>/dev/null || :
    fi
    set +e
    wait "$thread_recovery_pid" 2>/dev/null
    set -e
    thread_recovery_pid=
    return 1
}

if ! start_thread_recovery; then
    write_state stopped 0 0 thread-recovery-blocked
    printf 'CODEX_RESILIENT status=blocked reason=thread-recovery-blocked name=%s\n' \
        "$name" >&2
    exit 2
fi
watcher_restart_count=0
watcher_started=$(now_epoch)
watcher_restart_limit=3
watcher_stable_reset=300

attempt=0
first_launch=yes
while :; do
    write_state running "$attempt" 0 active
    started=$(now_epoch)
    watcher_failed=no
    if [ "$selector" = remote-explicit ]; then
        if [ "${HARNESS_TESTING:-0}" = 1 ]; then
            run_codex "$first_launch" &
        else
            run_codex "$first_launch" </dev/tty &
        fi
        codex_pid=$!
        while process_running "$codex_pid"; do
            if ! process_running "$thread_recovery_pid"; then
                watcher_finished=$(now_epoch)
                watcher_duration=$((watcher_finished - watcher_started))
                [ "$watcher_duration" -ge 0 ] || watcher_duration=0
                set +e
                wait "$thread_recovery_pid" 2>/dev/null
                set -e
                thread_recovery_pid=
                if [ "$watcher_duration" -ge "$watcher_stable_reset" ]; then
                    watcher_restart_count=0
                fi
                if [ "$watcher_restart_count" -lt "$watcher_restart_limit" ]; then
                    watcher_restart_count=$((watcher_restart_count + 1))
                    if start_thread_recovery; then
                        watcher_started=$(now_epoch)
                        printf 'CODEX_RESILIENT status=watcher-restarted count=%s name=%s\n' \
                            "$watcher_restart_count" "$name" >&2
                        continue
                    fi
                fi
                watcher_failed=yes
                kill -TERM "$codex_pid" 2>/dev/null || :
                break
            fi
            sleep 1
        done
        set +e
        wait "$codex_pid"
        codex_status=$?
        set -e
        codex_pid=
    else
        set +e
        run_codex "$first_launch"
        codex_status=$?
        set -e
    fi
    finished=$(now_epoch)
    duration=$((finished - started))
    [ "$duration" -ge 0 ] || duration=0
    if [ "${HARNESS_TESTING:-0}" = 1 ] &&
        [ -n "${HARNESS_TEST_DURATION_FILE:-}" ]; then
        duration=$(sed -n '1p' "$HARNESS_TEST_DURATION_FILE")
        case "$duration" in
            ''|*[!0-9]*) die "Codex resilient test duration is invalid" ;;
        esac
        sed '1d' "$HARNESS_TEST_DURATION_FILE" \
            >"$HARNESS_TEST_DURATION_FILE.next"
        mv "$HARNESS_TEST_DURATION_FILE.next" \
            "$HARNESS_TEST_DURATION_FILE"
    fi

    if [ "$watcher_failed" = yes ]; then
        write_state stopped "$attempt" 0 thread-recovery-blocked
        printf 'CODEX_RESILIENT status=blocked reason=thread-recovery-blocked name=%s\n' \
            "$name" >&2
        exit 2
    fi

    if [ "$codex_status" -eq 0 ]; then
        write_state stopped "$attempt" 0 clean-exit
        printf 'CODEX_RESILIENT status=stopped reason=clean-exit name=%s\n' "$name"
        exit 0
    fi
    case "$codex_status" in
        129|130|143)
            write_state stopped "$attempt" 0 operator-signal
            printf 'CODEX_RESILIENT status=stopped reason=operator-signal name=%s\n' \
                "$name" >&2
            exit "$codex_status"
            ;;
        2)
            write_state stopped "$attempt" 0 client-usage
            printf 'CODEX_RESILIENT status=stopped reason=client-usage name=%s\n' \
                "$name" >&2
            exit 2
            ;;
    esac

    doctor_gate
    if [ "$gate" != transient-exit ]; then
        write_state stopped "$attempt" 0 "$gate"
        printf 'CODEX_RESILIENT status=stopped reason=%s name=%s\n' \
            "$gate" "$name" >&2
        exit 2
    fi

    if [ "$duration" -ge 900 ]; then
        attempt=0
    fi
    attempt=$((attempt + 1))
    case "$attempt" in
        1) delay=15 ;;
        2) delay=30 ;;
        3) delay=60 ;;
        4) delay=120 ;;
        5) delay=240 ;;
        *) delay=300 ;;
    esac
    if [ "${HARNESS_TESTING:-0}" = 1 ] &&
        [ -n "${HARNESS_TEST_JITTER:-}" ]; then
        jitter=$HARNESS_TEST_JITTER
        case "$jitter" in ''|*[!0-9]*) die "Codex resilient test jitter is invalid" ;; esac
        [ "$jitter" -le 5 ] || die "Codex resilient test jitter is invalid"
    else
        jitter=$((($$ + attempt * 7) % 6))
    fi
    total_delay=$((delay + jitter))
    write_state backoff "$attempt" "$total_delay" transient-exit
    printf 'CODEX_RESILIENT status=retrying attempt=%s delay=%s name=%s\n' \
        "$attempt" "$total_delay" "$name" >&2
    sleep "$total_delay"
    first_launch=no
done
