#!/usr/bin/env python3
"""Select and run the smallest deterministic Harness validation tier."""

from __future__ import annotations

import argparse
from dataclasses import dataclass
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import stat
import subprocess
import sys
import tempfile
import time
from typing import Iterable


TIERS = {"R0": 0, "R1": 1, "R2": 2, "R3": 3}
FULL_SUITE = "tests/test-phase1.sh"
IMPACT_MAP = "tests/validation-impact.tsv"
GROUP_MAP = "tests/validation-groups.tsv"
FOCUSED_MANIFEST = "tests/focused-suites.tsv"
FOCUSED_RUNNER = "tools/run-focused-tests.py"
NONCACHE_TOKENS = (
    "auth",
    "codex",
    "credential",
    "delete",
    "fleet",
    "lifecycle",
    "process",
    "recovery",
    "restic",
    "safety",
    "scheduler",
    "secret",
    "ssh",
    "tmux",
)


@dataclass(frozen=True)
class Rule:
    pattern: str
    tier: str
    suite: str | None
    reason: str
    regex: re.Pattern[str]


@dataclass(frozen=True)
class GroupRule:
    name: str
    label: str
    regex: re.Pattern[str]


@dataclass(frozen=True)
class FocusedSuite:
    index: int
    path: str
    label: str
    estimate: int
    resource: str
    group: str
    platforms: frozenset[str] = frozenset({"Darwin", "Linux"})


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Run risk-tiered local validation and emit a self-attested receipt."
    )
    parser.add_argument("--base", default="HEAD^")
    parser.add_argument("--jobs", default=os.environ.get("HARNESS_TEST_JOBS", "auto"))
    parser.add_argument(
        "--stage", choices=("repair", "discovery", "final"), default="repair"
    )
    parser.add_argument(
        "--full",
        action="store_true",
        help="run the complete manifest; valid only with --stage final",
    )
    parser.add_argument("--suite")
    parser.add_argument("--plan", action="store_true")
    parser.add_argument("--path", action="append", default=[])
    parser.add_argument("--receipt-dir")
    parser.add_argument("--no-receipt", action="store_true")
    return parser.parse_args()


def run_git(root: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    env = os.environ.copy()
    env["GIT_OPTIONAL_LOCKS"] = "0"
    return subprocess.run(
        ["git", *args],
        cwd=root,
        env=env,
        stdin=subprocess.DEVNULL,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=check,
    )


def test_environment() -> dict[str, str]:
    environment = os.environ.copy()
    try:
        count = int(environment.get("GIT_CONFIG_COUNT", "0"))
    except ValueError as error:
        raise ValueError("invalid inherited GIT_CONFIG_COUNT") from error
    environment["GIT_CONFIG_COUNT"] = str(count + 1)
    environment[f"GIT_CONFIG_KEY_{count}"] = "maintenance.auto"
    environment[f"GIT_CONFIG_VALUE_{count}"] = "false"
    return environment


def load_rules(root: Path) -> list[Rule]:
    path = root / IMPACT_MAP
    rules: list[Rule] = []
    for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not raw or raw.startswith("#"):
            continue
        fields = raw.rsplit("|", 3)
        if len(fields) != 4:
            raise ValueError(f"invalid impact-map line {number}")
        pattern, tier, suite, reason = fields
        if tier not in TIERS or not pattern or not reason:
            raise ValueError(f"invalid impact-map line {number}")
        selected = None if suite == "-" else suite
        if selected:
            candidate = root / selected
            if not candidate.is_file() or candidate.is_symlink():
                raise ValueError(f"unsafe or absent mapped suite: {selected}")
        rules.append(Rule(pattern, tier, selected, reason, re.compile(pattern)))
    if not rules:
        raise ValueError("empty impact map")
    return rules


def load_group_rules(root: Path) -> list[GroupRule]:
    path = root / GROUP_MAP
    rules: list[GroupRule] = []
    names: set[str] = set()
    for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not raw or raw.startswith("#"):
            continue
        fields = raw.split("|", 2)
        if len(fields) != 3:
            raise ValueError(f"invalid validation-group line {number}")
        name, label, pattern = fields
        if (
            not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", name)
            or name in names
            or not label
            or not pattern
        ):
            raise ValueError(f"invalid validation-group line {number}")
        names.add(name)
        rules.append(GroupRule(name, label, re.compile(pattern)))
    if not rules:
        raise ValueError("empty validation group map")
    return rules


def load_focused_suites(root: Path, groups: list[GroupRule]) -> dict[str, FocusedSuite]:
    path = root / FOCUSED_MANIFEST
    suites: dict[str, FocusedSuite] = {}
    for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not raw or raw.startswith("#"):
            continue
        fields = raw.split("|")
        if len(fields) not in (3, 4, 5):
            raise ValueError(f"invalid focused-suite line {number}")
        suite, label, estimate_text = fields[:3]
        resource = fields[3] if len(fields) == 4 else "light"
        if len(fields) == 5:
            resource = fields[3]
        platform_text = fields[4] if len(fields) == 5 else "all"
        platforms = (
            frozenset({"Darwin", "Linux"})
            if platform_text == "all"
            else frozenset({platform_text})
        )
        try:
            estimate = int(estimate_text)
        except ValueError as error:
            raise ValueError(f"invalid focused-suite line {number}") from error
        matches = [rule.name for rule in groups if rule.regex.search(suite)]
        if len(matches) != 1:
            raise ValueError(
                f"focused suite must match exactly one validation group: {suite}"
            )
        if (
            suite in suites
            or resource not in {"light", "heavy"}
            or platform_text not in {"all", "Darwin", "Linux"}
            or estimate < 1
        ):
            raise ValueError(f"invalid focused-suite line {number}")
        suites[suite] = FocusedSuite(
            len(suites) + 1, suite, label, estimate, resource, matches[0], platforms
        )
    if not suites:
        raise ValueError("empty focused-suite manifest")
    return suites


def normalize_paths(paths: Iterable[str]) -> list[str]:
    normalized: set[str] = set()
    for raw in paths:
        path = raw.strip()
        candidate = Path(path)
        if (
            not path
            or candidate.is_absolute()
            or ".." in candidate.parts
            or path.startswith("./")
        ):
            raise ValueError(f"unsafe changed path: {raw!r}")
        normalized.add(candidate.as_posix())
    return sorted(normalized)


def ignored_top_level_files(root: Path) -> list[str]:
    tracked_roots = {
        Path(path).parts[0]
        for path in run_git(root, "ls-files").stdout.splitlines()
        if Path(path).parts
    }
    unexpected: list[str] = []
    for candidate in root.iterdir():
        if candidate.name == ".git" or candidate.name in tracked_roots:
            continue
        try:
            info = candidate.lstat()
        except FileNotFoundError:
            continue
        if not (stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode)):
            continue
        ignored = run_git(
            root, "check-ignore", "-q", "--", candidate.name, check=False
        )
        if ignored.returncode == 0:
            unexpected.append(candidate.name)
    return sorted(unexpected)


def changed_paths(root: Path, base: str) -> list[str]:
    run_git(root, "cat-file", "-e", f"{base}^{{commit}}")
    tracked = run_git(
        root,
        "diff",
        "--name-only",
        "--diff-filter=ACDMRTUXB",
        base,
        "--",
    ).stdout.splitlines()
    untracked = run_git(
        root, "ls-files", "--others", "--exclude-standard"
    ).stdout.splitlines()
    ignored_top_level = ignored_top_level_files(root)
    return normalize_paths([*tracked, *untracked, *ignored_top_level])


def classify(
    root: Path,
    paths: list[str],
    rules: list[Rule],
    focused: dict[str, FocusedSuite] | None = None,
    group_rules: list[GroupRule] | None = None,
) -> dict:
    if group_rules is None:
        group_rules = load_group_rules(root)
    if focused is None:
        focused = load_focused_suites(root, group_rules)
    tier = "R0"
    suites: set[str] = set()
    matches: list[dict[str, str]] = []
    if not paths:
        return {
            "tier": tier,
            "paths": [],
            "suites": [],
            "groups": [],
            "estimated_seconds": 0,
            "matches": [{"path": "-", "pattern": "-", "reason": "no changed paths"}],
            "owner_gaps": [],
            "final_required": False,
            "cacheable": True,
        }

    for path in paths:
        path_matches = [rule for rule in rules if rule.regex.search(path)]
        implicit = path if path in focused else None
        if implicit:
            if TIERS["R2"] > TIERS[tier]:
                tier = "R2"
            suites.add(implicit)
            matches.append(
                {
                    "path": path,
                    "pattern": "registered-focused-suite",
                    "reason": "focused suite owns its own contract",
                }
            )
        if not path_matches and not implicit:
            tier = "R3"
            matches.append(
                {
                    "path": path,
                    "pattern": "-",
                    "reason": "unmapped path escalates",
                }
            )
            continue
        for rule in path_matches:
            if TIERS[rule.tier] > TIERS[tier]:
                tier = rule.tier
            if rule.suite:
                if rule.suite not in focused:
                    raise ValueError(
                        f"mapped suite is outside the focused manifest: {rule.suite}"
                    )
                suites.add(rule.suite)
            matches.append(
                {"path": path, "pattern": rule.pattern, "reason": rule.reason}
            )

    selected = sorted(suites)
    current_platform = platform.system()
    applicable = [
        suite for suite in selected
        if current_platform in focused[suite].platforms
    ]
    not_applicable = sorted(set(selected) - set(applicable))
    owner_gaps = sorted(
        {
            item["path"]
            for item in matches
            if item["pattern"] == "-" and item["reason"] == "unmapped path escalates"
        }
    )
    selected_groups = sorted({focused[suite].group for suite in selected})
    if paths and not selected_groups:
        selected_groups = ["validation-core"]
    labels = {rule.name: rule.label for rule in group_rules}
    groups = []
    for name in selected_groups:
        members = [
            suite.path for suite in focused.values() if suite.group == name
        ]
        groups.append(
            {
                "name": name,
                "label": labels[name],
                "suites": members,
                "estimated_seconds": sum(focused[path].estimate for path in members),
            }
        )
    cache_text = " ".join([*paths, *selected, *(item["reason"] for item in matches)])
    cacheable = tier in {"R0", "R1"} and not any(
        token in cache_text.lower() for token in NONCACHE_TOKENS
    )
    return {
        "tier": tier,
        "paths": paths,
        "suites": selected,
        "applicable_suites": applicable,
        "not_applicable_suites": not_applicable,
        "groups": groups,
        "estimated_seconds": sum(focused[suite].estimate for suite in selected),
        "matches": matches,
        "owner_gaps": owner_gaps,
        "final_required": bool(paths),
        "cacheable": cacheable,
    }


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def environment_contract(jobs: str) -> dict[str, str]:
    git_version = subprocess.run(
        ["git", "--version"],
        stdin=subprocess.DEVNULL,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=True,
    ).stdout.strip()
    def value_digest(name: str) -> str:
        marker = (
            b"set\0" + os.fsencode(os.environ[name])
            if name in os.environ
            else b"unset\0"
        )
        return hashlib.sha256(marker).hexdigest()

    return {
        "home_sha256": value_digest("HOME"),
        "git": git_version,
        "jobs": jobs,
        "lang_sha256": value_digest("LANG"),
        "lc_all_sha256": value_digest("LC_ALL"),
        "machine": platform.machine(),
        "path_sha256": value_digest("PATH"),
        "portable_ci": os.environ.get("HARNESS_PORTABLE_CI", ""),
        "python": platform.python_version(),
        "pythonoptimize_sha256": value_digest("PYTHONOPTIMIZE"),
        "release": platform.release(),
        "system": platform.system(),
        "tmpdir_sha256": value_digest("TMPDIR"),
    }


def validate_python_mode() -> None:
    if os.environ.get("PYTHONOPTIMIZE", "") not in ("", "0"):
        raise ValueError("PYTHONOPTIMIZE would disable validator assertions")


def validator_contract(root: Path, suites: list[str]) -> dict:
    paths = [
        "libexec/harness-validate",
        IMPACT_MAP,
        GROUP_MAP,
        FOCUSED_MANIFEST,
        FOCUSED_RUNNER,
        *suites,
    ]
    return {
        path: file_sha256(root / path)
        for path in sorted(set(paths))
    }


def private_receipt_dir(root: Path, requested: str | None) -> Path:
    if requested:
        path = Path(requested).resolve(strict=True)
        info = path.stat()
        if (
            not stat.S_ISDIR(info.st_mode)
            or info.st_uid != os.getuid()
            or info.st_mode & (stat.S_IRWXG | stat.S_IRWXO)
        ):
            raise ValueError("receipt directory must be private and current-user-owned")
        return path

    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        parent = Path(runtime)
        info = parent.stat()
        if (
            not stat.S_ISDIR(info.st_mode)
            or info.st_uid != os.getuid()
            or parent.is_symlink()
        ):
            raise ValueError("unsafe XDG_RUNTIME_DIR")
    else:
        parent = Path(tempfile.gettempdir()) / f"harness-validation-{os.getuid()}"
        try:
            parent.mkdir(mode=0o700)
        except FileExistsError:
            pass
        info = parent.lstat()
        if (
            not stat.S_ISDIR(info.st_mode)
            or stat.S_ISLNK(info.st_mode)
            or info.st_uid != os.getuid()
            or stat.S_IMODE(info.st_mode) != 0o700
        ):
            raise ValueError("unsafe fallback validation root")

    identity = hashlib.sha256(os.fsencode(str(root.resolve()))).hexdigest()[:20]
    path = parent / "harness-validation" / identity
    current = parent
    for component in ("harness-validation", identity):
        current = current / component
        try:
            current.mkdir(mode=0o700)
        except FileExistsError:
            pass
        info = current.lstat()
        if (
            not stat.S_ISDIR(info.st_mode)
            or stat.S_ISLNK(info.st_mode)
            or info.st_uid != os.getuid()
            or stat.S_IMODE(info.st_mode) != 0o700
        ):
            raise ValueError("unsafe validation receipt root")
    return path


def canonical_json(value: object) -> bytes:
    return (
        json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
        + "\n"
    ).encode("utf-8")


def write_private_json(path: Path, payload: object) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags, 0o600)
    try:
        with os.fdopen(descriptor, "wb", closefd=False) as handle:
            handle.write(canonical_json(payload))
            handle.flush()
            os.fsync(handle.fileno())
    finally:
        os.close(descriptor)


def clean_tree_identity(root: Path, base: str, decision: dict, jobs: str) -> dict | None:
    if run_git(root, "status", "--porcelain", "--untracked-files=all").stdout:
        return None
    head = run_git(root, "rev-parse", "HEAD").stdout.strip()
    tree = run_git(root, "rev-parse", "HEAD^{tree}").stdout.strip()
    contract = validator_contract(root, decision["suites"])
    identity = {
        "base": run_git(root, "rev-parse", f"{base}^{{commit}}").stdout.strip(),
        "cacheable": decision["cacheable"],
        "changed_paths": decision["paths"],
        "environment": environment_contract(jobs),
        "head": head,
        "kind": "owner-self-attested-local-validation",
        "schema": 1,
        "stage": decision.get("stage", "repair"),
        "suites": decision["suites"],
        "tier": decision["tier"],
        "tree": tree,
        "validator_contract": contract,
    }
    identity["identity_sha256"] = hashlib.sha256(canonical_json(identity)).hexdigest()
    return identity


def cached_receipt(receipt_dir: Path, identity: dict) -> Path | None:
    if not identity["cacheable"]:
        return None
    prefix = identity["identity_sha256"] + "--"
    for path in sorted(receipt_dir.glob(prefix + "*.json")):
        try:
            info = path.lstat()
            if (
                not stat.S_ISREG(info.st_mode)
                or stat.S_ISLNK(info.st_mode)
                or info.st_uid != os.getuid()
                or stat.S_IMODE(info.st_mode) != 0o600
                or info.st_nlink != 1
            ):
                continue
            data = path.read_bytes()
            digest = hashlib.sha256(data).hexdigest()
            if path.name != f"{identity['identity_sha256']}--{digest}.json":
                continue
            payload = json.loads(data.decode("utf-8"))
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            continue
        if payload.get("identity") == identity and payload.get("result", {}).get(
            "status"
        ) == "pass":
            return path
    return None


def untracked_whitespace_check(
    root: Path, paths: list[str], base: str | None = None
) -> int:
    if not paths:
        return 0
    tracked = set(
        run_git(root, "ls-files", "--", *paths).stdout.splitlines()
    )
    deleted = set()
    if base:
        deleted = set(
            run_git(
                root,
                "diff",
                "--name-only",
                "--diff-filter=D",
                base,
                "--",
                *paths,
            ).stdout.splitlines()
        )
    for relative in paths:
        if relative in tracked:
            continue
        if relative in deleted:
            continue
        ignored = run_git(
            root, "check-ignore", "-q", "--", relative, check=False
        )
        if ignored.returncode == 0:
            # An ignored top-level file is not a publishable source input.
            # Reject it without opening or diffing potentially private bytes.
            return 1
        candidate = root / relative
        try:
            info = candidate.lstat()
        except FileNotFoundError:
            return 1
        if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
            return 1
        result = subprocess.run(
            ["git", "diff", "--no-index", "--check", "--", "/dev/null", relative],
            cwd=root,
            env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"},
            stdin=subprocess.DEVNULL,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        # --no-index returns one for an ordinary nonempty difference. Any
        # diagnostic output under --check is a whitespace error; other status
        # values are command failures.
        if result.returncode not in (0, 1) or result.stdout or result.stderr:
            return 1
    return 0


def repository_independence_check(root: Path, paths: list[str] | None) -> int:
    git_args = () if paths is None else ("--", *paths)
    tracked = set(
        run_git(root, "ls-files", *git_args).stdout.splitlines()
    )
    peer = "web" "site"
    forbidden = re.compile(
        rf"/home/[^/]+/{peer}|\$HOME/{peer}|github\.com/[^/]+/{peer}|"
        rf"{peer}-main\.json|{peer}-public-history",
        re.IGNORECASE,
    )
    excluded = re.compile(
        r"^(?:TODO\.md|docs/audits/.*|evaluation/results/.*|"
        r"docs/llm-hpc-readiness-handoff-2026-07-17\.md)$"
    )
    for relative in sorted(tracked):
        candidate = root / relative
        try:
            info = candidate.lstat()
        except FileNotFoundError:
            continue
        if stat.S_ISLNK(info.st_mode):
            resolved = (candidate.parent / os.readlink(candidate)).resolve()
            if not resolved.exists():
                return 1
            try:
                resolved.relative_to(root)
            except ValueError:
                return 1
            continue
        if not stat.S_ISREG(info.st_mode) or excluded.search(relative):
            continue
        try:
            source = candidate.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue
        if forbidden.search(source):
            return 1
        if relative in {
            "profiles/tools.tsv",
            "tools/artifacts.tsv",
            "libexec/harness-tool",
            "libexec/harness-inventory",
        } and re.search(r"\blftp\b", source, re.IGNORECASE):
            return 1
    if ".gitmodules" in tracked and (root / ".gitmodules").exists():
        return 1
    return 0


def suites_for_stage(
    decision: dict,
    stage: str,
    requested: str | None,
    *,
    execute: bool,
    full: bool = False,
) -> list[str]:
    owners = decision.get("applicable_suites", decision["suites"])
    if execute and decision.get("owner_gaps"):
        raise ValueError(
            "changed paths have owner gaps; add impact-map owners for: "
            + ", ".join(decision["owner_gaps"])
        )
    if full:
        if stage != "final":
            raise ValueError("--full is valid only with --stage final")
        if requested:
            raise ValueError("--full and --suite are mutually exclusive")
        return [FULL_SUITE]
    if stage == "final":
        if requested:
            raise ValueError("--suite is valid only for repair stage")
        return owners
    if stage == "discovery":
        if requested:
            raise ValueError("--suite is valid only for repair stage")
        if not decision["paths"]:
            raise ValueError("no changed paths to discover")
        return owners
    if requested:
        if requested not in owners:
            raise ValueError("--suite is not an owner selected by the changed paths")
        return [requested]
    if execute:
        if len(owners) > 1:
            raise ValueError(
                "repair stage selected multiple owners; run each --suite from the plan"
            )
    return owners


def run_validation(root: Path, base: str, decision: dict, jobs: str) -> list[dict]:
    started = time.monotonic()
    diff = subprocess.run(
        ["git", "diff", "--check", base, "--"],
        cwd=root,
        env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"},
        stdin=subprocess.DEVNULL,
        check=False,
    )
    results = [
        {
            "path": "git diff --check",
            "seconds": round(time.monotonic() - started, 6),
            "status": diff.returncode,
        }
    ]
    if diff.returncode != 0:
        return results

    untracked_started = time.monotonic()
    untracked_status = untracked_whitespace_check(
        root, decision["paths"], base
    )
    results.append(
        {
            "path": "git diff --no-index --check (untracked)",
            "seconds": round(time.monotonic() - untracked_started, 6),
            "status": untracked_status,
        }
    )
    if untracked_status != 0:
        return results

    independence_started = time.monotonic()
    independence_status = repository_independence_check(
        root, None if decision.get("full_requested", False) else decision["paths"]
    )
    results.append(
        {
            "path": "changed repository independence",
            "seconds": round(time.monotonic() - independence_started, 6),
            "status": independence_status,
        }
    )
    if independence_status != 0:
        return results

    env = test_environment()
    env.pop("HARNESS_ROOT", None)
    env["HARNESS_TEST_JOBS"] = jobs
    env["HARNESS_CHANGED_PATHS"] = "\n".join(decision["paths"])
    env["HARNESS_VALIDATION_BASE"] = base
    env["HARNESS_VALIDATION_FULL"] = (
        "1" if decision.get("full_requested", False) else "0"
    )
    for suite in decision["suites"]:
        suite_started = time.monotonic()
        result = subprocess.run(
            [str(root / suite)],
            cwd=root,
            env=env,
            stdin=subprocess.DEVNULL,
            check=False,
        )
        results.append(
            {
                "path": suite,
                "seconds": round(time.monotonic() - suite_started, 6),
                "status": result.returncode,
            }
        )
        if result.returncode != 0:
            break
    return results


def run_discovery(
    root: Path,
    base: str,
    decision: dict,
    jobs: str,
    receipt_dir: Path,
    focused: dict[str, FocusedSuite],
) -> tuple[list[dict], Path]:
    stage = decision.get("stage", "discovery")
    nonce = (
        f"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}-"
        f"{os.getpid()}-{time.time_ns()}"
    )
    inventory = receipt_dir / f"{stage}-{nonce}.json"
    log_dir = receipt_dir / f"{stage}-{nonce}.logs"
    checks = run_validation(root, base, {**decision, "suites": []}, jobs)
    if not all(item["status"] == 0 for item in checks):
        write_private_json(
            inventory,
            {
                "schema": f"harness-validation-{stage}-v1",
                "status": "fail",
                "paths": decision["paths"],
                "groups": [group["name"] for group in decision["groups"]],
                "results": checks,
                "failure_suites": [],
                "not_run": decision["suites"],
                "not_applicable": decision.get("not_applicable_suites", []),
            },
        )
        return checks, inventory

    if not decision["suites"]:
        write_private_json(
            inventory,
            {
                "schema": f"harness-validation-{stage}-v1",
                "status": "pass",
                "paths": decision["paths"],
                "groups": [group["name"] for group in decision["groups"]],
                "results": checks,
                "failure_suites": [],
                "not_run": [],
                "not_applicable": decision.get("not_applicable_suites", []),
            },
        )
        return checks, inventory

    runner_inventory = receipt_dir / f"{stage}-{nonce}-runner.json"
    command = [
        sys.executable,
        str(root / FOCUSED_RUNNER),
        "--root",
        str(root),
        "--manifest",
        str(root / FOCUSED_MANIFEST),
        "--log-dir",
        str(log_dir),
        "--timings-file",
        str(runner_inventory),
        "--jobs",
        jobs,
        "--keep-going",
    ]
    for suite in decision["suites"]:
        command.extend(("--suite", suite))
    env = test_environment()
    env.pop("HARNESS_ROOT", None)
    env["HARNESS_CHANGED_PATHS"] = "\n".join(decision["paths"])
    env["HARNESS_VALIDATION_BASE"] = base
    env["HARNESS_VALIDATION_FULL"] = (
        "1" if decision.get("full_requested", False) else "0"
    )
    result = subprocess.run(
        command,
        cwd=root,
        env=env,
        stdin=subprocess.DEVNULL,
        check=False,
    )
    payload = json.loads(runner_inventory.read_text(encoding="utf-8"))
    steps = checks + [
        {
            "path": row["suite"],
            "seconds": row["seconds"],
            "status": row["exit_code"],
            "state": row["state"],
        }
        for row in payload["results"]
    ]
    for row in payload["results"]:
        if row["state"] != "pass":
            continue
        suite = focused[row["suite"]]
        log = log_dir / f"{suite.index:03d}-{Path(suite.path).stem}.log"
        try:
            log.unlink()
        except FileNotFoundError:
            pass
    try:
        log_dir.rmdir()
    except OSError:
        pass
    if (result.returncode == 0) != (payload.get("status") == "pass"):
        raise ValueError("focused discovery status disagrees with its inventory")
    failure_suites = [
        row["suite"] for row in payload["results"] if row["state"] != "pass"
    ]
    write_private_json(
        inventory,
        {
            "schema": f"harness-validation-{stage}-v1",
            "status": payload["status"],
            "paths": decision["paths"],
            "groups": [group["name"] for group in decision["groups"]],
            "results": steps,
            "failure_suites": failure_suites,
            "not_run": payload["not_run"],
            "not_applicable": decision.get("not_applicable_suites", []),
            "failure_log_dir": str(log_dir) if failure_suites else None,
        },
    )
    runner_inventory.unlink()
    return steps, inventory


def publish_receipt(receipt_dir: Path, identity: dict, results: list[dict]) -> Path:
    payload = {
        "attestation": (
            "Owner self-attestation from the same trust root; not independent CI."
        ),
        "completed_at": datetime.now(timezone.utc).isoformat(),
        "identity": identity,
        "result": {
            "status": "pass",
            "steps": results,
        },
    }
    data = canonical_json(payload)
    digest = hashlib.sha256(data).hexdigest()
    path = receipt_dir / f"{identity['identity_sha256']}--{digest}.json"
    write_private_json(path, payload)
    return path


def main() -> int:
    args = parse_args()
    root = Path(__file__).resolve().parent.parent
    try:
        validate_python_mode()
        rules = load_rules(root)
        group_rules = load_group_rules(root)
        focused = load_focused_suites(root, group_rules)
        if args.path:
            if not args.plan:
                raise ValueError("--path is permitted only with --plan")
            paths = normalize_paths(args.path)
        else:
            paths = changed_paths(root, args.base)
        decision = classify(root, paths, rules, focused, group_rules)
        execution_suites = suites_for_stage(
            decision,
            args.stage,
            args.suite,
            execute=not args.plan,
            full=args.full,
        )
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"validate: {error}", file=sys.stderr)
        return 2

    plan = {
        "base": args.base,
        "cacheable": decision["cacheable"] and args.stage == "repair",
        "estimated_seconds": decision["estimated_seconds"],
        "execution_estimated_seconds": (
            sum(suite.estimate for suite in focused.values())
            if args.full
            else sum(focused[path].estimate for path in execution_suites)
        ),
        "execution_suites": execution_suites,
        "final_required": decision["final_required"],
        "full_requested": args.full,
        "groups": decision["groups"],
        "matches": decision["matches"],
        "owner_suites": decision["suites"],
        "not_applicable_suites": decision.get("not_applicable_suites", []),
        "owner_gaps": decision["owner_gaps"],
        "paths": decision["paths"],
        "schema": 1,
        "stage": args.stage,
        "suites": execution_suites,
        "tier": decision["tier"],
    }
    if args.plan:
        print(json.dumps(plan, sort_keys=True, indent=2))
        return 0

    execution = {
        **decision,
        "cacheable": decision["cacheable"] and args.stage == "repair",
        "full_requested": args.full,
        "stage": args.stage,
        "suites": execution_suites,
    }
    identity = clean_tree_identity(root, args.base, execution, args.jobs)
    receipt_dir: Path | None = None
    if args.stage in {"discovery", "final"} and args.no_receipt:
        print(
            f"validate: {args.stage} requires a durable failure inventory",
            file=sys.stderr,
        )
        return 2
    if identity and not args.no_receipt:
        try:
            receipt_dir = private_receipt_dir(root, args.receipt_dir)
        except (OSError, ValueError) as error:
            print(f"validate: {error}", file=sys.stderr)
            return 2
        cached = cached_receipt(receipt_dir, identity)
        if cached:
            if clean_tree_identity(
                root, args.base, execution, args.jobs
            ) != identity:
                print(
                    "validate: tree or validation contract changed during "
                    "receipt lookup",
                    file=sys.stderr,
                )
                return 2
            print(
                f"VALIDATE status=pass reuse=1 stage={args.stage} "
                f"tier={decision['tier']} "
                f"receipt={cached}"
            )
            return 0

    inventory: Path | None = None
    if args.stage in {"discovery", "final"}:
        if receipt_dir is None:
            try:
                receipt_dir = private_receipt_dir(root, args.receipt_dir)
            except (OSError, ValueError) as error:
                print(f"validate: {error}", file=sys.stderr)
                return 2
        try:
            results, inventory = run_discovery(
                root, args.base, execution, args.jobs, receipt_dir, focused
            )
        except (OSError, ValueError, subprocess.CalledProcessError) as error:
            print(f"validate: {error}", file=sys.stderr)
            return 2
    else:
        results = run_validation(root, args.base, execution, args.jobs)
    passed = all(item["status"] == 0 for item in results)
    if not passed:
        print(
            f"VALIDATE status=fail reuse=0 stage={args.stage} "
            f"tier={decision['tier']}"
            + (f" inventory={inventory}" if inventory else ""),
            file=sys.stderr,
        )
        return 1

    if identity and clean_tree_identity(
        root, args.base, execution, args.jobs
    ) != identity:
        print(
            "validate: tree or validation contract changed during validation",
            file=sys.stderr,
        )
        return 2

    receipt = "none-dirty" if identity is None else "none-disabled"
    if identity and receipt_dir:
        try:
            receipt_path = publish_receipt(receipt_dir, identity, results)
        except FileExistsError:
            print("validate: ambiguous receipt collision", file=sys.stderr)
            return 2
        if clean_tree_identity(root, args.base, execution, args.jobs) != identity:
            try:
                info = receipt_path.lstat()
                if (
                    stat.S_ISREG(info.st_mode)
                    and not stat.S_ISLNK(info.st_mode)
                    and info.st_uid == os.getuid()
                    and stat.S_IMODE(info.st_mode) == 0o600
                    and info.st_nlink == 1
                ):
                    receipt_path.unlink()
            except OSError:
                pass
            print(
                "validate: tree or validation contract changed during "
                "receipt publication",
                file=sys.stderr,
            )
            return 2
        receipt = str(receipt_path)
    print(
        f"VALIDATE status=pass reuse=0 stage={args.stage} "
        f"tier={decision['tier']} receipt={receipt}"
        + (f" inventory={inventory}" if inventory else "")
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
