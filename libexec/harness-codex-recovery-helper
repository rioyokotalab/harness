#!/usr/bin/env python3
"""Serialize Local Codex recovery events through an ephemeral helper worker."""

from __future__ import print_function

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
import re
import signal
import sqlite3
import stat
import subprocess
import sys
import tempfile
import time


sys.dont_write_bytecode = True
CONTROL_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
TARGET_ROOT = CONTROL_ROOT
os.environ["HARNESS_CONTROL_ROOT"] = CONTROL_ROOT
os.environ["HARNESS_TARGET_ROOT"] = TARGET_ROOT
os.environ.pop("HARNESS_ROOT", None)
sys.path.insert(0, os.path.join(CONTROL_ROOT, "libexec"))
from harness_codex_targets import (  # noqa: E402
    SESSION_NAME,
    PANE_ROLE_OPTION,
    TargetError,
    cwd_allowed,
    load_targets,
)

SAFE_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$")
SAFE_WINDOW_ID = re.compile(r"^@[0-9]+$")
SAFE_PANE_ID = re.compile(r"^%[0-9]+$")
TARGETS = load_targets()
EXPECTED = tuple(
    (
        value["name"],
        value["window_index"],
        value["window_name"],
        value["pane_index"],
    )
    for value in TARGETS
)
PANE_ROLE_FORMAT = "#{" + PANE_ROLE_OPTION + "}"
TARGET_PATHS = {
    value["name"]: value["repository"] for value in TARGETS
}
TARGETLESS_EVENT_KINDS = (
    "mirror-drift",
    "phone-mirror-drift",
    "remote-control-absent",
)
INTERACTIVE_SOURCES = ("cli", "vscode")
TERMINAL_PHASES = ("completed", "failed", "ambiguous", "deferred")
ACCEPTED_RESULT = re.compile(r"^RECOVERY_RESULT status=accepted(?:[ \t]|$)")
APPROVAL_POLICY = (
    '{ granular = { sandbox_approval = false, rules = false, '
    'mcp_elicitations = true, request_permissions = false, '
    'skill_approval = false } }'
)


class HelperError(RuntimeError):
    pass


def fail(message):
    raise HelperError(message)


def safe_id(value, label):
    if not SAFE_ID.match(value):
        fail("{} is malformed".format(label))
    return value


def managed_target(value):
    if not isinstance(value, str):
        fail("target is malformed")
    safe_id(value, "target")
    if value not in TARGET_PATHS:
        fail("target is outside the closed managed target map")
    return value


def event_target(identity):
    if not isinstance(identity, dict):
        fail("event identity is malformed")
    if "target" not in identity:
        if identity.get("kind") not in TARGETLESS_EVENT_KINDS:
            fail("event target is required")
        return "harness"
    return managed_target(identity["target"])


def safe_window_id(value):
    if not SAFE_WINDOW_ID.match(value):
        fail("window ID is malformed")
    return value


def safe_pane_id(value):
    if not SAFE_PANE_ID.match(value):
        fail("pane ID is malformed")
    return value


def process_info(pid):
    try:
        with open("/proc/{}/stat".format(pid), "r") as stream:
            value = stream.read()
        prefix = "{} (".format(pid)
        end = value.rfind(") ")
        if not value.startswith(prefix) or end < len(prefix):
            return None
        fields = value[end + 2 :].split()
        if len(fields) < 20:
            return None
        with open("/proc/{}/cmdline".format(pid), "rb") as stream:
            argv = [
                part.decode("utf-8", "strict")
                for part in stream.read().split(b"\0")
                if part
            ]
        return {
            "pid": pid,
            "parent": int(fields[1]),
            "start": fields[19],
            "comm": value[len(prefix) : end],
            "uid": os.stat("/proc/{}".format(pid)).st_uid,
            "argv": argv,
        }
    except (IOError, OSError, UnicodeError, ValueError):
        return None


def runtime_root():
    testing = os.environ.get("HARNESS_TEST_RUNTIME_DIR")
    if testing and os.environ.get("HARNESS_TESTING") == "1":
        root = testing
    else:
        parent = os.environ.get("XDG_RUNTIME_DIR")
        if not parent or not os.path.isabs(parent):
            parent = os.environ.get("TMPDIR", "/tmp")
        if not os.path.isabs(parent):
            fail("runtime parent must be absolute")
        root = os.path.join(
            parent, "harness-codex-recovery-helper-{}".format(os.getuid())
        )
    if not os.path.isabs(root):
        fail("runtime root must be absolute")
    if not os.path.exists(root):
        old = os.umask(0o077)
        try:
            os.makedirs(root, 0o700)
        finally:
            os.umask(old)
    validate_directory(root)
    for name in ("events", "receipts", "logs"):
        path = os.path.join(root, name)
        if not os.path.exists(path):
            old = os.umask(0o077)
            try:
                os.mkdir(path, 0o700)
            finally:
                os.umask(old)
        validate_directory(path)
    return root


def validate_directory(path):
    info = os.lstat(path)
    if (
        not stat.S_ISDIR(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_uid != os.getuid()
        or stat.S_IMODE(info.st_mode) != 0o700
    ):
        fail("private directory is unsafe")


def validate_regular(path):
    info = os.lstat(path)
    if (
        not stat.S_ISREG(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_uid != os.getuid()
        or info.st_nlink != 1
        or stat.S_IMODE(info.st_mode) != 0o600
    ):
        fail("private file is unsafe")
    return info


def atomic_json(path, value):
    parent = os.path.dirname(path)
    descriptor, temporary = tempfile.mkstemp(prefix=".helper.", dir=parent)
    try:
        os.fchmod(descriptor, 0o600)
        payload = (json.dumps(value, sort_keys=True) + "\n").encode("utf-8")
        os.write(descriptor, payload)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.replace(temporary, path)
        validate_regular(path)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if os.path.exists(temporary):
            os.unlink(temporary)


def read_json(path, default=None):
    if not os.path.exists(path):
        return default
    validate_regular(path)
    with open(path, "r") as stream:
        return json.load(stream)


@contextlib.contextmanager
def exclusive_lock(path, nonblocking=False):
    flags = os.O_CREAT | os.O_RDWR
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    old = os.umask(0o077)
    try:
        descriptor = os.open(path, flags, 0o600)
    finally:
        os.umask(old)
    try:
        info = os.fstat(descriptor)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != os.getuid()
            or info.st_nlink != 1
            or stat.S_IMODE(info.st_mode) != 0o600
        ):
            fail("private lock is unsafe")
        operation = fcntl.LOCK_EX
        if nonblocking:
            operation |= fcntl.LOCK_NB
        try:
            fcntl.flock(descriptor, operation)
        except (IOError, OSError):
            fail("helper is already running")
        yield
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def event_identity(value):
    payload = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(payload).hexdigest()


def event_path(root, event_id):
    safe_id(event_id, "event ID")
    return os.path.join(root, "events", "{}.json".format(event_id))


def receipt_path(root, event_id):
    safe_id(event_id, "event ID")
    return os.path.join(root, "receipts", "{}.json".format(event_id))


def enqueue_event(root, identity):
    event_target(identity)
    event_id = event_identity(identity)
    path = event_path(root, event_id)
    if os.path.exists(path):
        current = read_json(path)
        if current.get("identity") != identity or current.get("event") != event_id:
            fail("event identity collision")
        return event_id, "already-queued"
    event = {
        "schema": 1,
        "event": event_id,
        "identity": identity,
        "created_ns": time.time_ns() if hasattr(time, "time_ns") else int(time.time() * 1e9),
    }
    atomic_json(path, event)
    return event_id, "queued"


def blocked_identity(arguments):
    return {
        "schema": 2,
        "kind": "blocked-root",
        "target": managed_target(arguments.target),
        "runtime": safe_id(arguments.runtime, "runtime"),
        "thread": safe_id(arguments.thread, "thread"),
        "watcher_pid": arguments.watcher_pid,
        "watcher_start": safe_id(arguments.watcher_start, "watcher start"),
        "app_server_pid": arguments.app_server_pid,
        "app_server_start": safe_id(
            arguments.app_server_start, "app-server start"
        ),
        "window_id": safe_window_id(arguments.window_id),
        "window_index": arguments.window_index,
        "pane_id": safe_pane_id(arguments.pane_id),
        "pane_index": arguments.pane_index,
    }


def claude_blocked_identity(arguments):
    return {
        "schema": 2,
        "kind": "claude-pane-blocked",
        "client": "claude",
        "target": managed_target(arguments.target),
        "window_id": safe_window_id(arguments.window_id),
        "window_index": arguments.window_index,
        "pane_id": safe_pane_id(arguments.pane_id),
        "pane_index": arguments.pane_index,
        "pane_pid": arguments.pane_pid,
        "pane_start": safe_id(arguments.pane_start, "pane start"),
        "relaunch": arguments.relaunch,
        "session_id": safe_id(arguments.session_id, "Claude session"),
    }


def run_value(arguments, check=True):
    result = subprocess.run(
        arguments,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if check and result.returncode != 0:
        fail("native metadata command failed")
    return result.stdout.decode("utf-8", "strict")


def remote_control_processes():
    found = []
    try:
        names = os.listdir("/proc")
    except OSError:
        return found
    for name in names:
        if not name.isdigit():
            continue
        info = process_info(int(name))
        if not info or info["uid"] != os.getuid():
            continue
        argv = info["argv"]
        if (
            "app-server" in argv
            and "--remote-control" in argv
            and "--listen" in argv
        ):
            found.append(info)
    return found


def observe_remote_control(root):
    if os.environ.get("HARNESS_TEST_SKIP_DETECTION") == "1":
        return
    processes = remote_control_processes()
    state_path = os.path.join(root, "remote-control.json")
    previous = read_json(state_path, {})
    if len(processes) == 1:
        current = {
            "schema": 1,
            "pid": processes[0]["pid"],
            "start": processes[0]["start"],
            "epoch": int(time.time()),
        }
        atomic_json(state_path, current)
        return
    if len(processes) > 1:
        return
    identity = {
        "schema": 1,
        "kind": "remote-control-absent",
        "last_pid": previous.get("pid", 0),
        "last_start": previous.get("start", "none"),
    }
    enqueue_event(root, identity)


def tmux_mapping():
    output = run_value(
        [
            "tmux",
            "list-panes",
            "-s",
            "-t",
            SESSION_NAME,
            "-F",
            "#{window_index}\t#{window_name}\t#{window_id}\t"
            "#{pane_index}\t"
            + PANE_ROLE_FORMAT
            + "\t#{pane_id}\t#{pane_pid}\t#{pane_current_path}\t#{pane_dead}",
        ],
        check=False,
    )
    rows = []
    for line in output.splitlines():
        fields = line.split("\t")
        if len(fields) != 9:
            continue
        try:
            window_index = int(fields[0])
            pane_index = int(fields[3])
            pane_pid = int(fields[6])
        except ValueError:
            continue
        if not fields[4]:
            continue
        rows.append(
            {
                "window_index": window_index,
                "window_name": fields[1],
                "window_id": fields[2],
                "index": pane_index,
                "name": fields[4],
                "pane_id": fields[5],
                "pane_pid": pane_pid,
                "cwd": fields[7],
                "dead": fields[8] == "1",
            }
        )
    if len(rows) != len(EXPECTED):
        return None
    if sorted(
        (row["window_index"], row["window_name"], row["index"], row["name"])
        for row in rows
    ) != sorted(
        (window_index, window_name, index, name)
        for name, window_index, window_name, index in EXPECTED
    ) or any(row["dead"] for row in rows):
        return None
    mapping = {}
    for row in rows:
        if not cwd_allowed(row["name"], row["cwd"]):
            return None
        info = process_info(row["pane_pid"])
        if not info:
            return None
        argv = info["argv"]
        try:
            remote = argv.index("--remote-session")
            thread_id = argv[remote + 1]
        except (ValueError, IndexError):
            return None
        if not SAFE_ID.match(thread_id):
            return None
        mapping[row["name"]] = {
            "index": row["index"],
            "pane_id": row["pane_id"],
            "window_index": row["window_index"],
            "window_id": row["window_id"],
            "window_name": row["window_name"],
            "thread": thread_id,
            "cwd": row["cwd"],
            "native_cwd": row["cwd"] == TARGET_PATHS[row["name"]],
        }
    return mapping


def state_database():
    codex_home = os.environ.get("CODEX_HOME", os.path.expanduser("~/.codex"))
    return os.path.join(codex_home, "state_5.sqlite")


def rollout_eligible(path, codex_home):
    if not path or not os.path.isabs(path):
        return False
    sessions = os.path.realpath(os.path.join(codex_home, "sessions"))
    resolved = os.path.realpath(path)
    try:
        if os.path.commonpath((sessions, resolved)) != sessions:
            return False
        info = os.lstat(path)
    except (OSError, ValueError):
        return False
    return (
        stat.S_ISREG(info.st_mode)
        and not stat.S_ISLNK(info.st_mode)
        and info.st_uid == os.getuid()
        and info.st_nlink == 1
    )


def phone_mirror_snapshot(mapping, database, processes, target_paths, codex_home):
    def mapped_cwd_allowed(role, path):
        return path == target_paths[role]

    now = int(time.time())
    owner = process_info(os.getpid())
    receipt = {
        "schema": 1,
        "epoch": now,
        "owner_pid": os.getpid(),
        "owner_start": owner["start"] if owner else "unknown",
        "status": "unavailable",
        "remote_control": {"exactly_one": len(processes) == 1},
        "canonical_count": len(mapping) if mapping else 0,
        "active_top_level_count": None,
        "roles": {},
        "mismatch_classes": [],
    }
    if len(processes) == 1:
        receipt["remote_control"].update(
            {"pid": processes[0]["pid"], "start": processes[0]["start"]}
        )
    else:
        receipt["mismatch_classes"].append("remote-control-count")
    for role, window_index, window_name, index in EXPECTED:
        mapped = bool(
            mapping
            and role in mapping
            and mapping[role].get("index") == index
            and mapping[role].get("pane_id")
            and mapping[role].get("window_index") == window_index
            and mapping[role].get("window_name") == window_name
            and mapped_cwd_allowed(role, mapping[role].get("cwd", ""))
        )
        receipt["roles"][role] = {
            "tmux_mapping": mapped,
            "unarchived": False,
            "exact_name": False,
            "exact_cwd": False,
            "rollout_location": False,
            "rollout_exists": False,
            "interactive_source": False,
            "initialized_turn": False,
            "native_cwd": False,
        }
    if not mapping:
        receipt["mismatch_classes"].append("tmux-topology")
        return receipt, None
    if not os.path.isfile(database):
        receipt["mismatch_classes"].append("database-unavailable")
        return receipt, None

    active = []
    canonical = sorted(value["thread"] for value in mapping.values())
    canonical_rows = {}
    try:
        connection = sqlite3.connect(
            "file:{}?mode=ro".format(database), uri=True, timeout=1
        )
        roots = sorted(set(target_paths.values()))
        placeholders = ",".join("?" for _value in roots)
        source_placeholders = ",".join("?" for _value in INTERACTIVE_SOURCES)
        active = sorted(
            row[0]
            for row in connection.execute(
                "SELECT id FROM threads "
                "WHERE cwd IN ({}) AND archived = 0 "
                "AND source IN ({}) ORDER BY id".format(
                    placeholders, source_placeholders
                ),
                tuple(roots) + INTERACTIVE_SOURCES,
            ).fetchall()
        )
        for role, *_location in EXPECTED:
            canonical_rows[role] = connection.execute(
                "SELECT archived, COALESCE(NULLIF(name, ''), title), cwd, "
                "source, rollout_path, tokens_used FROM threads WHERE id = ?",
                (mapping[role]["thread"],),
            ).fetchone()
    except sqlite3.Error:
        receipt["mismatch_classes"].append("database-query")
        return receipt, None
    finally:
        if "connection" in locals():
            connection.close()

    receipt["active_top_level_count"] = len(active)
    extras = sorted(set(active) - set(canonical))
    missing = sorted(set(canonical) - set(active))
    if len(active) != len(EXPECTED):
        receipt["mismatch_classes"].append("active-top-level-count")
    if extras:
        receipt["mismatch_classes"].append("extra-active-root")
    if missing:
        receipt["mismatch_classes"].append("canonical-root-inactive")

    role_mismatches = {}
    for role, *_location in EXPECTED:
        checks = receipt["roles"][role]
        row = canonical_rows.get(role)
        if row:
            rollout_path = row[4]
            checks.update(
                {
                    "unarchived": row[0] == 0,
                    "exact_name": row[1] == role,
                    "exact_cwd": row[2] == mapping[role]["cwd"],
                    "native_cwd": row[2] == target_paths[role],
                    "rollout_location": bool(
                        rollout_path
                        and os.path.isabs(rollout_path)
                        and os.path.commonpath(
                            (
                                os.path.realpath(
                                    os.path.join(codex_home, "sessions")
                                ),
                                os.path.realpath(rollout_path),
                            )
                        )
                        == os.path.realpath(os.path.join(codex_home, "sessions"))
                    ),
                    "rollout_exists": rollout_eligible(
                        rollout_path, codex_home
                    ),
                    "interactive_source": row[3] in INTERACTIVE_SOURCES,
                    "initialized_turn": isinstance(row[5], int) and row[5] > 0,
                }
            )
        failed = sorted(
            name
            for name, value in checks.items()
            if not value
        )
        if failed:
            role_mismatches[role] = failed
            receipt["mismatch_classes"].extend(
                "{}:{}".format(name, role) for name in failed
            )

    if (
        receipt["remote_control"]["exactly_one"]
        and not extras
        and not missing
        and len(active) == len(EXPECTED)
        and not role_mismatches
    ):
        receipt["status"] = "healthy"
    else:
        receipt["status"] = "degraded"
    receipt["mismatch_classes"] = sorted(set(receipt["mismatch_classes"]))
    drift = {
        "schema": 1,
        "kind": "phone-mirror-drift",
        "canonical": [
            {
                "role": role,
                "thread": mapping[role]["thread"],
                "pane_id": mapping[role]["pane_id"],
                "pane_index": mapping[role]["index"],
                "window_id": mapping[role]["window_id"],
                "window_index": mapping[role]["window_index"],
                "cwd": mapping[role]["cwd"],
                "native_cwd": mapping[role]["cwd"] == target_paths[role],
            }
            for role, *_location in EXPECTED
        ],
        "extras": extras,
        "missing": missing,
        "mismatch_classes": receipt["mismatch_classes"],
    }
    return receipt, drift


def pending_event_for_kind(root, kind):
    for event in event_files(root):
        if event["identity"].get("kind") != kind:
            continue
        receipt = read_json(receipt_path(root, event["event"]), {})
        if receipt.get("phase") not in TERMINAL_PHASES:
            return event
    return None


def defer_queued_event(root, event, reason):
    path = receipt_path(root, event["event"])
    if os.path.exists(path):
        return False
    atomic_json(
        path,
        {
            "schema": 1,
            "event": event["event"],
            "phase": "deferred",
            "reason": reason,
            "epoch": int(time.time()),
        },
    )
    return True


def observe_mirror(root):
    if os.environ.get("HARNESS_TEST_SKIP_DETECTION") == "1":
        return
    mapping = tmux_mapping()
    database = state_database()
    codex_home = os.environ.get("CODEX_HOME", os.path.expanduser("~/.codex"))
    receipt, drift = phone_mirror_snapshot(
        mapping,
        database,
        remote_control_processes(),
        TARGET_PATHS,
        codex_home,
    )
    atomic_json(os.path.join(root, "phone-mirror.json"), receipt)
    pending = pending_event_for_kind(root, "phone-mirror-drift")
    if receipt["status"] == "healthy":
        if pending:
            defer_queued_event(root, pending, "drift-resolved")
        return
    if drift and receipt["status"] == "degraded":
        if not pending:
            enqueue_event(root, drift)


def worker_prompt(event):
    identity = event["identity"]
    serialized = json.dumps(identity, sort_keys=True, separators=(",", ":"))
    target = event_target(identity)
    target_repository = TARGET_PATHS[target]
    return """\
You are the dedicated Local Codex recovery worker for one immutable event.
Do not rely on prior chat history. Confirm that the Git repository root is
exactly /home/rioyokota/harness, then read AGENTS.md, TODO.md, the
recover-codex-unsafe-tail SKILL.md, and its protocol completely before any
target action.

Immutable event:
{event}

Exact managed target: {target}
Exact target repository: {target_repository}

After reconstructing the Harness control state, read the target repository's
complete root instructions and declared durable ledger from that exact
repository. Reconcile its branch, worktree, recent commits, and mutable
external state, and continue only its first recorded unverified action.

This is a bounded live-recovery turn, not general repository work. Do not edit
Git-tracked files, settings, credentials, plugins, connectors, MCP state, or
unrelated processes. Never inspect tmux pane or transcript content. Never
reconstruct or replay a rejected prompt. Never retry an acknowledged or
ambiguous write, launch, signal, archive, or submission. Never invoke
`codex delete`, a process-group signal, SIGKILL, or a forced remote-control
restart. Serialize lifecycle operations with the current-user mode-0600
agent-message.lock and use value-free receipts.

For kind=blocked-root, revalidate every event identity against current tmux,
process, watcher, rollout, app-server, attachment, Git, and durable-ledger
state. Healthy sibling threads may be active and do not need to be idle.
Multiple blocked roots are handled by separate serialized events. The exact
target pane itself must not be selected by an attached client. If exact
blocked/unsafe-tail evidence remains, use bridge-first fresh-root recovery:
create and accept one distinct provisional root/window/runtime before
promotion. Move only the fully accepted provisional pane into
its profile-declared `harness` session location; assign its exact pane-local
`@harness_target` role, title, and index; preserve peer panes and attached
clients; and retire only the old
exact TUI leaf. Reversibly archive the retired blocked root and any rejected
helper-created provisional root after exact zero-reference and inactivity
proof. Never identify a target by the shared window alone.

After successful promotion and healthy canonical readback, submit exactly one
deduplicated continuation instruction to the recovered canonical thread. The
instruction must say: read all applicable instructions and durable ledgers,
inspect the current branch, worktree, recent commits, and mutable external
state, reconcile side effects that may already have occurred, then continue
only the first recorded unverified action. It must explicitly forbid
reconstructing or replaying the rejected prompt. Reserve before insertion,
wait at least one second for paste handling, submit C-m separately, and never
resubmit an acknowledged or ambiguous continuation.

For kind=remote-control-absent, revalidate confirmed absence of every
current-user remote-control app-server identity and reciprocal project peer.
Run native `codex remote-control start --json` at most once after the
pre-write receipt, then require one new exact identity and redacted doctor
readiness. If any live server identity exists, report deferred and do not
signal, stop, or restart it. Pairing or account mutation is forbidden.

For kind=mirror-drift, use the three exact target-profile repository roots and
their current target-allowed tmux working directories as canonical.
Subagent roots are excluded. Reversibly archive only roots already classified
as baseline or helper-created temporary/retired roots in TODO.md or durable
helper receipts, after exact zero-process-reference and structural inactivity
proof. Preserve every unclassified root. Restore canonical names/archive flags
only through one read-before/write/read-after transaction; ambiguous writes
are not retried.

For kind=phone-mirror-drift, first require exactly one source-ineligible
canonical root, two healthy interactive peers, one unchanged app-server
identity, exact canonical tmux topology, an unattached idle target, and no
unclassified extra active root. A source value is immutable: never rewrite it
in SQLite or a rollout. Create one distinct interactive app-server root and
provisional tmux window by the bridge-first protocol, submit only the generic
cold-start reconstruction instruction from complete repository instructions,
durable ledgers, Git, and mutable external state, and preserve both roots.
Never reconstruct or replay prior task content. Stop deferred after host
eligibility validation so the owner can confirm physical-phone visibility;
never rename, signal, archive, or retire the old canonical root before that
separate confirmation. Unknown, multiple-target, attached, active,
ambiguous, or physical-phone-only failures are report-only.

Finish with one value-free status line beginning RECOVERY_RESULT and exit
nonzero on any failed or ambiguous gate.
""".format(
        event=serialized,
        target=target,
        target_repository=target_repository,
    )


def codex_command():
    override = os.environ.get("HARNESS_TEST_CODEX")
    if override:
        if os.environ.get("HARNESS_TESTING") != "1" or not os.path.isabs(override):
            fail("test Codex override is unsafe")
        binary = override
    else:
        binary = os.path.expanduser("~/.local/bin/codex")
    if not os.path.isfile(binary) or not os.access(binary, os.X_OK):
        fail("Codex launcher is unavailable")
    return [
        binary,
        "exec",
        "--ephemeral",
        "-C",
        TARGET_ROOT,
        "-m",
        "sol",
        "-c",
        'model_reasoning_effort="high"',
        "-c",
        "approval_policy={}".format(APPROVAL_POLICY),
        "-s",
        "danger-full-access",
        "-",
    ]


def claude_recovery_command(identity):
    override = os.environ.get("HARNESS_TEST_CLAUDE_RECOVERY")
    if override:
        if os.environ.get("HARNESS_TESTING") != "1" or not os.path.isabs(override):
            fail("test Claude recovery override is unsafe")
        binary = override
    else:
        binary = os.path.join(
            CONTROL_ROOT, "libexec", "harness-claude-pane-recovery"
        )
    if not os.path.isfile(binary) or not os.access(binary, os.X_OK):
        fail("Claude pane recovery worker is unavailable")
    return [
        binary,
        "--target",
        identity["target"],
        "--window-id",
        identity["window_id"],
        "--window-index",
        str(identity["window_index"]),
        "--pane-id",
        identity["pane_id"],
        "--pane-index",
        str(identity["pane_index"]),
        "--pane-pid",
        str(identity["pane_pid"]),
        "--pane-start",
        identity["pane_start"],
        "--relaunch",
        identity["relaunch"],
        "--session-id",
        identity["session_id"],
    ]


def event_files(root):
    paths = []
    directory = os.path.join(root, "events")
    for name in os.listdir(directory):
        if not name.endswith(".json"):
            continue
        path = os.path.join(directory, name)
        event = read_json(path)
        if (
            not isinstance(event, dict)
            or event.get("schema") != 1
            or event.get("event") != name[:-5]
            or event_identity(event.get("identity")) != event.get("event")
        ):
            fail("queued event is malformed")
        event_target(event["identity"])
        paths.append((event.get("created_ns", 0), name, event))
    return [value[2] for value in sorted(paths)]


def reconcile_started(root, event):
    path = receipt_path(root, event["event"])
    receipt = read_json(path)
    if not receipt:
        return False
    phase = receipt.get("phase")
    if phase in TERMINAL_PHASES:
        return True
    if phase == "launch-reserved":
        receipt["phase"] = "ambiguous"
        receipt["reason"] = "launch-result-unknown"
        receipt["epoch"] = int(time.time())
        atomic_json(path, receipt)
        return True
    if phase == "worker-started":
        worker = process_info(receipt.get("worker_pid", 0))
        if (
            worker
            and worker["uid"] == os.getuid()
            and worker["start"] == receipt.get("worker_start")
        ):
            return True
        receipt["phase"] = "ambiguous"
        receipt["reason"] = "worker-result-unknown"
        receipt["epoch"] = int(time.time())
        atomic_json(path, receipt)
        return True
    fail("event receipt phase is malformed")


def process_event(root, event):
    claude_event = (
        event["identity"].get("kind") == "claude-pane-blocked"
    )
    if claude_event:
        prompt = b""
        worker_command = claude_recovery_command(event["identity"])
    else:
        prompt = worker_prompt(event).encode("utf-8")
        worker_command = codex_command()
    if reconcile_started(root, event):
        return False
    event_id = event["event"]
    receipt = {
        "schema": 1,
        "event": event_id,
        "phase": "launch-reserved",
        "reason": "worker-not-yet-acknowledged",
        "epoch": int(time.time()),
    }
    path = receipt_path(root, event_id)
    atomic_json(path, receipt)
    log_path = os.path.join(root, "logs", "{}.log".format(event_id))
    flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    old = os.umask(0o077)
    try:
        descriptor = os.open(log_path, flags, 0o600)
    finally:
        os.umask(old)
    worker_environment = os.environ.copy()
    for variable in (
        "HARNESS_ROOT",
        "HARNESS_CONTROL_ROOT",
        "HARNESS_TARGET_ROOT",
        "HARNESS_CODEX_RELEASE_COMMIT",
        "HARNESS_CODEX_RELEASE_PAYLOAD",
        "HARNESS_CODEX_RELEASE_TARGET",
        "HARNESS_TEST_CODEX_RELEASE_ROOT",
        "HARNESS_TEST_FORCE_CODEX_RELEASE",
    ):
        worker_environment.pop(variable, None)
    try:
        process = subprocess.Popen(
            worker_command,
            cwd=TARGET_ROOT,
            env=worker_environment,
            stdin=subprocess.PIPE,
            stdout=descriptor,
            stderr=subprocess.STDOUT,
            close_fds=True,
        )
        info = process_info(process.pid)
        if not info or info["uid"] != os.getuid():
            receipt["phase"] = "ambiguous"
            receipt["reason"] = "worker-identity-unavailable"
            atomic_json(path, receipt)
            process.stdin.close()
            return True
        receipt.update(
            {
                "phase": "worker-started",
                "reason": "worker-running",
                "worker_pid": process.pid,
                "worker_start": info["start"],
                "epoch": int(time.time()),
            }
        )
        atomic_json(path, receipt)
        process.stdin.write(prompt)
        process.stdin.close()
        returncode = process.wait()
        accepted = False
        try:
            with open(log_path, "r") as stream:
                for line in stream:
                    if ACCEPTED_RESULT.match(line.rstrip("\n")):
                        accepted = True
        except (IOError, OSError, UnicodeError):
            accepted = False
        receipt.update(
            {
                "phase": "completed" if returncode == 0 and accepted else "failed",
                "reason": (
                    "worker-success"
                    if returncode == 0 and accepted
                    else "worker-result-unaccepted"
                    if returncode == 0
                    else "worker-failed"
                ),
                "returncode": returncode,
                "epoch": int(time.time()),
            }
        )
        atomic_json(path, receipt)
        return True
    except (IOError, OSError, subprocess.SubprocessError):
        receipt["phase"] = "ambiguous"
        receipt["reason"] = "worker-launch-ambiguous"
        receipt["epoch"] = int(time.time())
        atomic_json(path, receipt)
        return True
    finally:
        os.close(descriptor)


def event_pending(event, receipt, auto_mirror):
    if receipt.get("phase") in TERMINAL_PHASES:
        return False
    return (
        event["identity"].get("kind") != "phone-mirror-drift"
        or auto_mirror
    )


def summary(root, owner_pid, phase):
    counts = {
        "queued": 0,
        "completed": 0,
        "failed": 0,
        "ambiguous": 0,
        "deferred": 0,
        "running": 0,
    }
    for event in event_files(root):
        receipt = read_json(receipt_path(root, event["event"]), {})
        current = receipt.get("phase", "queued")
        if current in ("launch-reserved", "worker-started"):
            current = "running"
        if current in counts:
            counts[current] += 1
    return {
        "schema": 1,
        "phase": phase,
        "owner_pid": owner_pid,
        "epoch": int(time.time()),
        "counts": counts,
    }


def print_summary(value):
    counts = value["counts"]
    print(
        "CODEX_RECOVERY_HELPER phase={} queued={} running={} completed={} "
        "failed={} ambiguous={} deferred={} owner_pid={}".format(
            value["phase"],
            counts["queued"],
            counts["running"],
            counts["completed"],
            counts["failed"],
            counts["ambiguous"],
            counts["deferred"],
            value["owner_pid"],
        )
    )


def parse_arguments():
    parser = argparse.ArgumentParser(prog="harness codex-recovery-helper")
    modes = parser.add_mutually_exclusive_group(required=True)
    modes.add_argument("--run", action="store_true")
    modes.add_argument("--once", action="store_true")
    modes.add_argument("--status", action="store_true")
    modes.add_argument("--enqueue-blocked", action="store_true")
    modes.add_argument("--enqueue-claude-blocked", action="store_true")
    parser.add_argument("--interval", type=int, default=30)
    parser.add_argument("--auto-mirror", action="store_true")
    parser.add_argument("--target")
    parser.add_argument("--runtime")
    parser.add_argument("--thread")
    parser.add_argument("--watcher-pid", type=int)
    parser.add_argument("--watcher-start")
    parser.add_argument("--app-server-pid", type=int)
    parser.add_argument("--app-server-start")
    parser.add_argument("--window-id")
    parser.add_argument("--window-index", type=int)
    parser.add_argument("--pane-id")
    parser.add_argument("--pane-index", type=int)
    parser.add_argument("--pane-pid", type=int)
    parser.add_argument("--pane-start")
    parser.add_argument("--relaunch", choices=("exact",))
    parser.add_argument("--session-id")
    arguments = parser.parse_args()
    if not 5 <= arguments.interval <= 3600:
        parser.error("--interval must be between 5 and 3600 seconds")
    shared_fields = (
        "target",
        "window_id",
        "window_index",
        "pane_id",
        "pane_index",
    )
    codex_fields = (
        "runtime",
        "thread",
        "watcher_pid",
        "watcher_start",
        "app_server_pid",
        "app_server_start",
    )
    claude_fields = ("pane_pid", "pane_start", "relaunch", "session_id")
    if arguments.enqueue_blocked:
        if any(
            getattr(arguments, field) is None
            for field in shared_fields + codex_fields
        ):
            parser.error("--enqueue-blocked requires the exact blocked identity")
        if any(getattr(arguments, field) is not None for field in claude_fields):
            parser.error("Claude identity arguments require --enqueue-claude-blocked")
    elif arguments.enqueue_claude_blocked:
        if any(
            getattr(arguments, field) is None
            for field in shared_fields + claude_fields
        ):
            parser.error(
                "--enqueue-claude-blocked requires the exact blocked identity"
            )
        if any(getattr(arguments, field) is not None for field in codex_fields):
            parser.error("blocked identity arguments require --enqueue-blocked")
    elif any(
        getattr(arguments, field) is not None
        for field in shared_fields + codex_fields + claude_fields
    ):
        parser.error("blocked identity arguments require an enqueue mode")
    if arguments.auto_mirror and (
        arguments.status or arguments.enqueue_blocked
        or arguments.enqueue_claude_blocked
    ):
        parser.error("--auto-mirror requires --run or --once")
    return arguments


def main():
    arguments = parse_arguments()
    blocked = blocked_identity(arguments) if arguments.enqueue_blocked else None
    if arguments.enqueue_claude_blocked:
        blocked = claude_blocked_identity(arguments)
    root = runtime_root()
    if arguments.enqueue_blocked or arguments.enqueue_claude_blocked:
        _event, action = enqueue_event(root, blocked)
        print("CODEX_RECOVERY_HELPER enqueue={}".format(action))
        return 0
    helper_receipt = os.path.join(root, "helper.json")
    if arguments.status:
        value = read_json(helper_receipt)
        if not value:
            print("CODEX_RECOVERY_HELPER phase=absent")
            return 1
        owner = process_info(value.get("owner_pid", 0))
        if (
            not owner
            or owner["uid"] != os.getuid()
            or int(time.time()) - value.get("epoch", 0) > 120
        ):
            value["phase"] = "stale"
        print_summary(value)
        return 0 if value["phase"] in ("idle", "working") else 1

    stopping = [False]

    def stop(_signum, _frame):
        stopping[0] = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGHUP, stop)
    with exclusive_lock(os.path.join(root, "helper.lock"), nonblocking=True):
        while not stopping[0]:
            observe_remote_control(root)
            observe_mirror(root)
            events = event_files(root)
            pending = []
            for event in events:
                receipt = read_json(receipt_path(root, event["event"]), {})
                if event_pending(event, receipt, arguments.auto_mirror):
                    pending.append(event)
            phase = "working" if pending else "idle"
            value = summary(root, os.getpid(), phase)
            atomic_json(helper_receipt, value)
            if pending:
                process_event(root, pending[0])
                updated = summary(root, os.getpid(), "idle")
                if updated["counts"]["running"]:
                    updated["phase"] = "working"
                value = updated
                atomic_json(helper_receipt, value)
            if arguments.once:
                print_summary(value)
                return 0
            deadline = time.monotonic() + arguments.interval
            while not stopping[0] and time.monotonic() < deadline:
                time.sleep(min(0.2, deadline - time.monotonic()))
        value = summary(root, os.getpid(), "stopped")
        atomic_json(helper_receipt, value)
        print_summary(value)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (
        HelperError,
        TargetError,
        ValueError,
        KeyError,
        OSError,
        sqlite3.Error,
    ) as error:
        print("harness: Codex recovery helper failed: {}".format(error), file=sys.stderr)
        sys.exit(2)
