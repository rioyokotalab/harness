#!/bin/sh
set -eu
umask 077

SELF_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
HARNESS_ROOT=${HARNESS_ROOT:-$(CDPATH='' cd -- "$SELF_DIR/.." && pwd)}

usage() {
    cat >&2 <<'EOF'
Usage: harness fleet-health
EOF
}

case "$#" in
    0) ;;
    1)
        case "$1" in -h|--help) usage; exit 0 ;; *) usage; exit 2 ;; esac
        ;;
    *) usage; exit 2 ;;
esac

status_source_file=$HARNESS_ROOT/profiles/fleet-status-sources.tsv
maintenance_file=$HARNESS_ROOT/profiles/fleet-maintenance.tsv
[ -f "$status_source_file" ] && [ ! -L "$status_source_file" ] ||
    {
        echo "harness fleet-health: status source registry is unavailable" >&2
        exit 2
    }
[ -f "$maintenance_file" ] && [ ! -L "$maintenance_file" ] ||
    {
        echo "harness fleet-health: maintenance registry is unavailable" >&2
        exit 2
    }
case ${HARNESS_FLEET_HEALTH_NOW_EPOCH:-} in
    '')
        now_epoch=$(date +%s)
        ;;
    *[!0-9]*)
        echo "harness fleet-health: test time is malformed" >&2
        exit 2
        ;;
    *)
        [ "${HARNESS_TESTING:-0}" = 1 ] ||
            {
                echo "harness fleet-health: test time requires HARNESS_TESTING=1" >&2
                exit 2
            }
        now_epoch=$HARNESS_FLEET_HEALTH_NOW_EPOCH
        ;;
esac

status_source_for() {
    awk -F'|' -v wanted="$1" '
        BEGIN { invalid = 0; found = 0 }
        /^#/ || NF == 0 { next }
        NF != 3 ||
        $1 !~ /^[a-z][a-z0-9._-]*$/ ||
        $2 !~ /^https:\/\/[^[:space:]|]+$/ ||
        $3 !~ /^[a-z][a-z-]*$/ ||
        seen[$1]++ {
            invalid = 1
            next
        }
        $1 == wanted {
            print $2
            found++
        }
        END {
            if (invalid || found != 1) exit 2
        }
    ' "$status_source_file"
}

active_maintenance_for() {
    awk -F'|' -v wanted="$1" -v now="$now_epoch" '
        BEGIN { invalid = 0; active = 0 }
        /^#/ || NF == 0 { next }
        NF != 6 ||
        $1 !~ /^[a-z][a-z0-9._-]*$/ ||
        $2 !~ /^[0-9]+$/ ||
        $3 !~ /^[0-9]+$/ ||
        $4 !~ /^[0-9T:+-]+$/ ||
        $5 !~ /^https:\/\/[^[:space:]|]+$/ ||
        $6 !~ /^[a-z0-9-]+$/ ||
        ($2 + 0) >= ($3 + 0) {
            invalid = 1
            next
        }
        {
            start = $2 + 0
            stop = $3 + 0
            for (slot = 1; slot <= count[$1]; slot++) {
                if (start < ends[$1, slot] && stop > starts[$1, slot]) {
                    invalid = 1
                }
            }
            count[$1]++
            starts[$1, count[$1]] = start
            ends[$1, count[$1]] = stop
        }
        $1 == wanted && now >= ($2 + 0) && now < ($3 + 0) {
            print
            active++
        }
        END {
            if (invalid || active > 1) exit 2
        }
    ' "$maintenance_file"
}

ab_status_url=$(status_source_for ab) &&
    ab2_status_url=$(status_source_for ab2) &&
    ri_status_url=$(status_source_for ri) &&
    al_status_url=$(status_source_for al) &&
    rc_status_url=$(status_source_for rc) &&
    t4_status_url=$(status_source_for t4) &&
    abq_status_url=$(status_source_for abq) ||
    {
        echo "harness fleet-health: status source registry is malformed" >&2
        exit 2
    }

ab_maintenance=$(active_maintenance_for ab) &&
    ab2_maintenance=$(active_maintenance_for ab2) &&
    ri_maintenance=$(active_maintenance_for ri) &&
    al_maintenance=$(active_maintenance_for al) &&
    rc_maintenance=$(active_maintenance_for rc) &&
    t4_maintenance=$(active_maintenance_for t4) &&
    abq_maintenance=$(active_maintenance_for abq) ||
    {
        echo "harness fleet-health: maintenance registry is malformed" >&2
        exit 2
    }

maintenance_metadata() {
    if [ -z "$1" ]; then
        printf '|\n'
        return
    fi
    maintenance_rest=${1#*|}
    maintenance_rest=${maintenance_rest#*|}
    maintenance_rest=${maintenance_rest#*|}
    maintenance_end=${maintenance_rest%%|*}
    maintenance_rest=${maintenance_rest#*|}
    maintenance_url=${maintenance_rest%%|*}
    printf '%s|%s\n' "$maintenance_end" "$maintenance_url"
}

ab_maintenance_meta=$(maintenance_metadata "$ab_maintenance")
ab_maintenance_end=${ab_maintenance_meta%%|*}
ab_maintenance_url=${ab_maintenance_meta#*|}
ab2_maintenance_meta=$(maintenance_metadata "$ab2_maintenance")
ab2_maintenance_end=${ab2_maintenance_meta%%|*}
ab2_maintenance_url=${ab2_maintenance_meta#*|}
ri_maintenance_meta=$(maintenance_metadata "$ri_maintenance")
ri_maintenance_end=${ri_maintenance_meta%%|*}
ri_maintenance_url=${ri_maintenance_meta#*|}
al_maintenance_meta=$(maintenance_metadata "$al_maintenance")
al_maintenance_end=${al_maintenance_meta%%|*}
al_maintenance_url=${al_maintenance_meta#*|}
rc_maintenance_meta=$(maintenance_metadata "$rc_maintenance")
rc_maintenance_end=${rc_maintenance_meta%%|*}
rc_maintenance_url=${rc_maintenance_meta#*|}
t4_maintenance_meta=$(maintenance_metadata "$t4_maintenance")
t4_maintenance_end=${t4_maintenance_meta%%|*}
t4_maintenance_url=${t4_maintenance_meta#*|}
abq_maintenance_meta=$(maintenance_metadata "$abq_maintenance")
abq_maintenance_end=${abq_maintenance_meta%%|*}
abq_maintenance_url=${abq_maintenance_meta#*|}

socket_owner() {
    case $(uname -s) in
        Darwin) stat -f '%u' -- "$1" ;;
        *) stat -c '%u' -- "$1" ;;
    esac
}

safe_agent_socket() {
    [ -n "$1" ] && [ -S "$1" ] && [ "$(socket_owner "$1")" = "$(id -u)" ]
}

resolve_agent_socket() {
    if safe_agent_socket "${SSH_AUTH_SOCK:-}"; then
        printf '%s\n' "$SSH_AUTH_SOCK"
        return
    fi
    if [ -n "${TMUX_PANE:-}" ] && command -v tmux >/dev/null 2>&1; then
        pane_socket=$(tmux show-environment -t "$TMUX_PANE" SSH_AUTH_SOCK 2>/dev/null || true)
        case "$pane_socket" in
            SSH_AUTH_SOCK=*) pane_socket=${pane_socket#SSH_AUTH_SOCK=} ;;
            *) pane_socket= ;;
        esac
        if safe_agent_socket "$pane_socket"; then
            printf '%s\n' "$pane_socket"
            return
        fi
    fi
    if [ "${HARNESS_LOGICAL_HOST:-}" = local ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
        fixed_socket=$XDG_RUNTIME_DIR/openssh_agent
        if safe_agent_socket "$fixed_socket"; then
            printf '%s\n' "$fixed_socket"
            return
        fi
    fi
    return 1
}

agent_socket=$(resolve_agent_socket 2>/dev/null || true)

probe_ordinary() {
    [ -n "$agent_socket" ] || return 1
    SSH_AUTH_SOCK=$agent_socket ssh -x -o BatchMode=yes -o ConnectTimeout=8 \
        -o ConnectionAttempts=1 "$1" true >/dev/null 2>&1
}

probe_independent() {
    [ -n "$agent_socket" ] || return 1
    SSH_AUTH_SOCK=$agent_socket ssh -x -o BatchMode=yes -o ConnectTimeout=8 \
        -o ConnectionAttempts=1 -o ControlMaster=no -o ControlPath=none \
        "$1" true >/dev/null 2>&1
}

probe_pair() {
    probe_independent "$1" && probe_independent "$2"
}

probe_al() {
    "$HARNESS_ROOT/bin/harness" al-session --status >/dev/null 2>&1 &&
        probe_ordinary al
}

run_fleet_probe() {
    case "$1" in
        ab|ab2|ri|rc|t4) probe_ordinary "$1" ;;
        al) probe_al ;;
        abq) probe_pair abq abq2 ;;
        aist) probe_pair aist aist2 ;;
        home) probe_pair home home2 ;;
        office) probe_pair office office2 ;;
        riken) probe_pair riken riken2 ;;
        *) return 2 ;;
    esac
}

run_queued_probe() {
    trap - 0 HUP INT TERM
    queued_name=$1
    if run_fleet_probe "$queued_name"; then
        queued_status=pass
    else
        queued_status=fail
    fi
    printf '%s|%s\n' "$queued_name" "$queued_status" >&3
}

record_probe_result() {
    case "$1:$2" in
        ab:pass|ab:fail) ab_status=$2 ;;
        ab2:pass|ab2:fail) ab2_status=$2 ;;
        ri:pass|ri:fail) ri_status=$2 ;;
        al:pass|al:fail) al_status=$2 ;;
        rc:pass|rc:fail) rc_status=$2 ;;
        t4:pass|t4:fail) t4_status=$2 ;;
        abq:pass|abq:fail) abq_status=$2 ;;
        aist:pass|aist:fail) aist_status=$2 ;;
        home:pass|home:fail) home_status=$2 ;;
        office:pass|office:fail) office_status=$2 ;;
        riken:pass|riken:fail) riken_status=$2 ;;
        *)
            echo "harness fleet-health: probe queue returned malformed state" >&2
            return 2
            ;;
    esac
}

local_status=pass
set --
if [ -n "$ab_maintenance" ]; then
    ab_status=maintenance
else
    set -- "$@" ab
fi
if [ -n "$ab2_maintenance" ]; then
    ab2_status=maintenance
else
    set -- "$@" ab2
fi
if [ -n "$ri_maintenance" ]; then
    ri_status=maintenance
else
    set -- "$@" ri
fi

if [ -n "$al_maintenance" ]; then
    al_status=maintenance
else
    set -- "$@" al
fi
if [ -n "$rc_maintenance" ]; then
    rc_status=maintenance
else
    set -- "$@" rc
fi
if [ -n "$t4_maintenance" ]; then
    t4_status=maintenance
else
    set -- "$@" t4
fi
if [ -n "$abq_maintenance" ]; then
    abq_status=maintenance
else
    set -- "$@" abq
fi

set -- "$@" aist home office riken

queue_dir=$(mktemp -d "${TMPDIR:-/tmp}/harness-fleet-health.XXXXXX") ||
    {
        echo "harness fleet-health: probe queue is unavailable" >&2
        exit 2
    }
completion_pipe=$queue_dir/completions
queue_fd_open=0

cleanup_probe_queue() {
    cleanup_status=0
    if [ "$queue_fd_open" -eq 1 ]; then
        exec 3>&-
        queue_fd_open=0
    fi
    if [ -p "$completion_pipe" ]; then
        unlink "$completion_pipe" || cleanup_status=1
    fi
    if [ -d "$queue_dir" ]; then
        rmdir "$queue_dir" || cleanup_status=1
    fi
    return "$cleanup_status"
}

cleanup_probe_queue_on_exit() {
    queue_exit_status=$?
    trap - 0 HUP INT TERM
    if ! cleanup_probe_queue && [ "$queue_exit_status" -eq 0 ]; then
        queue_exit_status=2
    fi
    exit "$queue_exit_status"
}

trap cleanup_probe_queue_on_exit 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

mkfifo "$completion_pipe" ||
    {
        echo "harness fleet-health: probe queue is unavailable" >&2
        exit 2
    }
exec 3<>"$completion_pipe"
queue_fd_open=1

# Admission is FIFO and output is rendered later in canonical node order.
# Completion only frees a slot; it never changes which probe is admitted next.
max_probes=4
active_probes=0
while [ "$#" -gt 0 ] || [ "$active_probes" -gt 0 ]; do
    while [ "$#" -gt 0 ] && [ "$active_probes" -lt "$max_probes" ]; do
        run_queued_probe "$1" &
        active_probes=$((active_probes + 1))
        shift
    done
    if [ "$active_probes" -gt 0 ]; then
        if ! IFS='|' read -r completed_name completed_status <&3; then
            echo "harness fleet-health: probe queue did not complete" >&2
            exit 2
        fi
        record_probe_result "$completed_name" "$completed_status"
        active_probes=$((active_probes - 1))
    fi
done
wait
cleanup_probe_queue ||
    {
        echo "harness fleet-health: probe queue cleanup failed" >&2
        exit 2
    }
trap - 0 HUP INT TERM

print_remote_linux() {
    case "$2" in
        maintenance)
            printf 'FLEET_HEALTH node=%s class=linux status=maintenance routes=skipped/%s maintenance_end=%s status_url=%s\n' \
                "$1" "$3" "$4" "$5"
        ;;
        fail)
            printf 'FLEET_HEALTH node=%s class=linux status=fail routes=%s status_url=%s\n' \
                "$1" "$3" "$6"
        ;;
        *)
            printf 'FLEET_HEALTH node=%s class=linux status=%s routes=%s\n' \
                "$1" "$2" "$3"
        ;;
    esac
}

printf 'FLEET_HEALTH node=local class=linux status=%s routes=local\n' "$local_status"
print_remote_linux ab "$ab_status" 1 \
    "$ab_maintenance_end" "$ab_maintenance_url" "$ab_status_url"
print_remote_linux ab2 "$ab2_status" 1 \
    "$ab2_maintenance_end" "$ab2_maintenance_url" "$ab2_status_url"
print_remote_linux ri "$ri_status" 1 \
    "$ri_maintenance_end" "$ri_maintenance_url" "$ri_status_url"
print_remote_linux al "$al_status" managed \
    "$al_maintenance_end" "$al_maintenance_url" "$al_status_url"
print_remote_linux rc "$rc_status" 1 \
    "$rc_maintenance_end" "$rc_maintenance_url" "$rc_status_url"
print_remote_linux t4 "$t4_status" 1 \
    "$t4_maintenance_end" "$t4_maintenance_url" "$t4_status_url"
print_remote_linux abq "$abq_status" 2 \
    "$abq_maintenance_end" "$abq_maintenance_url" "$abq_status_url"
printf 'FLEET_HEALTH node=aist class=mac status=%s routes=2\n' "$aist_status"
printf 'FLEET_HEALTH node=home class=mac status=%s routes=2\n' "$home_status"
printf 'FLEET_HEALTH node=office class=mac status=%s routes=2\n' "$office_status"
printf 'FLEET_HEALTH node=riken class=mac status=%s routes=2\n' "$riken_status"

append_failure() {
    current=$1
    name=$2
    if [ -n "$current" ]; then
        printf '%s,%s\n' "$current" "$name"
    else
        printf '%s\n' "$name"
    fi
}

linux_failures=
linux_maintenance=
for health_pair in \
    "local:$local_status" "ab:$ab_status" "ab2:$ab2_status" "ri:$ri_status" \
    "al:$al_status" "rc:$rc_status" "t4:$t4_status" "abq:$abq_status"; do
    health_name=${health_pair%%:*}
    health_status=${health_pair#*:}
    case "$health_status" in
        pass) ;;
        maintenance)
            linux_maintenance=$(append_failure "$linux_maintenance" "$health_name")
            ;;
        *)
            linux_failures=$(append_failure "$linux_failures" "$health_name")
            ;;
    esac
done
mac_failures=
for health_pair in \
    "aist:$aist_status" "home:$home_status" \
    "office:$office_status" "riken:$riken_status"; do
    health_name=${health_pair%%:*}
    health_status=${health_pair#*:}
    [ "$health_status" = pass ] ||
        mac_failures=$(append_failure "$mac_failures" "$health_name")
done

if [ -n "$linux_failures" ] && [ -n "$linux_maintenance" ]; then
    linux_summary="Linux fail nodes=$linux_failures maintenance nodes=$linux_maintenance"
elif [ -n "$linux_failures" ]; then
    linux_summary="Linux fail nodes=$linux_failures"
elif [ -n "$linux_maintenance" ]; then
    linux_summary="Linux maintenance nodes=$linux_maintenance"
else
    linux_summary='Linux pass'
fi
if [ -n "$mac_failures" ]; then
    mac_summary="Macs fail nodes=$mac_failures"
else
    mac_summary='Macs pass'
fi
printf 'Fleet: %s; %s.\n' "$linux_summary" "$mac_summary"
[ -z "$linux_failures" ] && [ -z "$mac_failures" ]
