{
  "display_information": {
    "description": "Credential-isolated Personal Slack access for Harness",
    "name": "Harness Personal"
  },
  "features": {
    "bot_user": {
      "always_online": false,
      "display_name": "Harness Personal"
    }
  },
  "oauth_config": {
    "redirect_urls": [
      "http://localhost:53683/slack/oauth/callback"
    ],
    "scopes": {
      "bot": [
        "chat:write"
      ],
      "user": [
        "canvases:read",
        "channels:history",
        "files:read",
        "groups:history",
        "users:read"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": true
  }
}
