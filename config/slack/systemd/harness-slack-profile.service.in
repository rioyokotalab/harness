[Unit]
Description=Harness Slack broker profile @@PROFILE@@
Requires=harness-slack-@@PROFILE@@.socket
After=network.target

[Service]
Type=simple
User=@@SERVICE_IDENTITY@@
Group=@@SERVICE_IDENTITY@@
LoadCredential=profile:@@PROFILE_SOURCE@@
ExecStart=@@RELEASE@@/libexec/harness-slack-mcp-service --profile %d/profile --client-user @@CLIENT_USER@@ --credential-state absent
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
