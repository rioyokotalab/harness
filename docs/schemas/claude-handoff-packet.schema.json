{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rioyokotalab.github.io/harness/schemas/claude-handoff-packet.schema.json",
  "title": "Task-bound Claude handoff packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "repository_root",
    "baseline_commit",
    "phase",
    "client",
    "model",
    "effort",
    "authority_class",
    "allowed_paths",
    "source_files",
    "checks",
    "next_action",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^T-[0-9]+$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "repository_root": {"type": "string", "minLength": 1},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "phase": {"enum": ["ready-for-go", "executing", "validating"]},
    "client": {"const": "claude"},
    "model": {"const": "fable"},
    "effort": {"const": "high"},
    "authority_class": {"enum": ["read-only", "execution"]},
    "allowed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "next_action": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
